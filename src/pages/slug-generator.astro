---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="URL Slug Generator"
  description="Convert text to URL-friendly slugs"
  category="Text"
  keywords={["slug", "url", "permalink"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter title or text..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Generate Slug</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  let text = document.getElementById('inp').value;
  if (!text) return;
  text = text.toLowerCase().trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_]+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  document.getElementById('out').textContent = text;
  document.getElementById('msg').textContent = 'Slug generated';
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a URL Slug Generator?</h2>
  <p class="mb-3">A URL slug generator converts any text into a clean, URL-friendly format by removing special characters, replacing spaces with hyphens, and converting everything to lowercase. Clean slugs are crucial for SEO because search engines prefer readable, keyword-rich URLs.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Creating SEO-optimized URLs for blog posts, product pages, or documentation</li>
    <li>Generating consistent, readable filenames for uploaded files and assets</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter any text and it's automatically converted to a URL-safe slug with hyphens and lowercase letters.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/case-converter/" class="text-primary hover:underline">Case Converter</a> for transforming text between different capitalization styles.</p>
</div>
</ToolLayout>
