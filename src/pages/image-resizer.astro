---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Image Resizer"
  description="Resize images to exact dimensions while preserving aspect ratio"
  category="Image"
  keywords={["image resizer", "image resizer", "image"]}
>
  <div class="space-y-4">
    <input type="file" id="file" accept="image/*" class="text-sm text-surface-300 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:bg-brand-500 file:text-white hover:file:bg-brand-400 file:cursor-pointer file:transition-colors" onchange="loadImage()" />
    <div class="flex gap-4 flex-wrap items-end">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Width (px)</label>
        <input id="imgW" type="number" value="800" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-24" oninput="resizeImage()" />
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Height (px)</label>
        <input id="imgH" type="number" value="" placeholder="auto" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-24" oninput="resizeImage()" />
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Quality: <span id="qualityVal">80</span>%</label>
        <input id="quality" type="range" min="10" max="100" value="80" oninput="document.getElementById('qualityVal').textContent=this.value; resizeImage()" class="accent-brand-500 w-32" />
      </div>
      <label class="text-xs text-surface-300 flex items-center gap-1 pb-2">
        <input type="checkbox" id="keepAspect" checked class="accent-brand-500" /> Keep aspect ratio
      </label>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
    <div id="preview-wrap" class="hidden flex justify-center">
      <img id="preview" class="max-w-full max-h-80 rounded-xl border border-surface-600 shadow-lg" />
      <a id="download-link" href="#" download="resized.jpg" class="inline-block mt-2 text-sm text-brand-400 hover:underline ml-4">Download Resized Image</a>
    </div>
  </div>
<script is:inline>
var originalImg = null;

function loadImage() {
  var file = document.getElementById('file').files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = new Image();
    img.onload = function() {
      originalImg = img;
      document.getElementById('imgW').value = img.width;
      document.getElementById('imgH').value = img.height;
      resizeImage();
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

function resizeImage() {
  if (!originalImg) {
    document.getElementById('result').textContent = 'Select an image file first.';
    return;
  }
  var w = parseInt(document.getElementById('imgW').value, 10);
  var h = parseInt(document.getElementById('imgH').value, 10);
  var keepAspect = document.getElementById('keepAspect').checked;
  var quality = parseInt(document.getElementById('quality').value, 10) / 100;

  if (isNaN(w) || w <= 0) {
    document.getElementById('result').textContent = 'Enter a valid width.';
    return;
  }

  if (keepAspect || isNaN(h) || h <= 0) {
    h = Math.round(originalImg.height * (w / originalImg.width));
    document.getElementById('imgH').value = h;
  }

  var canvas = document.createElement('canvas');
  canvas.width = w;
  canvas.height = h;
  var ctx = canvas.getContext('2d');
  ctx.drawImage(originalImg, 0, 0, w, h);
  var dataUrl = canvas.toDataURL('image/jpeg', quality);

  var sizeBytes = Math.round(dataUrl.length * 3 / 4);
  var info = 'Original: ' + originalImg.width + '\u00D7' + originalImg.height + '\n';
  info += 'Resized:  ' + w + '\u00D7' + h + '\n';
  info += 'Size:     ' + (sizeBytes / 1024).toFixed(1) + ' KB';

  document.getElementById('result').textContent = info;
  document.getElementById('preview').src = dataUrl;
  document.getElementById('preview-wrap').classList.remove('hidden');
  document.getElementById('download-link').href = dataUrl;
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
