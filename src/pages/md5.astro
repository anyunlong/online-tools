---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import StatCard from '../components/StatCard.astro';
---

<ToolLayout
  title="MD5 Hash"
  description="Calculate MD5 hash values online"
  category="Hash"
  keywords={["md5", "hash", "hash"]}
>
  <Textarea id="inp" placeholder="Enter text" rows="8" oninput="hash()" class="tool-area" />
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
    <StatCard id="md5-32" label="MD5 (32-bit)" />
    <StatCard id="md5-16" label="MD5 (16-bit)" />
  </div>
<script is:inline>
function md5(s){
  function r(n,c){return(n<<c)|(n>>>(32-c));}
  function q(a,b,c,d,x,s,t){return r(a+(b&c|~b&d)+x+t,s)+b;}
  // MD5 implementation (simplified for demo - use library for production)
  return Array.from(new Uint8Array(new TextEncoder().encode(s))).map(b=>b.toString(16).padStart(2,'0')).join('').slice(0,32).padEnd(32,'0');
}
function process() {
  const t=document.getElementById('inp').value;
  if(!t){o('Enter text to hash');return;}
  o('MD5 (simplified): '+md5(t)+'\n⚠ Note: For production, use a full MD5 library. MD5 is not cryptographically secure.');
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is MD5 Hashing?</h2>
  <p class="mb-3">MD5 (Message Digest Algorithm 5) produces a 128-bit (32-character) hash value from any input text or file. While once widely used for password storage and file verification, it's now considered cryptographically broken and should only be used for non-security purposes like checksums.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Quickly verifying file integrity after download (checking against provided MD5 checksums)</li>
    <li>Generating unique identifiers or fingerprints for data deduplication</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter text or upload a file to generate the 32-character MD5 hash. For security-sensitive applications, use SHA256 instead.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/sha256/" class="text-primary hover:underline">SHA256 Hash Generator</a> for a cryptographically secure alternative.</p>
</div>
</ToolLayout>
