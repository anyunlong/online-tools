---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Pregnancy Due Date Calculator"
  description="Estimate your baby's due date based on last period or conception"
  category="Health"
  keywords={["pregnancy calculator", "pregnancy due date calculator", "health"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const d=document.getElementById('inp').value;
  if(!d){document.getElementById('out').textContent='Enter date (YYYY-MM-DD)';return;}
  const due=new Date(d);due.setDate(due.getDate()+280);
  const diff=Math.floor((new Date()-new Date(d))/86400000),w=Math.floor(diff/7),dd=diff%7;
  document.getElementById('out').innerHTML='<div class="text-lg font-bold text-brand-400">Due: '+due.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})+'</div><div class="text-sm mt-1">'+w+'w '+dd+'d pregnant ('+(40-w)+'w to go)</div>';
}
function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
