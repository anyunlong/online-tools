---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Pregnancy Due Date Calculator"
  description="Estimate your baby's due date based on last period or conception"
  category="Health"
  keywords={["pregnancy calculator", "pregnancy due date calculator", "health"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const v=document.getElementById('inp').value.trim();
  const lmp=new Date(v);
  if(isNaN(lmp.getTime())){o('Enter first day of last period (YYYY-MM-DD)\nExample: 2025-03-15');return;}
  const due=new Date(lmp);due.setDate(due.getDate()+280);
  const today=new Date();
  const weeks=Math.floor((today-lmp)/(7*24*60*60*1000));
  o('LMP: '+lmp.toLocaleDateString()+'\nEstimated Due Date: '+due.toLocaleDateString()+'\nGestation: '+weeks+' weeks'+(weeks>=40?' (Full term!)':'')+'\n\n⚠ This is an estimate. Consult your healthcare provider.');
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
