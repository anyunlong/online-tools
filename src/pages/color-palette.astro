---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Color Palette Generator"
  description="Generate harmonious color palettes using color theory rules"
  category="Color"
  keywords={["color palette", "color palette generator", "color"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap items-end">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Base Color</label>
        <input id="baseColor" type="color" value="#3b82f6" onchange="generate()" class="w-12 h-10 rounded cursor-pointer border-0 bg-transparent" />
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Scheme</label>
        <select id="scheme" onchange="generate()" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="complementary">Complementary</option>
          <option value="analogous" selected>Analogous</option>
          <option value="triadic">Triadic</option>
          <option value="tetradic">Tetradic</option>
          <option value="monochromatic">Monochromatic</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="swatches" class="flex flex-wrap gap-2"></div>
    <textarea id="result" readonly class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all resize-y"></textarea>
  </div>
<script is:inline>
function hexToRgb(hex) {
  return {
    r: parseInt(hex.slice(1, 3), 16),
    g: parseInt(hex.slice(3, 5), 16),
    b: parseInt(hex.slice(5, 7), 16)
  };
}

function rgbToHsl(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  var max = Math.max(r, g, b), min = Math.min(r, g, b);
  var h = 0, s, l = (max + min) / 2;
  if (max !== min) {
    var d = max - min;
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
      case g: h = ((b - r) / d + 2) / 6; break;
      case b: h = ((r - g) / d + 4) / 6; break;
    }
  } else s = 0;
  return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
}

function hslToHex(h, s, l) {
  s /= 100; l /= 100;
  var a = s * Math.min(l, 1 - l);
  var f = function(n) {
    var k = (n + h / 30) % 12;
    var color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
    return Math.round(255 * color).toString(16).padStart(2, '0');
  };
  return '#' + f(0) + f(8) + f(4);
}

function generate() {
  var hex = document.getElementById('baseColor').value;
  var scheme = document.getElementById('scheme').value;
  var rgb = hexToRgb(hex);
  var hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
  var hues = [];

  switch (scheme) {
    case 'complementary': hues = [0, 180]; break;
    case 'analogous': hues = [0, -30, 30, -60, 60]; break;
    case 'triadic': hues = [0, 120, 240]; break;
    case 'tetradic': hues = [0, 90, 180, 270]; break;
    case 'monochromatic': hues = [0, 0, 0, 0, 0]; break;
  }

  var colors = hues.map(function(offset, i) {
    var h = (hsl.h + offset + 360) % 360;
    var s = scheme === 'monochromatic' ? Math.max(20, hsl.s - 15 * (i - 2)) : hsl.s;
    var l = scheme === 'monochromatic' ? Math.min(90, Math.max(10, hsl.l + 15 * (i - 2))) : hsl.l;
    return hslToHex(h, s, l);
  });

  var swatchHtml = colors.map(function(c) {
    var textColor = hexToRgb(c).r * 0.299 + hexToRgb(c).g * 0.587 + hexToRgb(c).b * 0.114 > 150 ? '#000' : '#fff';
    return '<div style="background:' + c + ';color:' + textColor + ';width:80px;height:80px;border-radius:10px;display:flex;align-items:flex-end;justify-content:center;padding:6px;cursor:pointer;font-size:11px;font-family:monospace;font-weight:600;" onclick="navigator.clipboard.writeText(\'' + c + '\')" title="Click to copy ' + c + '">' + c + '</div>';
  }).join('');

  document.getElementById('swatches').innerHTML = swatchHtml;
  document.getElementById('result').value = '/* ' + scheme.charAt(0).toUpperCase() + scheme.slice(1) + ' Palette */\n' + colors.join('\n');
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value);
}

generate();
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
