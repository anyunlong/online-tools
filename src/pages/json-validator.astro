---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="JSON Validator"
  description="Validate and format JSON online"
  category="Formatter"
  keywords={["json", "validate", "check", "format"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Paste JSON to validate..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Validate & Format</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  try {
    const data = JSON.parse(document.getElementById('inp').value);
    document.getElementById('out').textContent = JSON.stringify(data, null, 2);
    document.getElementById('msg').textContent = 'Valid JSON';
    document.getElementById('msg').className = 'text-xs mt-2 text-green-400';
  } catch(e) {
    document.getElementById('out').textContent = '';
    document.getElementById('msg').textContent = 'Invalid JSON: ' + e.message;
    document.getElementById('msg').className = 'text-xs mt-2 text-red-400';
  }
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a JSON Validator?</h2>
  <p class="mb-3">A JSON validator checks whether your JSON data is syntactically correct and tells you the exact location of any errors. Even a single missing comma, extra bracket, or trailing comma can break JSON — the validator catches these instantly so you can fix them.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Debugging JSON configuration files that are failing to parse in your application</li>
    <li>Validating API request or response payloads before sending or processing them</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your JSON to instantly see if it's valid, with exact error locations for invalid JSON.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-formatter/" class="text-primary hover:underline">JSON Formatter</a> for beautifying and formatting JSON after validation.</p>
</div>
</ToolLayout>
