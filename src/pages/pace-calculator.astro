---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Running Pace Calculator"
  description="Calculate running pace, time, and distance for any race"
  category="Health"
  keywords={["pace calculator", "running pace calculator", "health"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const v=document.getElementById('inp').value.trim().split(/[\s,]+/).map(Number);
  if(v.length<2||v.some(isNaN)){o('Format: distance_km time_minutes\nExample: 5 25');return;}
  const[d,t]=v;
  const pace=t/d;
  const pm=Math.floor(pace),ps=Math.round((pace-pm)*60);
  o('Distance: '+d+' km\nTime: '+t+' min\nPace: '+pm+':'+ps.toString().padStart(2,'0')+' /km\nSpeed: '+(d/(t/60)).toFixed(1)+' km/h');
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
