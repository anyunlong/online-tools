---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="JWT Decoder"
  description="Decode and inspect JWT tokens"
  category="Dev Tools"
  keywords={["jwt", "token", "decode", "auth"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Paste JWT token (eyJhbGciOi...)" rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Decode</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const token = document.getElementById('inp').value.trim();
  if (!token) return;
  try {
    const parts = token.split('.');
    if (parts.length !== 3) { document.getElementById('msg').textContent = 'Error: Invalid JWT format (need 3 parts)'; return; }
    const header = JSON.parse(atob(parts[0].replace(/-/g,'+').replace(/_/g,'/')));
    const payload = JSON.parse(atob(parts[1].replace(/-/g,'+').replace(/_/g,'/')));
    let info = '';
    if (payload.exp) { const d = new Date(payload.exp * 1000); info += `Expires: ${d.toLocaleString()}\n`; const now = Date.now()/1000; info += `Status: ${payload.exp > now ? '✅ Valid' : '❌ Expired'}\n`; }
    if (payload.iat) info += `Issued: ${new Date(payload.iat * 1000).toLocaleString()}\n`;
    if (payload.sub) info += `Subject: ${payload.sub}\n`;
    let out = '═══ HEADER ═══\n' + JSON.stringify(header, null, 2) + '\n\n═══ PAYLOAD ═══\n' + JSON.stringify(payload, null, 2);
    if (info) out += '\n\n═══ INFO ═══\n' + info;
    document.getElementById('out').textContent = out;
    document.getElementById('msg').textContent = 'Decoded successfully';
  } catch(e) { document.getElementById('msg').textContent = 'Error: ' + e.message; }
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a JWT Decoder?</h2>
  <p class="mb-3">A JWT (JSON Web Token) decoder unpacks the encoded header and payload of a JWT token to reveal its contents — such as user ID, expiration time, and permissions. JWTs are widely used for stateless authentication in modern web APIs and single sign-on systems.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Debugging authentication issues by inspecting the claims and expiry time in a JWT token</li>
    <li>Verifying that an API is issuing tokens with the correct user roles and permissions</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste a JWT token to decode and view its header, payload, expiration time, and all claims.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/base64/" class="text-primary hover:underline">Base64 Encoder</a> since JWT tokens use Base64 encoding for their header and payload sections.</p>
</div>
</ToolLayout>
