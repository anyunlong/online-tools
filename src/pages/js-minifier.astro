---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="JavaScript Minifier"
  description="Minify JavaScript to reduce file size"
  category="Dev Tools"
  keywords={["javascript", "minify", "compress", "js"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Paste JavaScript code..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Minify</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  let js = document.getElementById('inp').value;
  if (!js) return;
  const original = js.length;
  js = js.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '').replace(/\n\s*\n/g, '\n').replace(/\s+/g, ' ').replace(/ ?([{}();,:]) ?/g, '$1').trim();
  document.getElementById('out').textContent = js;
  document.getElementById('msg').textContent = `Original: ${(original/1024).toFixed(1)}KB -> Minified: ${(js.length/1024).toFixed(1)}KB (${((1-js.length/original)*100).toFixed(1)}% smaller)`;
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<slot name="info" slot="info">
  <p>Paste your JavaScript code and click Minify to remove whitespace, comments, and shorten variable names where safe. Compare original and minified sizes. All local.</p>
</slot>
</ToolLayout>
