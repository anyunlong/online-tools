---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Box Shadow Generator"
  description="Create CSS box-shadow effects visually"
  category="Design"
  keywords={["box-shadow", "css", "design", "shadow"]}
>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
    <div><label for="h-offset" class="text-xs text-surface-400 block mb-1">X Offset</label><Input id="h-offset" type="number" value="4" class="w-full" oninput="update()" /></div>
    <div><label for="v-offset" class="text-xs text-surface-400 block mb-1">Y Offset</label><Input id="v-offset" type="number" value="4" class="w-full" oninput="update()" /></div>
    <div><label for="blur" class="text-xs text-surface-400 block mb-1">Blur</label><Input id="blur" type="number" value="10" class="w-full" oninput="update()" /></div>
    <div><label for="spread" class="text-xs text-surface-400 block mb-1">Spread</label><Input id="spread" type="number" value="0" class="w-full" oninput="update()" /></div>
  </div>
  <div class="flex gap-3 items-center mb-4">
    <div>
      <label class="text-xs text-surface-400 block mb-1">Color</label>
      <div class="flex gap-2 items-center">
        <input type="color" id="shadowColor" value="#000000" class="w-8 h-8 rounded-lg border border-surface-700 cursor-pointer" oninput="update()" />
        <Input id="shadowColorHex" value="#000000" class="w-28" oninput="updateFromHex()" />
        <Input id="opacity" type="number" value="30" class="w-16" oninput="update()" />
        <span class="text-xs text-surface-400">%</span>
      </div>
    </div>
    <label class="flex items-center gap-2 text-sm text-surface-300 mt-4"><input type="checkbox" id="inset" onchange="update()" class="accent-brand-500" /> Inset</label>
  </div>
  <div id="preview" class="w-full h-24 rounded-xl mb-4 flex items-center justify-center bg-surface-800/50 border border-surface-700" style="box-shadow: 4px 4px 10px 0px rgba(0,0,0,0.3)">
    <span class="text-surface-400 text-sm">Preview</span>
  </div>
  <div class="flex gap-2">
    <Button onclick="copyCSS()">Copy CSS</Button>
  </div>
  <div id="css-code" class="mt-3 bg-surface-800/50 border border-surface-700 rounded-xl p-3 text-xs text-surface-100 font-mono break-all"></div>
<script is:inline>
function update() {
  var h = document.getElementById('h-offset').value || 0;
  var v = document.getElementById('v-offset').value || 0;
  var blur = document.getElementById('blur').value || 0;
  var spread = document.getElementById('spread').value || 0;
  var color = document.getElementById('shadowColor').value;
  document.getElementById('shadowColorHex').value = color;
  var opacity = (document.getElementById('opacity').value || 30) / 100;
  var inset = document.getElementById('inset').checked ? 'inset ' : '';
  var rgba = hexToRgba(color, opacity);
  var shadow = inset + h + 'px ' + v + 'px ' + blur + 'px ' + spread + 'px ' + rgba;
  document.getElementById('preview').style.boxShadow = shadow;
  document.getElementById('css-code').textContent = 'box-shadow: ' + shadow + ';';
}
function updateFromHex() {
  var hex = document.getElementById('shadowColorHex').value;
  if (/^#[0-9a-fA-F]{6}$/.test(hex)) document.getElementById('shadowColor').value = hex;
  update();
}
function hexToRgba(hex, alpha) {
  var r = parseInt(hex.slice(1,3), 16), g = parseInt(hex.slice(3,5), 16), b = parseInt(hex.slice(5,7), 16);
  return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha.toFixed(2) + ')';
}
function copyCSS() {
  var t = document.getElementById('css-code').textContent;
  navigator.clipboard.writeText(t).then(function() {
    var btn = document.querySelector('[onclick="copyCSS()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy CSS'; }, 1500);
  });
}
update();
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Box Shadow Generator?</h2>
  <p class="mb-3">A box shadow generator lets you visually create CSS shadow effects by adjusting offset, blur, spread, color, and opacity — with a live preview. Box shadows add depth and dimension to UI elements, making interfaces feel more tactile.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Designing card, button, or modal shadows for web and mobile interfaces</li>
    <li>Experimenting with shadow parameters to find the perfect depth effect for your design</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Adjust offset, blur, spread, and color sliders. The preview updates in real time. Copy the CSS when done.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/gradient-generator/" class="text-primary hover:underline">CSS Gradient Generator</a> for creating beautiful background gradients.</p>
</div>
</ToolLayout>
