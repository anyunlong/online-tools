---
import ToolLayout from '../components/ToolLayout.astro';
import DualPane from '../components/DualPane.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="CSV to JSON"
  description="Convert CSV data to JSON format"
  category="Convert"
  keywords={["csv", "json", "convert"]}
>
  <DualPane>
    <Textarea id="csv" slot="input" label="CSV" placeholder="name,age&#10;Alice,25&#10;Bob,30" rows="12" class="tool-area text-xs" />
    <Textarea id="json" slot="output" label="JSON" rows="12" readonly class="tool-area text-xs" />
  </DualPane>
  <div class="mt-4">
    <Button onclick="convert()">Convert</Button>
  </div>
<script is:inline>
function convert() {
  try {
    const lines = document.getElementById('csv').value.trim().split('\n');
    const headers = lines[0].split(',').map(function (h) { return h.trim(); });
    const result = lines.slice(1).filter(function(l) { return l.trim(); }).map(function (line) {
      const vals = line.split(',');
      const obj = {};
      headers.forEach(function (h, i) { obj[h] = vals[i] ? vals[i].trim() : ''; });
      return obj;
    });
    document.getElementById('json').value = JSON.stringify(result, null, 2);
  } catch (e) {
    document.getElementById('json').value = 'Error: ' + e.message;
  }
}
</script><div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a CSV to JSON Converter?</h2>
  <p class="mb-3">A CSV to JSON converter transforms tabular data stored in CSV (Comma-Separated Values) format into JSON (JavaScript Object Notation), which is the standard data format for web APIs and modern applications. This bridges the gap between spreadsheet exports and web development.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Importing spreadsheet data into a web application or database via JSON APIs</li>
    <li>Converting exported analytics or report data for use in JavaScript applications</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste CSV data or upload a CSV file and the converter automatically generates a JSON array.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-to-csv/" class="text-primary hover:underline">JSON to CSV Converter</a> if you need to convert in the opposite direction.</p>
</div>
</ToolLayout>
