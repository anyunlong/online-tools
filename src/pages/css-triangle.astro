---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="CSS Triangle Generator"
  description="Generate pure CSS triangles for tooltips and UI"
  category="Design"
  keywords={["css", "triangle", "arrow", "tooltip"]}
>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
    <div>
      <label for="width" class="text-xs text-surface-400 block mb-1">Width (px)</label>
      <Input id="width" type="number" value="20" class="w-full" oninput="update()" />
    </div>
    <div>
      <label for="height" class="text-xs text-surface-400 block mb-1">Height (px)</label>
      <Input id="height" type="number" value="20" class="w-full" oninput="update()" />
    </div>
    <div>
      <label for="tri-color" class="text-xs text-surface-400 block mb-1">Color</label>
      <div class="flex gap-1">
        <input type="color" id="tri-color" value="#6366f1" class="w-8 h-8 rounded border border-surface-700 cursor-pointer" oninput="update()" />
        <Input id="tri-hex" value="#6366f1" class="flex-1" oninput="updateFromHex()" />
      </div>
    </div>
    <div>
      <label for="direction" class="text-xs text-surface-400 block mb-1">Direction</label>
      <select id="direction" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 px-2 py-2 text-sm text-surface-100" onchange="update()">
        <option value="top">▲ Up</option><option value="bottom">▼ Down</option><option value="left">◀ Left</option><option value="right">▶ Right</option>
      </select>
    </div>
  </div>
  <div class="flex justify-center mb-4 h-24 items-center">
    <div id="preview"></div>
  </div>
  <div class="flex gap-2">
    <Button onclick="copyCSS()">Copy CSS</Button>
  </div>
  <div id="css-code" class="mt-3 bg-surface-800/50 border border-surface-700 rounded-xl p-3 text-xs text-surface-100 font-mono"></div>
<script is:inline>
function update() {
  var w = document.getElementById('width').value || 0;
  var h = document.getElementById('height').value || 0;
  var color = document.getElementById('tri-color').value;
  document.getElementById('tri-hex').value = color;
  var dir = document.getElementById('direction').value;
  var css = '';
  if (dir === 'top') css = 'width:0;height:0;border-left:'+(w/2)+'px solid transparent;border-right:'+(w/2)+'px solid transparent;border-bottom:'+h+'px solid '+color+';';
  else if (dir === 'bottom') css = 'width:0;height:0;border-left:'+(w/2)+'px solid transparent;border-right:'+(w/2)+'px solid transparent;border-top:'+h+'px solid '+color+';';
  else if (dir === 'left') css = 'width:0;height:0;border-top:'+(h/2)+'px solid transparent;border-bottom:'+(h/2)+'px solid transparent;border-right:'+w+'px solid '+color+';';
  else css = 'width:0;height:0;border-top:'+(h/2)+'px solid transparent;border-bottom:'+(h/2)+'px solid transparent;border-left:'+w+'px solid '+color+';';
  document.getElementById('preview').style.cssText = css;
  var shortCSS = '.triangle {\n  ' + css.replace(/;/g, ';\n  ') + '\n}';
  document.getElementById('css-code').textContent = shortCSS;
}
function updateFromHex() {
  var hex = document.getElementById('tri-hex').value;
  if (/^#[0-9a-fA-F]{6}$/.test(hex)) document.getElementById('tri-color').value = hex;
  update();
}
function copyCSS() {
  var t = document.getElementById('css-code').textContent;
  navigator.clipboard.writeText(t).then(function() {
    var btn = document.querySelector('[onclick="copyCSS()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy CSS'; }, 1500);
  });
}
update();
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a CSS Triangle Generator?</h2>
  <p class="mb-3">A CSS triangle generator creates pure-CSS arrow shapes using the border trick — setting three borders to transparent and one to a solid color. This technique is used for tooltip arrows, dropdown indicators, and decorative UI elements without any images or SVGs.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Adding directional arrows to tooltips, popovers, and dropdown menus</li>
    <li>Creating decorative shapes and dividers using pure CSS</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Adjust width, height, color, and direction. Copy the generated CSS for your project.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/box-shadow/" class="text-primary hover:underline">Box Shadow Generator</a> for adding depth to your UI components.</p>
</div>
</ToolLayout>
