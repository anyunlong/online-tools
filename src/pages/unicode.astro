---
import ToolLayout from '../components/ToolLayout.astro';
import DualPane from '../components/DualPane.astro';
import Textarea from '../components/Textarea.astro';
---

<ToolLayout
  title="Unicode Converter"
  description="Convert between Unicode and Chinese"
  category="Encode/Decode"
  keywords={["unicode", "chinese", "encode"]}
>
  <DualPane>
    <Textarea id="cn" slot="input" label="Chinese" placeholder="Enter Chinese text" rows="8" oninput="cnToUni()" />
    <Textarea id="uni" slot="output" label="Unicode" placeholder="\u4F60\u597D" rows="8" oninput="uniToCn()" class="tool-area" />
  </DualPane>
<script is:inline>
function cnToUni() {
  const cn = document.getElementById('cn').value;
  document.getElementById('uni').value = cn.split('').map(function (c) {
    return '\\u' + c.charCodeAt(0).toString(16).padStart(4, '0');
  }).join('');
}
function uniToCn() {
  const uni = document.getElementById('uni').value;
  document.getElementById('cn').value = uni.replace(/\\u([0-9a-fA-F]{4})/g, function (_, c) {
    return String.fromCharCode(parseInt(c, 16));
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Unicode Converter?</h2>
  <p class="mb-3">A Unicode converter translates text characters into their Unicode escape sequences (like \u4E2D\u6587 for Chinese) and vice versa. Unicode is the universal character encoding standard that assigns a unique number to every character across all writing systems.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Escaping non-Latin characters in JavaScript, JSON, or CSS source code</li>
    <li>Decoding Unicode escape sequences found in API responses or log files</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter Chinese or other text to convert to \uXXXX format, or paste Unicode escapes to decode back to readable text.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/hex-to-text/" class="text-primary hover:underline">Hex to Text Converter</a> for converting between hexadecimal and text.</p>
</div>
</ToolLayout>
