---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="AES Encryption"
  description="Encrypt messages using AES-256-GCM in your browser"
  category="Security"
  keywords={["aes", "encrypt", "decrypt", "security", "aes-256", "aes-gcm"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
async function process() {
  const v=document.getElementById('inp').value;
  if(!v){o('Enter a message to encrypt.');return;}
  try {
    // Generate a random key for demo
    const key = await crypto.subtle.generateKey(
      { name: 'AES-GCM', length: 256 },
      true,
      ['encrypt', 'decrypt']
    );
    
    // Export key to show user
    const exportedKey = await crypto.subtle.exportKey('raw', key);
    const keyHex = Array.from(new Uint8Array(exportedKey))
      .map(b => b.toString(16).padStart(2, '0')).join('');
    
    // Encrypt the message
    const encoder = new TextEncoder();
    const data = encoder.encode(v);
    const iv = crypto.getRandomValues(new Uint8Array(12));
    
    const encrypted = await crypto.subtle.encrypt(
      { name: 'AES-GCM', iv: iv },
      key,
      data
    );
    
    const encryptedHex = Array.from(new Uint8Array(encrypted))
      .map(b => b.toString(16).padStart(2, '0')).join('');
    const ivHex = Array.from(iv).map(b => b.toString(16).padStart(2, '0')).join('');
    
    o('Encrypted Message (AES-256-GCM):\n\n' + 
      'IV: ' + ivHex + '\n\n' +
      'Ciphertext: ' + encryptedHex + '\n\n' +
      'Key: ' + keyHex + '\n\n' +
      'Note: Save the key and IV to decrypt later.');
  } catch(e) {
    o('Error: ' + e.message);
  }
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
