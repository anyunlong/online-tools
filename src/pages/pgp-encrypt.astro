---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="PGP Message Encryptor"
  description="Encrypt and decrypt messages using PGP/GPG in your browser"
  category="Security"
  keywords={["pgp encrypt", "pgp message encryptor", "security"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script src="https://cdn.jsdelivr.net/npm/openpgp@5.11.1/dist/openpgp.min.js"></script>
<script is:inline>
async function process() {
  const v=document.getElementById('inp').value;
  if(!v){o('Enter a message to encrypt.');return;}
  try {
    // Generate a new key pair for demo
    const { privateKey, publicKey } = await openpgp.generateKey({
      type: 'ecc',
      curve: 'curve25519',
      userIDs: [{ name: 'Demo User', email: 'demo@4uses.com' }],
      passphrase: ''
    });
    
    // Encrypt the message
    const message = await openpgp.createMessage({ text: v });
    const encrypted = await openpgp.encrypt({
      message: message,
      encryptionKeys: publicKey
    });
    
    o('PGP Encrypted Message:\n\n' + encrypted);
  } catch(e) {
    o('Error: ' + e.message);
  }
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
