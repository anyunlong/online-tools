---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="htpasswd Generator"
  description="Generate Apache htpasswd entries with bcrypt, MD5, or SHA"
  category="Security"
  keywords={["htpasswd gen", "htpasswd generator", "security"]}
>
  <div class="space-y-4">
    <div class="space-y-3">
      <div>
        <label class="text-sm text-surface-300 block mb-1">Username</label>
        <input id="username" type="text" placeholder="admin" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full" />
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1">Password</label>
        <input id="password" type="password" placeholder="Enter password" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full" />
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Hash Algorithm</label>
        <select id="hashAlgo" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="SHA256">SHA-256</option>
          <option value="SHA512">SHA-512</option>
          <option value="MD5">MD5</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <textarea id="result" readonly class="w-full min-h-[150px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all resize-y"></textarea>
  </div>
<script is:inline>
async function shaDigest(message, algo) {
  var encoder = new TextEncoder();
  var data = encoder.encode(message);
  var hash = await crypto.subtle.digest(algo, data);
  var arr = Array.from(new Uint8Array(hash));
  return arr.map(function(b) { return b.toString(16).padStart(2, '0'); }).join('');
}

function base64Encode(str) {
  return btoa(unescape(encodeURIComponent(str)));
}

async function generate() {
  var username = document.getElementById('username').value.trim();
  var password = document.getElementById('password').value.trim();
  var algo = document.getElementById('hashAlgo').value;

  if (!username || !password) {
    document.getElementById('result').value = 'Enter both username and password';
    return;
  }

  var hashHex, prefix;
  if (algo === 'SHA256') {
    hashHex = await shaDigest(password, 'SHA-256');
    prefix = '{SHA256}';
  } else if (algo === 'SHA512') {
    hashHex = await shaDigest(password, 'SHA-512');
    prefix = '{SHA512}';
  } else {
    hashHex = await shaDigest(password, 'MD5');
    prefix = '{MD5}';
  }

  var b64 = base64Encode(password + ':' + hashHex);
  var line = username + ':' + prefix + b64;

  var output = '# htpasswd entry\n' + line + '\n\n';
  output += '# Save to .htpasswd file, then use in Apache:\n';
  output += '# AuthType Basic\n';
  output += '# AuthName "Restricted Access"\n';
  output += '# AuthUserFile /path/to/.htpasswd\n';
  output += '# Require valid-user\n\n';
  output += '# Command line alternative:\n';
  output += '# htpasswd -c .htpasswd ' + username;

  document.getElementById('result').value = output;
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value);
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
