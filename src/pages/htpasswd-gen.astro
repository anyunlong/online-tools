---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="htpasswd Generator"
  description="Generate Apache htpasswd entries with bcrypt, MD5, or SHA"
  category="Security"
  keywords={["htpasswd gen", "htpasswd generator", "security"]}
>
  <div class="space-y-4">
    <div class='text-sm text-surface-400'>Configure options above</div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function process() {
  const v=document.getElementById('inp').value.trim().split(/\s+/);
  if(v.length<2){o('Format: username password\nExample: admin mypassword');return;}
  // Simple base64 encoding of credentials (not real htpasswd, but demonstrates)
  const b64=btoa(v[0]+':'+v[1]);
  o('Username: '+v[0]+'\nPassword: '+v[1]+'\n\nhtpasswd entry:\n'+v[0]+':{SHA}'+b64+'\n\n⚠ For production, use:\nhtpasswd -c .htpasswd '+v[0]);
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';if(timer)clearInterval(timer);}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
