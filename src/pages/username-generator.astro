---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Username Generator"
  description="Generate unique, memorable usernames for social media and gaming"
  category="Generator"
  keywords={["username generator", "username generator", "generator"]}
>
  <div class="space-y-4">
    <div class='text-sm text-surface-400'>Configure options above</div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function generate() {
  const adj=['swift','brave','cool','epic','keen','lone','mega','nova','pale','rare','sage','tiny','wild','zeal','bold','calm','dark','fair','glow','hype'];
  const noun=['wolf','hawk','fox','bear','lion','deer','owl','lynx','orca','puma','dove','crow','frog','seal','wren','crab','ray','elk','bat','eel'];
  const r=arr=>arr[Math.floor(Math.random()*arr.length)];
  const n=Math.floor(Math.random()*9000)+1000;
  const styles=[
    r(adj)+r(noun)+n,
    r(adj)+'_'+r(noun),
    r(noun)+n,
    'the_'+r(adj)+'_'+r(noun),
    r(adj)+'.'+r(noun)+n,
  ];
  document.getElementById('result').value=styles[Math.floor(Math.random()*styles.length)];
}
function copyResult() {
  const el=document.getElementById('result');
  if(!el||!el.value) return;
  el.select();document.execCommand('copy');
  document.getElementById('msg').textContent='Copied!';
  setTimeout(()=>document.getElementById('msg').textContent='',2000);
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
