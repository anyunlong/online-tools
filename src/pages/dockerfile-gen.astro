---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Dockerfile Generator"
  description="Generate a basic Dockerfile for Node.js, Python, or Go projects"
  category="Dev Tools"
  keywords={["dockerfile gen", "dockerfile generator", "dev tools"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap items-end">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Base Image</label>
        <select id="lang" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="node" selected>Node.js</option>
          <option value="python">Python</option>
          <option value="go">Go</option>
          <option value="nginx">Nginx</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Port</label>
        <input id="port" type="number" value="3000" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-24" />
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Work Dir</label>
        <input id="workdir" type="text" value="/app" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-32" />
      </div>
      <label class="text-xs text-surface-300 flex items-center gap-1 pb-2">
        <input type="checkbox" id="multistage" class="accent-brand-500" /> Multi-stage
      </label>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <textarea id="result" readonly class="w-full min-h-[250px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all resize-y"></textarea>
  </div>
<script is:inline>
function generate() {
  var lang = document.getElementById('lang').value;
  var port = document.getElementById('port').value || '3000';
  var workdir = document.getElementById('workdir').value || '/app';
  var multi = document.getElementById('multistage').checked;
  var dockerfile = '';

  if (lang === 'node') {
    dockerfile = 'FROM node:20-alpine\n';
    if (multi) {
      dockerfile += 'AS builder\n';
    }
    dockerfile += 'WORKDIR ' + workdir + '\n';
    dockerfile += 'COPY package*.json ./\n';
    dockerfile += 'RUN npm ci' + (multi ? '' : ' --only=production') + '\n';
    dockerfile += 'COPY . .\n';
    if (multi) {
      dockerfile += 'RUN npm run build\n\n';
      dockerfile += 'FROM node:20-alpine\n';
      dockerfile += 'WORKDIR ' + workdir + '\n';
      dockerfile += 'COPY --from=builder ' + workdir + '/dist ./dist\n';
      dockerfile += 'COPY --from=builder ' + workdir + '/package*.json ./\n';
      dockerfile += 'RUN npm ci --only=production\n';
    }
    dockerfile += 'EXPOSE ' + port + '\n';
    dockerfile += 'CMD ["node", "index.js"]';
  } else if (lang === 'python') {
    dockerfile = 'FROM python:3.12-slim\n';
    dockerfile += 'WORKDIR ' + workdir + '\n';
    dockerfile += 'COPY requirements.txt .\n';
    dockerfile += 'RUN pip install --no-cache-dir -r requirements.txt\n';
    dockerfile += 'COPY . .\n';
    dockerfile += 'EXPOSE ' + port + '\n';
    dockerfile += 'CMD ["python", "app.py"]';
  } else if (lang === 'go') {
    dockerfile = 'FROM golang:1.22-alpine AS builder\n';
    dockerfile += 'WORKDIR ' + workdir + '\n';
    dockerfile += 'COPY go.mod go.sum ./\n';
    dockerfile += 'RUN go mod download\n';
    dockerfile += 'COPY . .\n';
    dockerfile += 'RUN CGO_ENABLED=0 GOOS=linux go build -o main .\n\n';
    dockerfile += 'FROM alpine:latest\n';
    dockerfile += 'RUN apk --no-cache add ca-certificates\n';
    dockerfile += 'WORKDIR /app\n';
    dockerfile += 'COPY --from=builder ' + workdir + '/main .\n';
    dockerfile += 'EXPOSE ' + port + '\n';
    dockerfile += 'CMD ["./main"]';
  } else if (lang === 'nginx') {
    dockerfile = 'FROM nginx:alpine\n';
    dockerfile += 'COPY . /usr/share/nginx/html\n';
    dockerfile += 'EXPOSE ' + port + '\n';
    dockerfile += 'CMD ["nginx", "-g", "daemon off;"]';
  }

  document.getElementById('result').value = dockerfile;
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value);
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
