---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Online Stopwatch"
  description="Precise online stopwatch and timer"
  category="Time"
  keywords={["stopwatch", "timer", "clock", "lap"]}
>
  <div class="space-y-4">
    
    <div class="flex gap-2">
      <Button onclick="generate()"></Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
let running = false, startTime = 0, elapsed = 0, interval;
function generate() {
  if (!running) { startTime = Date.now() - elapsed; interval = setInterval(update, 10); running = true; }
  else { clearInterval(interval); elapsed = Date.now() - startTime; running = false; }
}
function lap() { const el = document.getElementById('laps'); if (!el) return; const t = formatTime(elapsed || (Date.now() - startTime)); el.innerHTML += `<div class='text-sm text-surface-400 py-1 border-b border-surface-800/50'>Lap: ${t}</div>`; }
function resetTimer() { clearInterval(interval); running = false; startTime = 0; elapsed = 0; document.getElementById('result').textContent = '00:00:00.00'; const el = document.getElementById('laps'); if (el) el.innerHTML = ''; }
function update() { elapsed = Date.now() - startTime; document.getElementById('result').textContent = formatTime(elapsed); }
function formatTime(ms) { const h = Math.floor(ms / 3600000); const m = Math.floor((ms % 3600000) / 60000); const s = Math.floor((ms % 60000) / 1000); const cs = Math.floor((ms % 1000) / 10); return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}.${String(cs).padStart(2,'0')}`; }

function copyResult() {
  const text = document.getElementById('result').textContent;
  if (!text) return;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.querySelector('[onclick="copyResult()"]');
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy', 2000);
  });
}
</script>
<slot name="info" slot="info">
  <p>Click Start to begin timing. Use Lap to record split times, Pause to temporarily stop, and Reset to clear. Displays hours, minutes, seconds, and milliseconds. Runs entirely in your browser.</p>
</slot>
</ToolLayout>
