---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Online Stopwatch"
  description="Precise online stopwatch and timer"
  category="Time"
  keywords={["stopwatch", "timer", "clock", "lap"]}
>
  <div class="space-y-4">
    <div id="display" class="text-center py-6">
      <div class="text-5xl font-bold text-surface-100 font-mono tracking-wider">00:00:00.00</div>
      <div class="text-xs text-surface-500 mt-2">HOURS : MINUTES : SECONDS . CS</div>
    </div>
    <div class="flex gap-2 justify-center flex-wrap">
      <button id="btn-start" onclick="toggle()" class="px-6 py-2.5 rounded-xl bg-brand-500 text-white font-medium hover:bg-brand-400 transition-colors">Start</button>
      <button onclick="lap()" class="px-5 py-2.5 rounded-xl bg-surface-800 text-surface-200 border border-surface-600 hover:border-brand-500/50 hover:text-brand-400 transition-colors">Lap</button>
      <button onclick="resetStopwatch()" class="px-5 py-2.5 rounded-xl bg-surface-800 text-surface-200 border border-surface-600 hover:border-brand-500/50 hover:text-brand-400 transition-colors">Reset</button>
    </div>
    <div id="laps" class="w-full max-h-[200px] overflow-y-auto rounded-xl border border-surface-600 bg-surface-800 p-3 text-sm font-mono space-y-1"></div>
  </div>
<script is:inline>
var running = false;
var startTime = 0;
var elapsed = 0;
var interval = null;
var lapCount = 0;

function toggle() {
  if (!running) {
    startTime = Date.now() - elapsed;
    interval = setInterval(update, 10);
    running = true;
    var btn = document.getElementById('btn-start');
    btn.textContent = 'Stop';
    btn.className = 'px-6 py-2.5 rounded-xl bg-red-500 text-white font-medium hover:bg-red-400 transition-colors';
  } else {
    clearInterval(interval);
    elapsed = Date.now() - startTime;
    running = false;
    var btn = document.getElementById('btn-start');
    btn.textContent = 'Start';
    btn.className = 'px-6 py-2.5 rounded-xl bg-brand-500 text-white font-medium hover:bg-brand-400 transition-colors';
  }
}

function lap() {
  if (!running && elapsed === 0) return;
  lapCount++;
  var t = running ? Date.now() - startTime : elapsed;
  var div = document.createElement('div');
  div.className = 'text-sm text-surface-400 py-1 px-2 border-b border-surface-700/30 flex justify-between';
  div.innerHTML = '<span>Lap ' + lapCount + '</span><span class="text-surface-200">' + formatTime(t) + '</span>';
  var lapsEl = document.getElementById('laps');
  lapsEl.insertBefore(div, lapsEl.firstChild);
}

function resetStopwatch() {
  clearInterval(interval);
  running = false;
  elapsed = 0;
  lapCount = 0;
  document.getElementById('display').querySelector('div').textContent = '00:00:00.00';
  document.getElementById('laps').innerHTML = '';
  var btn = document.getElementById('btn-start');
  btn.textContent = 'Start';
  btn.className = 'px-6 py-2.5 rounded-xl bg-brand-500 text-white font-medium hover:bg-brand-400 transition-colors';
}

function update() {
  elapsed = Date.now() - startTime;
  document.getElementById('display').querySelector('div').textContent = formatTime(elapsed);
}

function formatTime(ms) {
  var h = Math.floor(ms / 3600000);
  var m = Math.floor((ms % 3600000) / 60000);
  var s = Math.floor((ms % 60000) / 1000);
  var cs = Math.floor((ms % 1000) / 10);
  return [h, m, s].map(function(v) { return String(v).padStart(2, '0'); }).join(':') + '.' + String(cs).padStart(2, '0');
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is an Online Stopwatch?</h2>
  <p class="mb-3">An online stopwatch is a precise digital timer that measures elapsed time down to the millisecond. It offers start, pause, lap, and reset functions — just like a physical stopwatch but more accurate and always available in your browser.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Timing workouts, presentations, cooking, or any activity where you need to track duration</li>
    <li>Measuring code execution time or page load performance during development</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Click Start to begin timing. Use Lap for split times, Pause to temporarily stop, and Reset to clear.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/countdown/" class="text-primary hover:underline">Countdown Timer</a> for counting down to a specific date instead of measuring elapsed time.</p>
</div>
</ToolLayout>
