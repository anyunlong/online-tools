---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Text Line Sorter"
  description="Sort text lines alphabetically"
  category="Text"
  keywords={["sort", "order", "alphabetize", "lines", "text sorter"]}
>
  <div class="space-y-4">
    <div>
      <label for="inp" class="block text-sm text-surface-200 mb-1.5 font-medium">Input</label>
      <textarea
        id="inp"
        rows="10"
        placeholder="Paste lines to sort, one per line..."
        class="w-full rounded-xl border border-surface-600 bg-surface-800 p-3 text-sm text-surface-100 font-mono placeholder:text-surface-500 focus:border-brand-500 focus:ring-1 focus:ring-brand-500/30 focus:outline-none transition-all resize-y"
      ></textarea>
    </div>
    <div class="flex items-center gap-4">
      <label class="flex items-center gap-2 text-sm text-surface-300 cursor-pointer">
        <input type="checkbox" id="dedup" class="accent-brand-500 w-4 h-4" />
        Remove duplicates
      </label>
      <label class="flex items-center gap-2 text-sm text-surface-300 cursor-pointer">
        <input type="checkbox" id="reverse" class="accent-brand-500 w-4 h-4" />
        Z-A (reverse)
      </label>
    </div>
    <div class="flex gap-2">
      <Button onclick="processLines()">Sort A-Z</Button>
      <Button variant="secondary" onclick="clearAll()">Clear</Button>
    </div>
    <div>
      <label class="block text-sm text-surface-200 mb-1.5 font-medium">Output</label>
      <div
        id="out"
        class="w-full min-h-[200px] rounded-xl border border-surface-600 bg-surface-800 p-3 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"
      ></div>
    </div>
  </div>
<script is:inline>
function processLines() {
  var raw = document.getElementById('inp').value;
  if (!raw.trim()) { document.getElementById('out').textContent = ''; return; }
  var lines = raw.split('\n').filter(function(l) { return l.trim() !== ''; });
  var dedup = document.getElementById('dedup').checked;
  var reverse = document.getElementById('reverse').checked;
  lines.sort(function(a, b) { return a.localeCompare(b); });
  if (reverse) lines.reverse();
  if (dedup) { var seen = {}; var unique = []; for (var i = 0; i < lines.length; i++) { if (!seen[lines[i]]) { seen[lines[i]] = true; unique.push(lines[i]); } } lines = unique; }
  document.getElementById('out').textContent = lines.join('\n');
}
function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').textContent = '';
}
</script>
</ToolLayout>
