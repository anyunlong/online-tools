---
import ToolLayout from '../components/ToolLayout.astro';
---

<ToolLayout
  title="Dice Roller"
  description="Roll virtual dice for games and RPGs"
  category="Generator"
  keywords={["dice", "roller", "random", "rpg", "dnd", "dungeons and dragons"]}
>
  <div class="flex flex-wrap gap-2 mb-4" id="dice-buttons">
    <button data-sides="4" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 transition-all text-sm font-semibold">d4</button>
    <button data-sides="6" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 transition-all text-sm font-semibold">d6</button>
    <button data-sides="8" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 transition-all text-sm font-semibold">d8</button>
    <button data-sides="10" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 transition-all text-sm font-semibold">d10</button>
    <button data-sides="12" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 transition-all text-sm font-semibold">d12</button>
    <button data-sides="20" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 transition-all text-sm font-semibold">d20</button>
    <button data-sides="100" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 transition-all text-sm font-semibold">d100</button>
  </div>
  <div id="result" class="flex items-center justify-center gap-4 bg-surface-800/40 border border-surface-700/30 rounded-xl p-6 min-h-[100px]">
    <p class="text-surface-400">Click a die to roll!</p>
  </div>
  <div id="history" class="mt-3 flex flex-wrap gap-1.5"></div>
<script is:inline>
(function() {
  var history = [];
  function roll(sides) {
    var result = Math.floor(Math.random() * sides) + 1;
    history.unshift(sides + ': ' + result);
    if (history.length > 20) history.pop();
    var color = '#6366f1';
    if (result === sides) color = '#22c55e';
    else if (result === 1) color = '#ef4444';
    document.getElementById('result').innerHTML = '<div class="text-center"><div class="text-xs text-surface-500 mb-1">d' + sides + '</div><div class="text-5xl font-bold font-mono" style="color:' + color + '">' + result + '</div></div>';
    document.getElementById('history').innerHTML = history.map(function(h) { return '<span class="text-xs bg-surface-800/50 border border-surface-700 rounded-lg px-2 py-0.5 text-surface-400 font-mono">' + h + '</span>'; }).join('');
  }
  document.addEventListener('DOMContentLoaded', function() {
    var buttons = document.querySelectorAll('#dice-buttons button');
    for (var i = 0; i < buttons.length; i++) {
      (function(btn) {
        btn.addEventListener('click', function() {
          roll(parseInt(this.getAttribute('data-sides'), 10));
        });
      })(buttons[i]);
    }
  });
})();
</script>
</ToolLayout>
