---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Markdown Preview"
  description="Write and preview Markdown in real time"
  category="Dev Tools"
  keywords={["markdown", "preview", "md"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="# Heading\n\n**bold** *italic*\n\n- list item\n\n`code`\n\n[link](https://example.com)" rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Copy HTML</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const html = document.getElementById('out').innerHTML;
  navigator.clipboard.writeText(html).then(() => {
    document.getElementById('msg').textContent = 'HTML copied to clipboard!';
  });
}
function md2html(md) {
  if (!md) return '';
  let html = md
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/^### (.+)$/gm,'<h3>$1</h3>')
    .replace(/^## (.+)$/gm,'<h2>$1</h2>')
    .replace(/^# (.+)$/gm,'<h1>$1</h1>')
    .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
    .replace(/\*(.+?)\*/g,'<em>$1</em>')
    .replace(/`(.+?)`/g,'<code>$1</code>')
    .replace(/^\- (.+)$/gm,'<li>$1</li>')
    .replace(/(<li>.*<\/li>\n?)+/g,'<ul>$&</ul>')
    .replace(/\[(.+?)\]\((.+?)\)/g,'<a href="$2" target="_blank">$1</a>')
    .replace(/\n\n/g,'</p><p>')
    .replace(/\n/g,'<br/>');
  return '<p>' + html + '</p>';
}
const inp = document.getElementById('inp');
const out = document.getElementById('out');
inp.addEventListener('input', () => { out.innerHTML = md2html(inp.value); });

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Markdown Previewer?</h2>
  <p class="mb-3">A Markdown previewer lets you write Markdown syntax on one side and see the rendered HTML output on the other in real time. Markdown is the lightweight markup language used by GitHub, Reddit, and countless documentation sites for writing formatted text without learning HTML.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Drafting README files, project documentation, or wiki pages for GitHub repositories</li>
    <li>Writing blog posts or forum replies with rich formatting like headings, lists, and code blocks</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Type or paste Markdown on the left panel; the formatted preview updates on the right in real time.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/html-entity/" class="text-primary hover:underline">HTML Entity Encoder</a> for encoding special characters in your Markdown content.</p>
</div>
</ToolLayout>
