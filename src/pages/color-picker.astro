---
import ToolLayout from '../components/ToolLayout.astro';
---

<ToolLayout
  title="Color Picker"
  description="Pick colors and convert HEX, RGB, HSL formats"
  category="Design"
  keywords={["color", "picker", "rgb", "hex"]}
>
  <input
    type="color"
    id="picker"
    value="#6366f1"
    class="w-16 h-16 rounded-xl border border-surface-700 cursor-pointer"
    oninput="update()"
  />
  <div class="mt-5 space-y-2.5">
    <div class="text-sm text-surface-200">
      HEX: <span id="hex" class="font-mono text-brand-400">#6366F1</span>
    </div>
    <div class="text-sm text-surface-200">
      RGB: <span id="rgb" class="font-mono text-brand-400">(99, 102, 241)</span>
    </div>
    <div class="text-sm text-surface-200">
      HSL: <span id="hsl" class="font-mono text-brand-400">(234°, 83%, 67%)</span>
    </div>
    <div id="preview" class="w-full h-14 rounded-xl mt-2 shadow-lg" style="background: #6366f1"></div>
  </div>
<script is:inline>
function update() {
  var v = document.getElementById('picker').value;
  document.getElementById('hex').textContent = v.toUpperCase();
  document.getElementById('preview').style.background = v;
  var r = parseInt(v.slice(1, 3), 16);
  var g = parseInt(v.slice(3, 5), 16);
  var b = parseInt(v.slice(5, 7), 16);
  document.getElementById('rgb').textContent = '(' + r + ', ' + g + ', ' + b + ')';
  var max = Math.max(r, g, b), min = Math.min(r, g, b);
  var h = 0;
  if (max !== min) {
    var d = max - min;
    h = (max === r ? ((g - b) / d + (g < b ? 6 : 0)) : (max === g ? ((b - r) / d + 2) : ((r - g) / d + 4))) * 60;
  }
  var l = ((max + min) / 2 / 255) * 100;
  var s = max === min ? 0 : ((max - min) / (1 - Math.abs(2 * (l / 100) - 1)) / 255) * 100;
  document.getElementById('hsl').textContent = '(' + Math.round(h) + '°, ' + Math.round(s) + '%, ' + Math.round(l) + '%)';
}
</script><div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Color Picker?</h2>
  <p class="mb-3">A color picker lets you visually select any color from the spectrum and instantly see its values in multiple formats — HEX (for CSS), RGB (for digital displays), and HSL (for intuitive hue/saturation/lightness adjustments). It's an essential tool for web designers and developers.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Picking brand colors or building a color palette for a website or app design</li>
    <li>Converting a HEX color you found online into RGB or HSL for use in different contexts</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Click the color picker to select any color and see its HEX, RGB, and HSL values update instantly.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/color-contrast/" class="text-primary hover:underline">Color Contrast Checker</a> to verify your chosen colors meet accessibility standards.</p>
</div>
</ToolLayout>
