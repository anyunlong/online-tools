---
import ToolLayout from '../components/ToolLayout.astro';
---

<ToolLayout
  title="Color Picker"
  description="Pick colors and convert HEX, RGB, HSL formats"
  category="Design"
  keywords={["color", "picker", "rgb", "hex"]}
>
  <input
    type="color"
    id="picker"
    value="#6366f1"
    class="w-16 h-16 rounded-xl border border-surface-700 cursor-pointer"
    oninput="update()"
  />
  <div class="mt-5 space-y-2.5">
    <div class="text-sm text-surface-200">
      HEX: <span id="hex" class="font-mono text-brand-400">#6366F1</span>
    </div>
    <div class="text-sm text-surface-200">
      RGB: <span id="rgb" class="font-mono text-brand-400">(99, 102, 241)</span>
    </div>
    <div class="text-sm text-surface-200">
      HSL: <span id="hsl" class="font-mono text-brand-400">(234°, 83%, 67%)</span>
    </div>
    <div id="preview" class="w-full h-14 rounded-xl mt-2 shadow-lg" style="background: #6366f1"></div>
  </div>
<script is:inline>
function update() {
  var v = document.getElementById('picker').value;
  document.getElementById('hex').textContent = v.toUpperCase();
  document.getElementById('preview').style.background = v;
  var r = parseInt(v.slice(1, 3), 16);
  var g = parseInt(v.slice(3, 5), 16);
  var b = parseInt(v.slice(5, 7), 16);
  document.getElementById('rgb').textContent = '(' + r + ', ' + g + ', ' + b + ')';
  var max = Math.max(r, g, b), min = Math.min(r, g, b);
  var h = 0;
  if (max !== min) {
    var d = max - min;
    h = (max === r ? ((g - b) / d + (g < b ? 6 : 0)) : (max === g ? ((b - r) / d + 2) : ((r - g) / d + 4))) * 60;
  }
  var l = ((max + min) / 2 / 255) * 100;
  var s = max === min ? 0 : ((max - min) / (1 - Math.abs(2 * (l / 100) - 1)) / 255) * 100;
  document.getElementById('hsl').textContent = '(' + Math.round(h) + '°, ' + Math.round(s) + '%, ' + Math.round(l) + '%)';
}
</script></ToolLayout>
