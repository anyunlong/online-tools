---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="XML Formatter"
  description="Format and beautify XML code"
  category="Formatter"
  keywords={["xml", "format", "beautify"]}
>
  <Textarea id="inp" placeholder="Paste XML code..." rows="12" class="tool-area" />
  <div class="flex gap-2 mt-4">
    <Button onclick="formatXML()">Format XML</Button>
    <Button variant="secondary" onclick="copyOut()">Copy</Button>
  </div>
  <div class="text-xs text-surface-400 mt-3 mb-1">Formatted Output:</div>
  <div id="out" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 font-mono overflow-auto min-h-[200px] max-h-[500px] whitespace-pre"></div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function formatXml(xml, indent) {
  indent = indent || '  ';
  var formatted = '', indentLevel = 0;
  var tokens = xml.replace(/>\s*</g, '><').replace(/<\?xml[^>]*\?>|<![^>]*>|<!--[\s\S]*?-->/g, function(m) { return m; });
  var tagRegex = /<\/?[^>]+(\s+[^>]*)?>/g;
  var lastIndex = 0, match;
  while ((match = tagRegex.exec(tokens)) !== null) {
    if (match.index > lastIndex) {
      var text = tokens.substring(lastIndex, match.index).trim();
      if (text) formatted += '\n' + indent.repeat(indentLevel) + text;
    }
    var tag = match[0];
    if (tag.startsWith('</')) {
      indentLevel = Math.max(0, indentLevel - 1);
      formatted += '\n' + indent.repeat(indentLevel) + tag;
    } else if (tag.endsWith('/>')) {
      formatted += '\n' + indent.repeat(indentLevel) + tag;
    } else {
      formatted += '\n' + indent.repeat(indentLevel) + tag;
      if (!tag.includes(' ')) indentLevel++;
    }
    lastIndex = match.index + tag.length;
  }
  return formatted.trim();
}
function formatXML() {
  try {
    var xml = document.getElementById('inp').value.trim();
    var formatted = formatXml(xml);
    document.getElementById('out').textContent = formatted;
    document.getElementById('msg').textContent = 'Formatting complete';
    document.getElementById('msg').className = 'text-xs mt-2 text-brand-400';
  } catch(e) {
    document.getElementById('msg').textContent = 'Error: ' + e.message;
    document.getElementById('msg').className = 'text-xs mt-2 text-red-400';
  }
}
function copyOut() {
  var t = document.getElementById('out').textContent;
  if (!t) return;
  navigator.clipboard.writeText(t).then(function() {
    var btn = document.querySelector('[onclick="copyOut()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is an XML Formatter?</h2>
  <p class="mb-3">An XML formatter takes messy, unformatted XML and adds proper indentation and line breaks to make the document structure clear and readable. It's essential for debugging XML configuration files and data exchange formats.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Making sense of compressed, single-line XML from API responses or configuration files</li>
    <li>Reviewing and editing XML documents like sitemaps, RSS feeds, or SVG files</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your XML code and click Format XML to add proper indentation and improve readability.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-formatter/" class="text-primary hover:underline">JSON Formatter</a> for formatting JSON data with proper indentation.</p>
</div>
</ToolLayout>
