---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Password Generator"
  description="Generate strong random passwords"
  category="Security"
  keywords={["password", "generator", "random"]}
>
  <div class="flex items-center gap-3 flex-wrap mb-4">
    <label class="text-sm text-surface-300">Length:</label>
    <Input id="len" type="number" value="16" class="w-20" />
    <label class="text-sm text-surface-300 flex items-center gap-1.5"><input id="upper" type="checkbox" checked class="accent-brand-500" />Uppercase</label>
    <label class="text-sm text-surface-300 flex items-center gap-1.5"><input id="lower" type="checkbox" checked class="accent-brand-500" />Lowercase</label>
    <label class="text-sm text-surface-300 flex items-center gap-1.5"><input id="nums" type="checkbox" checked class="accent-brand-500" />Numbers</label>
    <label class="text-sm text-surface-300 flex items-center gap-1.5"><input id="sym" type="checkbox" checked class="accent-brand-500" />Symbols</label>
    <Button onclick="generate()">Generate</Button>
  </div>
  <div
    id="result"
    class="text-xl font-mono bg-surface-800/40 border border-surface-700/30 rounded-xl p-5 break-all text-center text-brand-400 min-h-[56px]"
  ></div>
<script is:inline>
function generate() {
  var len = +document.getElementById('len').value;
  var chars = '';
  if (document.getElementById('upper').checked) chars += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  if (document.getElementById('lower').checked) chars += 'abcdefghijklmnopqrstuvwxyz';
  if (document.getElementById('nums').checked) chars += '0123456789';
  if (document.getElementById('sym').checked) chars += '!@#$%^&*()_-+=[]{}|;:,.<>?';
  var p = '';
  for (var i = 0; i < len; i++) p += chars[Math.floor(Math.random() * chars.length)];
  document.getElementById('result').textContent = p || 'Please select at least one character type';
}
generate();
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Password Generator?</h2>
  <p class="mb-3">A password generator creates strong, random passwords using a mix of uppercase letters, lowercase letters, numbers, and special symbols. Unlike human-chosen passwords, these are cryptographically random and much harder to guess or crack.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Creating new account passwords for websites, apps, or databases</li>
    <li>Replacing weak or reused passwords with unique, strong alternatives</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Choose password length and character types, then click Generate. We recommend 16+ characters with all character types enabled.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/random-string/" class="text-primary hover:underline">Random String Generator</a> for API keys and tokens.</p>
</div>
</ToolLayout>
