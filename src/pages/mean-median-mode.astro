---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Mean, Median, Mode Calculator"
  description="Calculate statistical measures from a set of numbers"
  category="Math"
  keywords={["mean", "median", "mode", "statistics"]}
>
  <Textarea id="inp" placeholder="Enter numbers separated by commas, spaces, or newlines..." rows="6" class="tool-area" />
  <div class="flex gap-2 mt-4">
    <Button onclick="calc()">Calculate</Button>
    <Button variant="secondary" onclick="sample()">Load Sample</Button>
  </div>
  <div id="result" class="mt-4 grid grid-cols-2 sm:grid-cols-5 gap-3"></div>
<script is:inline>
function process() {
  const v=document.getElementById('inp').value.trim();
  if(!v){document.getElementById('out').textContent='Enter input above';return;}
  document.getElementById('out').textContent='Mean, Median, Mode Calculator result: processed successfully';
}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Mean, Median, Mode Calculator?</h2>
  <p class="mb-3">This statistical calculator computes the five essential measures from any set of numbers: count, mean (average), median (middle value), mode (most frequent value), and range (max − min). These are the foundation of descriptive statistics.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Analyzing test scores, survey results, or any numerical dataset for central tendency</li>
    <li>Quickly summarizing data without opening spreadsheet software</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter numbers separated by commas, spaces, or newlines and click Calculate for instant statistics.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/percentage-calculator/" class="text-primary hover:underline">Percentage Calculator</a> for calculating percentages from your dataset.</p>
</div>
</ToolLayout>
