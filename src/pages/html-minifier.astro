---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="HTML Minifier"
  description="Minify HTML to reduce page size"
  category="Dev Tools"
  keywords={["html", "minify", "compress"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Paste HTML code..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Minify</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  let html = document.getElementById('inp').value;
  if (!html) return;
  const original = html.length;
  html = html.replace(/<!--[\s\S]*?-->/g, '').replace(/>\s+</g, '><').replace(/\s{2,}/g, ' ').replace(/\n/g, '').trim();
  document.getElementById('out').textContent = html;
  document.getElementById('msg').textContent = `Original: ${(original/1024).toFixed(1)}KB -> Minified: ${(html.length/1024).toFixed(1)}KB (${((1-html.length/original)*100).toFixed(1)}% smaller)`;
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is an HTML Minifier?</h2>
  <p class="mb-3">An HTML minifier strips out unnecessary characters from your HTML code — including whitespace between tags, comments, and optional quotation marks — without affecting how the page renders. This can reduce HTML file sizes by 10-30%, making pages load noticeably faster.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Preparing static HTML pages for production to maximize page speed and SEO performance</li>
    <li>Reducing the size of HTML email templates to stay under email client limits</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your HTML code and click Minify to remove whitespace and comments, then compare sizes.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/js-minifier/" class="text-primary hover:underline">JavaScript Minifier</a> for also compressing the scripts within your HTML pages.</p>
</div>
</ToolLayout>
