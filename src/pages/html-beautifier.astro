---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="HTML Beautifier"
  description="Beautify and format HTML code"
  category="Dev Tools"
  keywords={["html", "beautify", "format"]}
>
  <Textarea id="inp" placeholder="Paste minified or messy HTML..." rows="12" class="tool-area" />
  <div class="flex gap-2 mt-4">
    <Button onclick="beautify()">Beautify HTML</Button>
    <Button variant="secondary" onclick="copyOut()">Copy</Button>
  </div>
  <div class="text-xs text-surface-400 mt-3 mb-1">Formatted HTML:</div>
  <div id="out" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 font-mono overflow-auto min-h-[200px] max-h-[500px] whitespace-pre"></div>
<script is:inline>
function beautify() {
  var html = document.getElementById('inp').value;
  var indentSize = 2;
  var indentChar = ' ';
  var out = '', indent = 0;
  var tags = html.replace(/>\s*</g, '><').replace(/(<[^>]*>)/g, '\n$1\n').split('\n');
  var voidElements = {area:1,base:1,br:1,col:1,embed:1,hr:1,img:1,input:1,link:1,meta:1,param:1,source:1,track:1,wbr:1};
  for (var i = 0; i < tags.length; i++) {
    var t = tags[i].trim();
    if (!t) continue;
    if (t.startsWith('</')) indent = Math.max(0, indent - 1);
    out += indentChar.repeat(indent * indentSize) + t + '\n';
    if (t.startsWith('<') && !t.startsWith('</') && !t.startsWith('<!') && !t.endsWith('/>')) {
      var tagName = t.match(/^<(\w+)/);
      if (tagName && !voidElements[tagName[1].toLowerCase()]) indent++;
    }
  }
  document.getElementById('out').textContent = out.trim();
}
function copyOut() {
  var t = document.getElementById('out').textContent;
  if (!t) return;
  navigator.clipboard.writeText(t).then(function() {
    var btn = document.querySelector('[onclick="copyOut()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is an HTML Beautifier?</h2>
  <p class="mb-3">An HTML beautifier takes minified or messy HTML markup and reformats it with consistent indentation, making nested elements visually clear. It recognizes void elements (like br and img) so they don't get incorrectly indented.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Reading minified HTML from a production website to understand its structure</li>
    <li>Cleaning up generated HTML from WYSIWYG editors or templating engines</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your HTML and click Beautify HTML to add proper indentation and line breaks.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/html-minifier/" class="text-primary hover:underline">HTML Minifier</a> for compressing HTML in the other direction.</p>
</div>
</ToolLayout>
