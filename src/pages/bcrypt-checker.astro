---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Bcrypt Checker"
  description="Hash passwords with bcrypt and verify hashes"
  category="Security"
  keywords={["bcrypt", "hash", "password", "verify"]}
>
  <div class="space-y-4">
    <p class="text-sm text-surface-400">Bcrypt is a slow, adaptive password hashing algorithm with built-in salt. This tool uses bcrypt with cost factor 12 for secure password hashing.</p>
    <div>
      <label for="pwd" class="text-sm text-surface-300 mb-1.5 block">Password</label>
      <Input id="pwd" type="text" placeholder="Enter password to hash..." class="w-full" />
    </div>
    <Button onclick="hash()">Generate Hash</Button>
    <div class="text-xs text-surface-400 mt-3 mb-1">Generated Hash:</div>
    <div id="out" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-sm text-surface-100 font-mono break-all min-h-[48px]"></div>
    <p class="text-xs text-surface-500 mt-1">Uses bcrypt with cost factor 12 (standard for secure password hashing).</p>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bcryptjs@2.4.3/dist/bcrypt.min.js"></script>
<script is:inline>
async function hash() {
  var pwd = document.getElementById('pwd').value;
  if (!pwd) { document.getElementById('out').textContent = 'Enter a password to hash.'; return; }
  
  // Generate salt with cost factor 12
  var salt = dcodeIO.bcrypt.genSaltSync(12);
  var hash = dcodeIO.bcrypt.hashSync(pwd, salt);
  
  document.getElementById('out').textContent = hash;
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Bcrypt Checker?</h2>
  <p class="mb-3">Bcrypt is a deliberately slow password hashing algorithm designed to resist brute-force attacks. This tool uses PBKDF2-SHA512 with 200,000 iterations (comparable to bcrypt cost factor 12) to generate and verify password hashes with random salts for maximum security.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Hashing user passwords before storing them in a database (never store plain text)</li>
    <li>Understanding how modern password hashing algorithms protect against attacks</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter a password to generate a secure salted hash. The output includes the algorithm, iterations, salt, and hash.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/password-strength/" class="text-primary hover:underline">Password Strength Checker</a> to see how strong your password is before hashing.</p>
</div>
</ToolLayout>
