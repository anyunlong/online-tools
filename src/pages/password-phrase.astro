---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Passphrase Generator"
  description="Generate memorable passphrases using random word combinations"
  category="Generator"
  keywords={["password phrase", "passphrase generator", "generator"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Words</label>
        <select id="count" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="3">3 words</option><option value="4" selected>4 words</option><option value="5">5 words</option><option value="6">6 words</option><option value="7">7 words</option><option value="8">8 words</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Separator</label>
        <select id="sep" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="-">Hyphen (-)</option><option value=".">Dot (.)</option><option value="_">Underscore (_)</option><option value=" ">Space</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Case</label>
        <select id="casing" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="lower">lowercase</option><option value="title">Title Case</option><option value="upper">UPPERCASE</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
var words = [
  'apple','river','cloud','stone','tiger','eagle','dragon','phoenix','castle','bridge','garden','ocean','forest','mountain','thunder','lightning','crystal','emerald','silver','golden','copper','bronze','steel','iron','velvet','cotton','paper','glass','shadow','flame','frost','storm','comet','nebula','galaxy','planet','island','canyon','desert','meadow','harvest','autumn','winter','summer','spring','twilight','sunrise','sunset','horizon','pillar','temple','tower','lantern','compass','anchor','beacon','vortex','zenith','falcon','osprey','heron','raven','robin','sparrow','salmon','dolphin','whale','octopus','jaguar','leopard','badger','otter','cobra','viper','lizard','bison','mustang','buffalo','gazelle','giraffe','zebra','panda','husky','collie','badger','weasel','ferret','rabbit','amber','coral','pearl','jasper','onyx','topaz','garnet','quartz','marble','granite','cedar','willow','birch','maple','elm','oak','pine','juniper','sage','thyme','basil','clove','ginger','nutmeg','cinnamon','vanilla','saffron'
];

function rand(arr) {
  var buf = new Uint32Array(1);
  crypto.getRandomValues(buf);
  return arr[buf[0] % arr.length];
}

function generate() {
  var count = parseInt(document.getElementById('count').value, 10);
  var sep = document.getElementById('sep').value;
  var casing = document.getElementById('casing').value;
  var chosen = [];
  var used = {};
  for (var i = 0; i < count; i++) {
    var w;
    do { w = rand(words); } while (used[w] && Object.keys(used).length < words.length);
    used[w] = true;
    if (casing === 'title') w = w.charAt(0).toUpperCase() + w.slice(1);
    else if (casing === 'upper') w = w.toUpperCase();
    chosen.push(w);
  }
  var phrase = chosen.join(sep === ' ' ? ' ' : sep);
  var poolSize = words.length;
  var entropy = Math.log2(Math.pow(poolSize, count));
  document.getElementById('result').innerHTML =
    '<div class="text-xl font-bold text-brand-400 break-all">' + phrase + '</div>' +
    '<div class="text-xs text-surface-400 mt-2">Entropy: ~' + entropy.toFixed(0) + ' bits | Word pool: ' + poolSize + ' words</div>';
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value || document.getElementById('result').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
