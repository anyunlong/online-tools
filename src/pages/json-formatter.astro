---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="JSON Formatter"
  description="Format, compress and validate JSON online"
  category="format"
  keywords={["json", "format", "validate"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder='{"key":"value"}' rows="14" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <pre id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto"></pre>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="format()">Format</Button>
    <Button variant="secondary" onclick="compress()">Compress</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function format() {
  try {
    const j = JSON.parse(document.getElementById('inp').value);
    document.getElementById('out').textContent = JSON.stringify(j, null, 2);
    document.getElementById('msg').textContent = '✓ Valid JSON';
    document.getElementById('msg').className = 'text-xs mt-2 text-brand-400';
  } catch (e) {
    document.getElementById('msg').textContent = '✗ ' + e.message;
    document.getElementById('msg').className = 'text-xs mt-2 text-red-400';
  }
}
function compress() {
  try {
    document.getElementById('out').textContent = JSON.stringify(JSON.parse(document.getElementById('inp').value));
  } catch (e) {
    document.getElementById('out').textContent = e.message;
  }
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a JSON Formatter?</h2>
  <p class="mb-3">A JSON formatter takes raw, compressed JSON data and reformats it with proper indentation and line breaks so it's easy to read and debug. It also validates your JSON syntax and tells you exactly where errors are.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Making sense of minified JSON from API responses or configuration files</li>
    <li>Finding and fixing syntax errors like missing commas or unmatched brackets</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your JSON and click Format to beautify it, or Compress to minify for production.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-validator/" class="text-primary hover:underline">JSON Validator</a> for quick syntax checking without reformatting.</p>
</div>
</ToolLayout>
