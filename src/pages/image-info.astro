---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Image Info Viewer"
  description="View detailed image metadata: dimensions, file size, color depth, EXIF"
  category="Image"
  keywords={["image info", "image info viewer", "image"]}
>
  <div class="space-y-4">
    <input type="file" id="file" accept="image/*" class="text-sm text-surface-300 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:bg-brand-500 file:text-white hover:file:bg-brand-400 file:cursor-pointer file:transition-colors" onchange="showInfo()" />
    <div id="result" class="w-full min-h-[200px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
    <div id="preview-wrap" class="hidden flex justify-center">
      <img id="preview" class="max-w-full max-h-80 rounded-xl border border-surface-600 shadow-lg" />
    </div>
  </div>
<script is:inline>
function showInfo() {
  var file = document.getElementById('file').files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = new Image();
    img.onload = function() {
      var kb = (file.size / 1024).toFixed(1);
      var aspect = (img.width / img.height).toFixed(2);
      var aspectLabel = '';
      if (Math.abs(img.width / img.height - 16 / 9) < 0.01) aspectLabel = ' (16:9)';
      else if (Math.abs(img.width / img.height - 4 / 3) < 0.01) aspectLabel = ' (4:3)';
      else if (Math.abs(img.width / img.height - 1) < 0.01) aspectLabel = ' (1:1 Square)';
      else if (img.width > img.height) aspectLabel = ' (Landscape)';
      else aspectLabel = ' (Portrait)';

      var megapixels = ((img.width * img.height) / 1000000).toFixed(1);
      var info = '';
      info += 'File Name:  ' + file.name + '\n';
      info += 'File Size:  ' + kb + ' KB (' + file.size.toLocaleString() + ' bytes)\n';
      info += 'MIME Type:  ' + (file.type || 'unknown') + '\n';
      info += 'Dimensions: ' + img.width + ' \u00D7 ' + img.height + ' px\n';
      info += 'Megapixels: ' + megapixels + ' MP\n';
      info += 'Aspect:     ' + aspect + aspectLabel + '\n';
      info += 'Last Modified: ' + new Date(file.lastModified).toLocaleString();

      document.getElementById('result').textContent = info;
      document.getElementById('preview').src = e.target.result;
      document.getElementById('preview-wrap').classList.remove('hidden');
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
