---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="URL Extractor"
  description="Extract URLs and links from any text"
  category="Text"
  keywords={["url", "extract", "link", "parse"]}
>
  <Textarea id="inp" placeholder="Paste text containing URLs..." rows="12" class="tool-area" />
  <div class="flex gap-2 mt-4">
    <Button onclick="extract()">Extract URLs</Button>
    <Button variant="secondary" onclick="copyRes()">Copy All</Button>
  </div>
  <div class="flex items-center gap-4 mt-3 text-xs text-surface-400">
    <span>Found: <strong id="found-count" class="text-brand-400">0</strong></span>
    <span>Unique: <strong id="unique-count" class="text-brand-400">0</strong></span>
  </div>
  <div id="result" class="mt-3 bg-surface-800/40 border border-surface-700/30 rounded-xl p-3 text-sm text-surface-100 font-mono max-h-[200px] overflow-y-auto min-h-[48px] space-y-1"></div>
<script is:inline>
function extract() {
  var text = document.getElementById('inp').value;
  var re = /https?:\/\/[^\s<>"{}|\\^`[\]]+/g;
  var matches = text.match(re) || [];
  var unique = [];
  var seen = {};
  for (var i = 0; i < matches.length; i++) {
    if (!seen[matches[i]]) { seen[matches[i]] = true; unique.push(matches[i]); }
  }
  document.getElementById('found-count').textContent = matches.length;
  document.getElementById('unique-count').textContent = unique.length;
  document.getElementById('result').innerHTML = unique.map(function(u) { return '<div class="text-brand-400 break-all">' + u + '</div>'; }).join('') || '<p class="text-surface-500">No URLs found.</p>';
}
function copyRes() {
  var urls = [];
  var divs = document.getElementById('result').querySelectorAll('.text-brand-400');
  for (var i = 0; i < divs.length; i++) urls.push(divs[i].textContent);
  if (!urls.length) return;
  navigator.clipboard.writeText(urls.join('\n')).then(function() {
    var btn = document.querySelector('[onclick="copyRes()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy All'; }, 1500);
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a URL Extractor?</h2>
  <p class="mb-3">A URL extractor scans any block of text and pulls out every hyperlink (http:// or https://) using regex pattern matching. It deduplicates results automatically, making it ideal for collecting links from documents, emails, or raw data dumps.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Collecting all external links from a scraped web page or exported data file</li>
    <li>Extracting reference URLs from academic papers, documentation, or research notes</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste any text containing URLs and click Extract. Copy all unique URLs with one click.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/url-parser/" class="text-primary hover:underline">URL Parser</a> for breaking individual URLs into their components.</p>
</div>
</ToolLayout>
