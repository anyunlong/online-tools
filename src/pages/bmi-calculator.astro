---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="BMI Calculator"
  description="Calculate your Body Mass Index"
  category="Math"
  keywords={["bmi", "calculator", "health", "weight"]}
>
  <div class="space-y-4">
    <div class='space-y-3'><div><label class='text-sm text-surface-300 block mb-1'>Unit</label><select id='unit' onchange='toggleUnit()' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100'><option value='metric'>Metric (cm / kg)</option><option value='imperial'>Imperial (ft/in / lbs)</option></select></div><div id='metric' class='grid grid-cols-2 gap-3'><div><label class='text-sm text-surface-300 block mb-1'>Height (cm)</label><input id='cm' type='number' value='170' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100 w-full' /></div><div><label class='text-sm text-surface-300 block mb-1'>Weight (kg)</label><input id='kg' type='number' value='70' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100 w-full' /></div></div><div id='imperial' style='display:none' class='grid grid-cols-3 gap-3'><div><label class='text-sm text-surface-300 block mb-1'>Feet</label><input id='ft' type='number' value='5' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100 w-full' /></div><div><label class='text-sm text-surface-300 block mb-1'>Inches</label><input id='inch' type='number' value='7' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100 w-full' /></div><div><label class='text-sm text-surface-300 block mb-1'>Weight (lbs)</label><input id='lbs' type='number' value='155' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100 w-full' /></div></div></div>
    <div class="flex gap-2">
      <Button onclick="generate()">Calculate BMI</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function toggleUnit() {
  var unit = document.getElementById('unit').value;
  document.getElementById('metric').style.display = unit === 'metric' ? '' : 'none';
  document.getElementById('imperial').style.display = unit === 'imperial' ? '' : 'none';
}

function generate() {
  var unit = document.getElementById('unit').value;
  var heightM, kg;
  var heightLabel = '';

  if (unit === 'metric') {
    var cm = parseFloat(document.getElementById('cm').value);
    if (isNaN(cm) || cm <= 0) { document.getElementById('result').textContent = 'Enter valid height'; return; }
    heightM = cm / 100;
    kg = parseFloat(document.getElementById('kg').value);
    heightLabel = (heightM * 100).toFixed(0) + ' cm';
  } else {
    var ft = parseFloat(document.getElementById('ft').value);
    var inch = parseFloat(document.getElementById('inch').value);
    if (isNaN(ft) || isNaN(inch)) { document.getElementById('result').textContent = 'Enter valid height'; return; }
    heightM = (ft * 12 + inch) * 0.0254;
    kg = parseFloat(document.getElementById('lbs').value) * 0.453592;
    heightLabel = ft + '\'' + inch + '" (' + (heightM * 100).toFixed(0) + ' cm)';
  }

  if (isNaN(kg) || kg <= 0 || heightM <= 0) {
    document.getElementById('result').textContent = 'Enter valid numbers';
    return;
  }

  var bmi = kg / (heightM * heightM);
  var category, color;
  if (bmi < 18.5) { category = 'Underweight'; color = 'text-yellow-400'; }
  else if (bmi < 25) { category = 'Normal weight'; color = 'text-green-400'; }
  else if (bmi < 30) { category = 'Overweight'; color = 'text-orange-400'; }
  else { category = 'Obese'; color = 'text-red-400'; }

  document.getElementById('result').innerHTML =
    '<div class="text-2xl font-bold text-brand-400">' + bmi.toFixed(1) + '</div>' +
    '<div class="text-sm ' + color + ' mt-1 font-medium">' + category + '</div>' +
    '<div class="text-xs text-surface-500 mt-2">Height: ' + heightLabel + ' | Weight: ' + kg.toFixed(1) + ' kg</div>';
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value || document.getElementById('result').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a BMI Calculator?</h2>
  <p class="mb-3">A BMI (Body Mass Index) calculator estimates body fat based on your height and weight. It categorizes results into standard WHO ranges — Underweight, Normal, Overweight, and Obese — to give you a quick health reference point.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Getting a quick health screening to understand if you're in a healthy weight range</li>
    <li>Tracking weight management progress over time as part of a fitness journey</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter your height and weight in either metric or imperial units to calculate your BMI category.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/percentage-calculator/" class="text-primary hover:underline">Percentage Calculator</a> for calculating percent changes in weight or other metrics.</p>
</div>
</ToolLayout>
