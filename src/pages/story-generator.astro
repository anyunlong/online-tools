---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Story Prompt Generator"
  description="Generate creative writing prompts with characters, setting, and conflict"
  category="Fun"
  keywords={["story generator", "story prompt generator", "fun"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Genre</label>
        <select id="genre" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="any">Any</option>
          <option value="scifi">Sci-Fi</option>
          <option value="fantasy">Fantasy</option>
          <option value="mystery">Mystery</option>
          <option value="romance">Romance</option>
          <option value="horror">Horror</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Count</label>
        <select id="count" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="1">1</option><option value="3" selected>3</option><option value="5">5</option><option value="10">10</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
var characters = {
  scifi: ['A rogue AI','A space smuggler','A cryo-thawed colonist','A cyborg detective','An alien diplomat','A quantum physicist','The last starship pilot','A gene-spliced mercenary','A holographic ghost','An asteroid miner'],
  fantasy: ['A disgraced knight','A forest witch','A dragon-blooded orphan','An elven ranger','A cursed blacksmith','A wandering bard','A shapeshifting thief','The last griffin rider','A goblin alchemist','A princess turned warrior'],
  mystery: ['A retired detective','A forensic accountant','A nosy journalist','A bartender with a past','A cold case archivist','A psychic consultant','A rookie cop','A crime scene cleaner','An insurance investigator','A hacker informant'],
  romance: ['A coffee shop owner','A wedding photographer','A marine biologist','An architect abroad','A bookstore clerk','A chef with a secret','A travel writer','A single parent','A florist','A music teacher'],
  horror: ['An abandoned asylum patient','A paranormal researcher','A lighthouse keeper','A mortician','A sleep-deprived student','An exorcist priest','A rural sheriff','A cave explorer','A antique doll collector','A night-shift security guard']
};
var settings = {
  scifi: ['on a dying space station','in a Mars colony under quarantine','aboard a generation ship','in a city flooded by rising oceans','inside a virtual reality gone wrong','on a planet with time dilation','in a robot-run megacity','during first contact with aliens','in an interdimensional rift','on a stolen prototype warship'],
  fantasy: ['in a crumbling sky castle','through a cursed enchanted forest','in a kingdom of eternal winter','beneath a sleeping volcano','in a city built on a dragon graveyard','across the sea of lost souls','in a library that holds all knowledge','through a mirror world of doppelgangers','in a desert where magic is forbidden','at a school for forbidden sorcery'],
  mystery: ['in a locked-room mansion','at a high-stakes auction house','in a small town with no crime...until now','on a train crossing Europe','in the basement of an old theater','at a technology summit','in a witness protection safe house','aboard a luxury yacht','in the archives of a defunct newspaper','at a family reunion'],
  romance: ['at a destination wedding in Tuscany','in a bookshop during a snowstorm','on a cross-country road trip','at a culinary school in Paris','during a summer festival','on a film set in New Zealand','in a hospital waiting room','at a rooftop New Year party','during a pottery workshop','on a cruise ship'],
  horror: ['in a forgotten underground tunnel','at a cabin deep in the woods','inside an abandoned hospital','in a town where no one ages','during a century storm','in a house where rooms shift','at an old carnival after dark','in a basement full of mirrors','on a road that never ends','in a school after midnight']
};
var conflicts = {
  scifi: ['must stop an AI rebellion','discovers time is running backwards','finds an alien artifact that changes everything','realizes their memories were planted','must prevent a paradox','learns the colony was an experiment','hacks into a classified government project','discovers they are the last of their kind','finds a message from a parallel universe','must choose between two timelines'],
  fantasy: ['must break an ancient blood curse','discovers they can speak to the dead','steals from a sleeping god','must win a deadly tournament','finds a prophecy about their own death','is hunted by shadow assassins','must forge peace between warring kingdoms','discovers their magic comes at a terrible cost','is challenged by a rival to a duel of fates','must rescue someone from the underworld'],
  mystery: ['uncovers a decades-old cold case','finds evidence the victim was never dead','discovers a journal written in code','realizes the prime suspect was framed','follows money trail to a powerful organization','receives anonymous tips that predict crimes','interviews a witness who changes their story','finds a hidden room with chilling secrets','discovers the detective on the case was corrupt','links five seemingly unrelated deaths'],
  romance: ['meets their ex at the worst possible moment','must pretend to be engaged','receives a misdirected love letter','must choose between career and love','discovers a secret that could break trust','is stuck together during a crisis','helps plan a wedding for the one they love','finds a time capsule with a love note','competes against each other professionally','must say goodbye in 48 hours'],
  horror: ['must survive until dawn','discovers a door that should not exist','receives photos of themselves... sleeping','hears their name whispered from the walls','finds old footage of what happened here','realizes something is wearing a friend skin','wakes up in a different body every day','sees their own obituary in the paper','must follow the rules or face consequences','discovers the town disappeared overnight']
};

function rand(arr) {
  var buf = new Uint32Array(1);
  crypto.getRandomValues(buf);
  return arr[buf[0] % arr.length];
}

function generate() {
  var genre = document.getElementById('genre').value;
  var count = parseInt(document.getElementById('count').value, 10);
  if (genre === 'any') {
    var genres = ['scifi','fantasy','mystery','romance','horror'];
    genre = genres[rand(new Uint32Array(crypto.getRandomValues(new Uint32Array(1)))[0] % genres.length)];
  }
  var prompts = [];
  for (var i = 0; i < count; i++) {
    var g = genre;
    if (document.getElementById('genre').value === 'any') {
      g = ['scifi','fantasy','mystery','romance','horror'][rand(['scifi','fantasy','mystery','romance','horror'])];
    }
    var c = rand(characters[g]);
    var s = rand(settings[g]);
    var x = rand(conflicts[g]);
    prompts.push((i+1) + '. [' + g.toUpperCase() + '] ' + c + ' ' + s + ' ' + x + '.');
  }
  document.getElementById('result').textContent = prompts.join('\n\n');
}

function copyResult() {
  var text = document.getElementById('result').textContent;
  navigator.clipboard.writeText(text);
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
