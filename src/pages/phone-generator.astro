---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Phone Number Generator"
  description="Generate random US and international phone numbers for testing"
  category="Generator"
  keywords={["phone generator", "phone number generator", "generator"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Country</label>
        <select id="country" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="US">United States (+1)</option>
          <option value="UK">United Kingdom (+44)</option>
          <option value="CN">China (+86)</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Count</label>
        <select id="count" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="1">1</option><option value="5" selected>5</option><option value="10">10</option><option value="20">20</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
function randInt(max) {
  var buf = new Uint32Array(1);
  crypto.getRandomValues(buf);
  return buf[0] % max;
}

function generateUS() {
  var npa = '555';
  var nxx = String(randInt(900) + 100);
  var xxxx = String(randInt(10000)).padStart(4, '0');
  return '+1 (' + npa + ') ' + nxx + '-' + xxxx;
}

function generateUK() {
  var prefix = ['070','071','074','075','077','078','079'][randInt(7)];
  var block = String(randInt(1000000)).padStart(6, '0');
  return '+44 ' + prefix + ' ' + block.slice(0,3) + ' ' + block.slice(3);
}

function generateCN() {
  var prefixes = ['130','131','132','133','134','135','136','137','138','139','150','151','152','155','156','157','158','159','180','181','182','183','185','186','187','188','189'];
  var prefix = prefixes[randInt(prefixes.length)];
  var tail = String(randInt(100000000)).padStart(8, '0');
  return '+86 ' + prefix + ' ' + tail.slice(0,4) + ' ' + tail.slice(4);
}

function generate() {
  var country = document.getElementById('country').value;
  var count = parseInt(document.getElementById('count').value, 10);
  var fns = { US: generateUS, UK: generateUK, CN: generateCN };
  var phones = [];
  for (var i = 0; i < count; i++) {
    phones.push(fns[country]());
  }
  document.getElementById('result').textContent = phones.join('\n');
}

function copyResult() {
  var text = document.getElementById('result').textContent;
  navigator.clipboard.writeText(text);
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
