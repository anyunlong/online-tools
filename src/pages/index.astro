---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import ToolsExplorer from '../components/ToolsExplorer.astro';
import FeaturedTools from '../components/FeaturedTools.astro';
import SocialProof from '../components/SocialProof.astro';
import SiteFooter from '../components/SiteFooter.astro';
import tools from '../data/tools.json';

const siteUrl = 'https://www.4uses.com';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '4uses',
  url: siteUrl,
  description: 'Free online tools: JSON Formatter, Base64 Encoder, Timestamp Converter, UUID Generator, QR Code Generator and 20+ more utilities. No registration required.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

const catOrder = [
  'Encode/Decode', 'Hash', 'Text', 'Time', 'Dev Tools',
  'Convert', 'Formatter', 'Generator', 'Security', 'Design',
  'Image', 'Math', 'Network',
];

const catEmoji: Record<string, string> = {
  'Encode/Decode': '\u{1F510}',
  'Hash': '\u{1F512}',
  'Text': '\u{1F4DD}',
  'Time': '\u{23F0}',
  'Dev Tools': '\u{1F6E0}',
  'Convert': '\u{1F504}',
  'Formatter': '\u{1F4CB}',
  'Generator': '\u{2728}',
  'Security': '\u{1F6E1}',
  'Design': '\u{1F3A8}',
  'Image': '\u{1F5BC}',
  'Math': '\u{1F522}',
  'Network': '\u{1F310}',
};

const categories = catOrder.filter(cat => tools.some(t => t.cat === cat));
for (const t of tools) {
  if (!catOrder.includes(t.cat)) {
    categories.push(t.cat);
  }
}
---

<BaseLayout
  title="Online Toolbox | 4uses"
  description="Free online tools: JSON Formatter, Base64 Encoder, Timestamp Converter, UUID Generator, QR Code Generator and 20+ more utilities. No registration required."
  schema={websiteSchema}
>
  <SiteHeader />
  <main class="flex-1">
    <HeroSection />
    <ToolsExplorer />
    <FeaturedTools />
    <SocialProof />
  </main>
  <SiteFooter />
</BaseLayout>
