---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="QR Code Reader"
  description="Upload a QR code image and decode its content instantly in your browser"
  category="Image"
  keywords={["qr reader", "qr code reader", "image"]}
>
  <div class="space-y-4">
    <input type="file" id="file" accept="image/*" class="text-sm text-surface-300 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:bg-brand-500 file:text-white hover:file:bg-brand-400 file:cursor-pointer file:transition-colors" onchange="scanQR()" />
    <div class="flex justify-center">
      <img id="preview" class="max-w-full max-h-60 rounded-xl border border-surface-600 hidden" />
    </div>
    <div id="qrResult" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
function scanQR() {
  var file = document.getElementById('file').files[0];
  var resultDiv = document.getElementById('qrResult');
  var preview = document.getElementById('preview');

  if (!file) {
    resultDiv.textContent = 'Select a QR code image file.';
    return;
  }

  resultDiv.textContent = 'Scanning QR code...';

  var reader = new FileReader();
  reader.onload = function(e) {
    var previewDataUrl = e.target.result;
    preview.src = previewDataUrl;
    preview.classList.remove('hidden');

    var formData = new FormData();
    formData.append('file', file);

    fetch('https://api.qrserver.com/v1/read-qr-code/', {
      method: 'POST',
      body: formData
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data && data[0] && data[0].symbol && data[0].symbol[0]) {
        var decoded = data[0].symbol[0].data;
        if (decoded) {
          resultDiv.textContent = 'Decoded QR Content:\n\n' + decoded;
        } else {
          resultDiv.textContent = 'QR code detected but no readable data found.';
        }
      } else {
        resultDiv.textContent = 'No QR code detected in this image.\nTry a clearer image or a different angle.';
      }
    })
    .catch(function() {
      resultDiv.textContent = 'Unable to scan QR code (API unavailable).\n\nTip: For mobile QR scanning, try:\n\u2022 Google Lens or built-in camera QR scanner\n\u2022 zxing.org/w/decode.jspx (upload online)\n\u2022 qrscanner.net';
    });
  };
  reader.readAsDataURL(file);
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
