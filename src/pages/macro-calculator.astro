---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Macro Calculator"
  description="Calculate daily protein, carb, and fat intake based on your goals"
  category="Health"
  keywords={["macro calculator", "macro calculator", "health"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const v=document.getElementById('inp').value.split(/[,\s]+/).map(Number);
  if(v.length<2||v.some(isNaN)){document.getElementById('out').textContent='Format: weight_kg, goal (1=lose 2=maintain 3=gain)';return;}
  const m=[[2.2,1.8,0.8],[1.8,1.2,0.8],[2.0,1.0,1.2]][Math.min(3,Math.max(1,v[1]||2))-1];
  document.getElementById('out').innerHTML='<div class="grid grid-cols-3 gap-3"><div class="text-center"><div class="text-lg font-bold text-blue-400">'+Math.round(v[0]*m[0])+'g</div><div class="text-xs text-surface-400">Protein</div></div><div class="text-center"><div class="text-lg font-bold text-yellow-400">'+Math.round(v[0]*m[1])+'g</div><div class="text-xs text-surface-400">Carbs</div></div><div class="text-center"><div class="text-lg font-bold text-red-400">'+Math.round(v[0]*m[2])+'g</div><div class="text-xs text-surface-400">Fat</div></div></div>';
}
function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
