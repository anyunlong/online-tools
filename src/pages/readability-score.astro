---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Readability Score"
  description="Check readability with Flesch-Kincaid, Gunning Fog, and SMOG indices"
  category="Text"
  keywords={["readability score", "readability score", "text"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process(){
  const t=document.getElementById('inp').value.trim();if(!t){document.getElementById('out').textContent='Enter text';return;}
  const w=t.split(/\s+/).filter(x=>x),s=t.split(/[.!?]+/).filter(x=>x.trim()),syl=w.reduce((a,x)=>{const c=x.toLowerCase().replace(/[^a-z]/g,'');return a+Math.max(1,(c.match(/[aeiouy]/g)||[]).length)},0),wc=w.length,sc=s.length||1,fr=206.835-1.015*(wc/sc)-84.6*(syl/wc);
  document.getElementById('out').innerHTML='<div class="text-xl font-bold text-brand-400">Level: '+(fr>90?'5th grade':fr>80?'6th':fr>70?'7th':fr>60?'8-9th':fr>50?'10-12th':fr>30?'College':'College grad')+'</div><div class="text-sm mt-1">'+wc+' words · '+sc+' sentences · Score: '+Math.round(fr)+'</div>';
}
function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
