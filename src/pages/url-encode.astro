---
import ToolLayout from '../components/ToolLayout.astro';
import DualPane from '../components/DualPane.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="URL Encoder"
  description="URL encoding and decoding"
  category="Encode/Decode"
  keywords={["url", "encode", "decode"]}
>
  <DualPane>
    <Textarea id="inp" slot="input" label="Input" placeholder="Enter text or URL encoded" rows="12" class="tool-area" />
    <Textarea id="out" slot="output" label="Output" rows="12" readonly />
  </DualPane>
  <div class="flex gap-2 mt-4">
    <Button onclick="encode()">Encode</Button>
    <Button variant="secondary" onclick="decode()">Decode</Button>
  </div>
<script is:inline>
function encode() {
  document.getElementById('out').value = encodeURIComponent(document.getElementById('inp').value);
}
function decode() {
  try {
    document.getElementById('out').value = decodeURIComponent(document.getElementById('inp').value);
  } catch (_) {
    document.getElementById('out').value = 'Decoding failed: invalid URL encoding';
  }
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is URL Encoding?</h2>
  <p class="mb-3">URL encoding (also called percent-encoding) converts special characters into a format that can be safely transmitted in a URL. Characters like spaces, ampersands, and non-ASCII letters are replaced with a percent sign followed by two hexadecimal digits.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Building API requests with query parameters that contain special characters</li>
    <li>Encoding user input before including it in a URL to prevent broken links</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your text and click Encode to convert special characters to %XX format, or Decode to revert.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/base64/" class="text-primary hover:underline">Base64 Encoder</a> for encoding arbitrary data into ASCII-safe strings.</p>
</div>
</ToolLayout>
