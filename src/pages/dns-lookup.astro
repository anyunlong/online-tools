---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="DNS Lookup"
  description="Perform DNS record lookups for any domain"
  category="Network"
  keywords={["dns", "lookup", "domain", "records"]}
>
  <div class="flex gap-3 items-end flex-wrap">
    <div class="flex-1 min-w-[200px]">
      <label for="domain" class="text-sm text-surface-300 mb-1.5 block font-medium">Domain</label>
      <Input id="domain" placeholder="example.com" value="google.com" class="w-full" />
    </div>
    <div>
      <label for="type" class="text-sm text-surface-300 mb-1.5 block font-medium">Record Type</label>
      <select id="type" class="rounded-xl border border-surface-700 bg-surface-800/50 px-3 py-2 text-sm text-surface-100">
        <option value="A">A (IPv4)</option><option value="AAAA">AAAA (IPv6)</option><option value="CNAME">CNAME</option><option value="MX">MX (Mail)</option><option value="NS">NS (Nameserver)</option><option value="TXT">TXT</option><option value="SOA">SOA</option>
      </select>
    </div>
    <Button onclick="lookup()">Lookup</Button>
  </div>
  <div id="result" class="mt-4"></div>
  <div id="error" class="text-xs text-red-400 mt-2"></div>
<script is:inline>
async function lookup() {
  var domain = document.getElementById('domain').value.trim();
  var type = document.getElementById('type').value;
  if (!domain) { document.getElementById('result').innerHTML = ''; return; }
  document.getElementById('result').innerHTML = '<p class="text-sm text-surface-400">Looking up ' + type + ' records for ' + domain + '...</p>';
  document.getElementById('error').textContent = '';
  try {
    var resp = await fetch('https://dns.google/resolve?name=' + encodeURIComponent(domain) + '&type=' + type);
    var data = await resp.json();
    if (data.Answer) {
      var html = '<div class="bg-surface-800/40 border border-surface-700/30 rounded-xl p-4"><p class="text-sm text-surface-300 mb-2">DNS Records for <strong class="text-brand-400">' + domain + '</strong> (' + type + ')</p><div class="space-y-1">';
      for (var i = 0; i < data.Answer.length; i++) {
        html += '<div class="text-sm font-mono text-surface-200 bg-surface-800/50 rounded-lg px-3 py-1.5">' + data.Answer[i].data + ' <span class="text-xs text-surface-500">(TTL: ' + data.Answer[i].TTL + 's)</span></div>';
      }
      html += '</div></div>';
      document.getElementById('result').innerHTML = html;
    } else {
      document.getElementById('result').innerHTML = '<p class="text-sm text-surface-400">No ' + type + ' records found for ' + domain + '</p>';
    }
  } catch(e) {
    document.getElementById('error').textContent = 'Error: ' + e.message;
    document.getElementById('result').innerHTML = '';
  }
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is DNS Lookup?</h2>
  <p class="mb-3">DNS (Domain Name System) lookup queries the internet's phonebook to resolve domain names to IP addresses, mail servers, and other records. Every time you visit a website, your browser performs a DNS lookup behind the scenes.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Troubleshooting website connectivity by checking if DNS records are correctly configured</li>
    <li>Verifying that domain changes (like new A records or MX records) have propagated</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter a domain, select a record type (A, AAAA, MX, etc.), and click Lookup to query Google's public DNS.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/ip-lookup/" class="text-primary hover:underline">IP Lookup</a> for geolocation information about IP addresses.</p>
</div>
</ToolLayout>
