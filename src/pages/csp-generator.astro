---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="CSP Header Generator"
  description="Generate Content Security Policy headers for your website"
  category="Security"
  keywords={["csp generator", "csp header generator", "security"]}
>
  <div class="space-y-4">
    <div class='text-sm text-surface-400'>Configure options above</div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function process() {
  o('Content-Security-Policy:\n  default-src \'self\';\n  script-src \'self\' \'unsafe-inline\';\n  style-src \'self\' \'unsafe-inline\';\n  img-src \'self\' data: https:;\n  font-src \'self\';\n  connect-src \'self\';\n  frame-ancestors \'none\';\n  base-uri \'self\';\n  form-action \'self\';\n\n⚠ Review directives before deploying.\n\'unsafe-inline\' weakens CSP — consider nonces/hashes in production.');
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';if(timer)clearInterval(timer);}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
