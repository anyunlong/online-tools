---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Timestamp Converter"
  description="Convert Unix timestamps to dates and back"
  category="Time"
  keywords={["timestamp", "unix", "convert"]}
>
  <div class="flex gap-3 flex-wrap items-center">
    <Input id="ts" type="number" class="flex-1 min-w-[200px]" placeholder="Enter timestamp (seconds)" />
    <Button onclick="tsToDate()">→ Date</Button>
  </div>
  <div class="flex gap-3 flex-wrap items-center mt-3">
    <Input id="dt" type="datetime-local" class="flex-1 min-w-[200px]" />
    <Button onclick="dateToTs()">→ Timestamp</Button>
  </div>
  <div id="ts-result" class="mt-4 text-sm bg-surface-800/40 border border-surface-700/30 rounded-xl p-3 min-h-[40px] text-surface-200"></div>
  <div id="current" class="text-xs text-surface-500 mt-2"></div>
<script is:inline>
function tsToDate() {
  var ts = document.getElementById('ts').value.trim();
  if (!ts) { document.getElementById('ts-result').textContent = 'Enter a Unix timestamp'; return; }
  var val = parseInt(ts, 10);
  if (isNaN(val)) { document.getElementById('ts-result').textContent = 'Invalid timestamp'; return; }

  var ms = ts.length > 10 ? val : val * 1000;
  var d = new Date(ms);

  document.getElementById('ts-result').innerHTML =
    '<div class="text-brand-400 font-bold">' + d.toLocaleString('en-US') + '</div>' +
    '<div class="text-xs text-surface-400 mt-1">UTC: ' + d.toISOString() + '</div>' +
    '<div class="text-xs text-surface-400">Unix (s): ' + Math.floor(ms / 1000) + '</div>';
}

function dateToTs() {
  var dt = document.getElementById('dt').value;
  if (!dt) { document.getElementById('ts-result').textContent = 'Select a date and time'; return; }
  var d = new Date(dt);
  var s = Math.floor(d.getTime() / 1000);

  document.getElementById('ts-result').innerHTML =
    '<div class="text-brand-400 font-bold">' + d.toLocaleString('en-US') + '</div>' +
    '<div class="text-xs text-surface-400 mt-1">Timestamp (s): ' + s + '</div>' +
    '<div class="text-xs text-surface-400">Timestamp (ms): ' + d.getTime() + '</div>';
}

(function() {
  var now = Math.floor(Date.now() / 1000);
  document.getElementById('current').textContent = 'Current Unix timestamp: ' + now;
})();
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Timestamp Converter?</h2>
  <p class="mb-3">A timestamp converter translates between Unix timestamps (seconds or milliseconds since January 1, 1970) and human-readable dates. Unix timestamps are widely used in programming, databases, and APIs to represent points in time as simple numbers.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Debugging API responses that return timestamps instead of formatted dates</li>
    <li>Analyzing server logs, database entries, and event tracking data</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter a Unix timestamp to view the corresponding date, or pick a date to get its timestamp value.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/date-calculator/" class="text-primary hover:underline">Date Calculator</a> for adding or subtracting days between dates.</p>
</div>
</ToolLayout>
