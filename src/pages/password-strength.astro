---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
---

<ToolLayout
  title="Password Strength Checker"
  description="Check how strong your password is"
  category="Security"
  keywords={["password", "strength", "security", "entropy"]}
>
  <Input id="pwd" type="text" placeholder="Type a password to check..." class="w-full mb-4" oninput="check()" />
  <div id="result" class="space-y-3"></div>
<script is:inline>
function check() {
  var p = document.getElementById('pwd').value;
  if (!p) { document.getElementById('result').innerHTML = '<p class="text-sm text-surface-400">Enter a password to check its strength.</p>'; return; }
  var score = 0;
  if (p.length >= 8) score++;
  if (p.length >= 12) score++;
  if (p.length >= 16) score++;
  if (/[a-z]/.test(p)) score++;
  if (/[A-Z]/.test(p)) score++;
  if (/[0-9]/.test(p)) score++;
  if (/[^a-zA-Z0-9]/.test(p)) score++;
  if (p.length >= 20) score++;
  var charset = 0;
  if (/[a-z]/.test(p)) charset += 26;
  if (/[A-Z]/.test(p)) charset += 26;
  if (/[0-9]/.test(p)) charset += 10;
  if (/[^a-zA-Z0-9]/.test(p)) charset += 33;
  var entropy = Math.floor(p.length * Math.log2(charset || 1));
  var level, color, barWidth;
  if (score <= 2) { level = 'Weak'; color = '#ef4444'; barWidth = '25%'; }
  else if (score <= 4) { level = 'Fair'; color = '#f59e0b'; barWidth = '50%'; }
  else if (score <= 6) { level = 'Strong'; color = '#22c55e'; barWidth = '75%'; }
  else { level = 'Very Strong'; color = '#6366f1'; barWidth = '100%'; }
  document.getElementById('result').innerHTML =
    '<div class="bg-surface-800/40 border border-surface-700/30 rounded-xl p-4">' +
    '<div class="flex items-center justify-between mb-2"><span class="text-lg font-bold" style="color:' + color + '">' + level + '</span><span class="text-sm text-surface-400">' + entropy + ' bits entropy</span></div>' +
    '<div class="w-full h-2 bg-surface-700 rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-300" style="width:' + barWidth + ';background:' + color + '"></div></div>' +
    '<div class="grid grid-cols-2 gap-2 mt-3 text-xs">' +
    '<div class="text-surface-400">Length: <span class="text-surface-200">' + p.length + ' chars</span></div>' +
    '<div class="text-surface-400">Charset: <span class="text-surface-200">' + charset + ' chars</span></div>' +
    '<div class="text-surface-400">Uppercase: <span class="' + (/[A-Z]/.test(p) ? 'text-brand-400' : 'text-red-400') + '">' + (/[A-Z]/.test(p) ? '✓' : '✗') + '</span></div>' +
    '<div class="text-surface-400">Lowercase: <span class="' + (/[a-z]/.test(p) ? 'text-brand-400' : 'text-red-400') + '">' + (/[a-z]/.test(p) ? '✓' : '✗') + '</span></div>' +
    '<div class="text-surface-400">Numbers: <span class="' + (/[0-9]/.test(p) ? 'text-brand-400' : 'text-red-400') + '">' + (/[0-9]/.test(p) ? '✓' : '✗') + '</span></div>' +
    '<div class="text-surface-400">Symbols: <span class="' + (/[^a-zA-Z0-9]/.test(p) ? 'text-brand-400' : 'text-red-400') + '">' + (/[^a-zA-Z0-9]/.test(p) ? '✓' : '✗') + '</span></div>' +
    '</div></div>';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Password Strength Checker?</h2>
  <p class="mb-3">A password strength checker analyzes your password's length, character variety, and entropy to estimate how resistant it is to brute-force attacks. It shows you exactly what makes a password strong — or weak — so you can improve it.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Testing passwords before using them to ensure they meet security requirements</li>
    <li>Educating yourself or team members about what constitutes a strong password</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Type any password to see its strength rating, entropy (in bits), and which character types are present.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/password-generator/" class="text-primary hover:underline">Password Generator</a> for creating strong passwords from scratch.</p>
</div>
</ToolLayout>
