---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="HTML Table Generator"
  description="Generate responsive HTML tables with custom rows and columns"
  category="Dev Tools"
  keywords={["html table gen", "html table generator", "dev tools"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap items-end">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Rows</label>
        <select id="rows" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="2">2</option><option value="3" selected>3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="8">8</option><option value="10">10</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Columns</label>
        <select id="cols" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="2">2</option><option value="3" selected>3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="8">8</option>
        </select>
      </div>
      <div class="flex items-center gap-2">
        <input id="headerCb" type="checkbox" checked class="accent-brand-500 w-4 h-4" />
        <label for="headerCb" class="text-sm text-surface-300">Include Header</label>
      </div>
    </div>
    <div>
      <label class="text-sm text-surface-300 block mb-1.5">Border Style</label>
      <select id="borderStyle" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
        <option value="solid" selected>Solid</option>
        <option value="dashed">Dashed</option>
        <option value="none">No Border</option>
      </select>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <textarea id="result" readonly class="w-full min-h-[200px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all resize-y"></textarea>
  </div>
<script is:inline>
function generate() {
  var rows = parseInt(document.getElementById('rows').value, 10);
  var cols = parseInt(document.getElementById('cols').value, 10);
  var hasHeader = document.getElementById('headerCb').checked;
  var border = document.getElementById('borderStyle').value;

  var borderStyle = border === 'none' ? '' : '1px solid #ccc';
  var borderCollapse = border === 'none' ? '' : 'border-collapse: collapse;';
  var thStyle = border === 'none' ? '' : 'border: 1px solid #ccc;';
  var tdStyle = border === 'none' ? '' : 'border: 1px solid #ccc;';
  if (border === 'dashed') {
    thStyle = 'border: 1px dashed #ccc;';
    tdStyle = 'border: 1px dashed #ccc;';
  }

  var html = '<table style="' + borderCollapse;
  if (borderStyle) html += ' border:' + borderStyle + ';';
  html += '">\n';
  if (hasHeader) {
    html += '  <thead>\n    <tr>\n';
    for (var c = 0; c < cols; c++) {
      html += '      <th style="' + thStyle + 'padding: 8px 12px; background: #f5f5f5;">Header ' + (c + 1) + '</th>\n';
    }
    html += '    </tr>\n  </thead>\n';
  }
  html += '  <tbody>\n';
  for (var r = 0; r < rows; r++) {
    html += '    <tr>\n';
    for (var c2 = 0; c2 < cols; c2++) {
      html += '      <td style="' + tdStyle + 'padding: 8px 12px;">Row ' + (r + 1) + ', Col ' + (c2 + 1) + '</td>\n';
    }
    html += '    </tr>\n';
  }
  html += '  </tbody>\n</table>';
  document.getElementById('result').value = html;
}

function copyResult() {
  var text = document.getElementById('result').value;
  navigator.clipboard.writeText(text);
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
