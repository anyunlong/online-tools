---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="QR Code Generator"
  description="Generate QR code images online"
  category="Generator"
  keywords={["qr", "qr", "generate"]}
>
  <Input id="url" class="w-full" placeholder="Enter text..." value="https://" />
  <div class="mt-3">
    <Button onclick="genQR()">Generate QR Code</Button>
  </div>
  <div id="qr-area" class="mt-5 flex justify-center"></div>
<script is:inline>
function generate() {
  const v=document.getElementById('inp').value.trim();
  if(!v){o('Enter text or URL to encode');return;}
  // Use Google Charts API for QR (fallback since no library)
  const url='https://api.qrserver.com/v1/create-qr-code/?size=200x200&data='+encodeURIComponent(v);
  document.getElementById('out').innerHTML='<img src="'+url+'" alt="QR Code" style="max-width:200px;display:block;margin:10px auto">';
}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').innerHTML='';}
function copyResult() {
  const el=document.getElementById('result');
  if(!el||!el.value) return;
  el.select();document.execCommand('copy');
  document.getElementById('msg').textContent='Copied!';
  setTimeout(()=>document.getElementById('msg').textContent='',2000);
}
</script><div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a QR Code Generator?</h2>
  <p class="mb-3">A QR code (Quick Response code) is a two-dimensional barcode that can store text, URLs, contact information, or other data that smartphones can instantly scan and read. Our generator creates QR codes from any text input right in your browser.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Sharing website links, WiFi credentials, or contact cards without typing</li>
    <li>Adding scannable codes to marketing materials, business cards, or product packaging</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter a URL or text and click Generate to create a QR code you can download as an image.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/url-encode/" class="text-primary hover:underline">URL Encoder</a> for safely encoding URLs before sharing.</p>
</div>
</ToolLayout>
