---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Quadratic Equation Solver"
  description="Solve quadratic equations and find real and complex roots"
  category="Math"
  keywords={["quadratic solver", "quadratic equation solver", "math"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process(){
  const v=document.getElementById('inp').value.split(/[,\s]+/).map(Number);
  if(v.length<3||v.some(isNaN)){document.getElementById('out').textContent='Format: a, b, c (ax²+bx+c=0)';return;}
  if(v[0]===0){document.getElementById('out').textContent='a cannot be 0';return;}
  const d=v[1]*v[1]-4*v[0]*v[2];
  if(d>0){const r1=(-v[1]+Math.sqrt(d))/(2*v[0]),r2=(-v[1]-Math.sqrt(d))/(2*v[0]);document.getElementById('out').innerHTML='<div class="text-brand-400">Two real roots:</div><div class="text-lg font-bold">x₁='+r1.toFixed(4)+'</div><div class="text-lg font-bold">x₂='+r2.toFixed(4)+'</div>';}
  else if(d===0){document.getElementById('out').innerHTML='<div class="text-brand-400">One real root:</div><div class="text-lg font-bold">x='+(-v[1]/(2*v[0])).toFixed(4)+'</div>';}
  else{const r=-v[1]/(2*v[0]),im=Math.sqrt(-d)/(2*v[0]);document.getElementById('out').innerHTML='<div class="text-brand-400">Complex roots:</div><div class="text-lg font-bold">x='+r.toFixed(4)+' ± '+im.toFixed(4)+'i</div>';}
}
function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
