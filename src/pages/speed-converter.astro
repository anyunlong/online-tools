---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Speed Converter"
  description="Convert between mph, kph, knots, and mach"
  category="Convert"
  keywords={["speed converter", "speed converter", "convert"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function convert() {
  const v = parseFloat(document.getElementById('inp').value);
  const from = document.getElementById('from-unit').value;
  const to = document.getElementById('to-unit').value;
  if (isNaN(v)) { document.getElementById('out').textContent = '—'; return; }
  // Simple placeholder conversion — replace with real rates
  const rates = { 'default': 1 };
  rates[to] = rates[to] || 1;
  rates[from] = rates[from] || 1;
  const result = v * (rates[to] / rates[from]);
  document.getElementById('out').textContent = result.toFixed(4);
}
function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly below.</p>
</slot>
</ToolLayout>
