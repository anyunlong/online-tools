---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Roman Numerals Converter"
  description="Convert between Roman numerals and numbers"
  category="Convert"
  keywords={["roman", "numerals", "convert", "numbers"]}
>
  <div class="space-y-4">
    <div class="flex gap-3 mb-2">
      <button onclick="setMode('toRoman')" id="btn-roman" class="cat-pill shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors border-primary bg-primary text-primary-foreground">Number \u2192 Roman</button>
      <button onclick="setMode('toNum')" id="btn-num" class="cat-pill shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors border-border bg-secondary/60 text-muted-foreground hover:text-foreground">Roman \u2192 Number</button>
    </div>
    <input id="inp" type="text" placeholder="Enter a number (1-3999)..." class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 font-mono w-full" oninput="convert()" />
    <div class="mt-4">
      <div class="text-xs text-surface-400 mb-1">Result:</div>
      <div id="out" class="w-full rounded-xl border border-surface-600 bg-surface-800 py-4 px-4 text-lg text-brand-400 font-mono text-center min-h-[56px] flex items-center justify-center"></div>
    </div>
    <div class="flex gap-2">
      <Button variant="secondary" size="sm" onclick="copyResult()">Copy</Button>
    </div>
  </div>
<script is:inline>
var mode = 'toRoman';

var romanMap = [
  { value: 1000, numeral: 'M' },
  { value: 900, numeral: 'CM' },
  { value: 500, numeral: 'D' },
  { value: 400, numeral: 'CD' },
  { value: 100, numeral: 'C' },
  { value: 90, numeral: 'XC' },
  { value: 50, numeral: 'L' },
  { value: 40, numeral: 'XL' },
  { value: 10, numeral: 'X' },
  { value: 9, numeral: 'IX' },
  { value: 5, numeral: 'V' },
  { value: 4, numeral: 'IV' },
  { value: 1, numeral: 'I' }
];

function numberToRoman(num) {
  if (num <= 0 || num > 3999 || !Number.isInteger(num)) return null;
  var result = '';
  var remaining = num;
  romanMap.forEach(function(r) {
    while (remaining >= r.value) {
      result += r.numeral;
      remaining -= r.value;
    }
  });
  return result;
}

function romanToNumber(roman) {
  var values = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
  var sum = 0;
  var upper = roman.toUpperCase();
  for (var i = 0; i < upper.length; i++) {
    var current = values[upper[i]];
    var next = values[upper[i + 1]];
    if (!current) return null;
    if (next && current < next) {
      sum -= current;
    } else {
      sum += current;
    }
  }
  return sum;
}

function setMode(m) {
  mode = m;
  var btnRoman = document.getElementById('btn-roman');
  var btnNum = document.getElementById('btn-num');
  var activeClass = 'cat-pill shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors border-primary bg-primary text-primary-foreground';
  var inactiveClass = 'cat-pill shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition-colors border-border bg-secondary/60 text-muted-foreground hover:text-foreground';

  if (m === 'toRoman') {
    btnRoman.className = activeClass;
    btnNum.className = inactiveClass;
    document.getElementById('inp').placeholder = 'Enter a number (1-3999)...';
  } else {
    btnNum.className = activeClass;
    btnRoman.className = inactiveClass;
    document.getElementById('inp').placeholder = 'Enter Roman numerals (e.g. MCMXCIX)...';
  }
  convert();
}

function convert() {
  var input = document.getElementById('inp').value.trim();
  if (!input) {
    document.getElementById('out').textContent = '';
    return;
  }
  if (mode === 'toRoman') {
    var num = parseInt(input, 10);
    if (isNaN(num)) {
      document.getElementById('out').textContent = 'Enter a valid integer (1-3999)';
      return;
    }
    var roman = numberToRoman(num);
    if (!roman) {
      document.getElementById('out').textContent = 'Number must be 1-3999';
      return;
    }
    document.getElementById('out').textContent = roman;
  } else {
    var result = romanToNumber(input);
    if (result === null || result === 0) {
      document.getElementById('out').textContent = 'Invalid Roman numerals';
      return;
    }
    document.getElementById('out').textContent = result.toString();
  }
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('out').value || document.getElementById('out').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Roman Numerals Converter?</h2>
  <p class="mb-3">A Roman numerals converter translates between standard numbers (1-3999) and Roman numeral notation using letters I, V, X, L, C, D, and M. Roman numerals appear everywhere from clock faces to movie credits to book chapter headings.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Reading dates written in Roman numerals on buildings, monuments, and movies</li>
    <li>Converting chapter numbers or outline sections for formal documents</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Choose direction, enter a number or Roman numerals, and see the instant conversion.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/number-base/" class="text-primary hover:underline">Number Base Converter</a> for converting between binary, octal, decimal, and hex.</p>
</div>
</ToolLayout>
