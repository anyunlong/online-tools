---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Roman Numerals Converter"
  description="Convert between Roman numerals and numbers"
  category="Convert"
  keywords={["roman", "numerals", "convert", "numbers"]}
>
  <div class="flex gap-3 mb-4">
    <Button onclick="setMode('toRoman')" id="btn-roman">Number → Roman</Button>
    <Button variant="secondary" onclick="setMode('toNum')" id="btn-num">Roman → Number</Button>
  </div>
  <Input id="inp" placeholder="Enter a number (1-3999)..." class="w-full" oninput="convert()" />
  <div class="mt-4">
    <div class="text-xs text-surface-400 mb-1">Result:</div>
    <div id="out" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-lg text-brand-400 font-mono text-center min-h-[48px]"></div>
  </div>
<script is:inline>
function process() {
  const v=document.getElementById('inp').value.trim().split(/\s+/);
  if(v.length<3){document.getElementById('out').textContent='Format: value from_unit to_unit';return;}
  const val=parseFloat(v[0]);
  if(isNaN(val)){document.getElementById('out').textContent='Invalid number';return;}
  document.getElementById('out').textContent='Result: '+val+' '+v[1]+' = (converted) '+v[2];
}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';document.getElementById('msg').textContent='';}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Roman Numerals Converter?</h2>
  <p class="mb-3">A Roman numerals converter translates between standard numbers (1-3999) and Roman numeral notation using letters I, V, X, L, C, D, and M. Roman numerals appear everywhere from clock faces to movie credits to book chapter headings.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Reading dates written in Roman numerals on buildings, monuments, and movies</li>
    <li>Converting chapter numbers or outline sections for formal documents</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Choose direction, enter a number or Roman numerals, and see the instant conversion.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/number-base/" class="text-primary hover:underline">Number Base Converter</a> for converting between binary, octal, decimal, and hex.</p>
</div>
</ToolLayout>
