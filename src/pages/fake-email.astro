---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Fake Email Generator"
  description="Generate random email addresses for testing forms and databases"
  category="Generator"
  keywords={["fake email", "fake email generator", "generator"]}
>
  <div class="space-y-4">
    <div>
      <label class="text-sm text-surface-300 block mb-1.5">Count</label>
      <select id="count" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
        <option value="1">1</option><option value="5" selected>5</option><option value="10">10</option><option value="20">20</option>
      </select>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
var firstNames = ['alex','jordan','taylor','morgan','casey','riley','jamie','quinn','avery','skyler','jesse','drew','sam','chris','pat','cameron','blake','dakota','hayden','parker'];
var lastNames = ['smith','johnson','williams','brown','jones','garcia','miller','davis','rodriguez','martinez','wilson','anderson','taylor','thomas','lee','clark','lewis','walker','hall','young'];
var domains = ['gmail.com','outlook.com','yahoo.com','proton.me','icloud.com','mail.com','zoho.com','fastmail.com','tutanota.com','live.com','hey.com','pm.me'];

function rand(arr) {
  var buf = new Uint32Array(1);
  crypto.getRandomValues(buf);
  return arr[buf[0] % arr.length];
}

function generate() {
  var count = parseInt(document.getElementById('count').value, 10);
  var emails = [];
  var used = {};
  for (var i = 0; i < count; i++) {
    var email;
    var tries = 0;
    do {
      var fn = rand(firstNames);
      var ln = rand(lastNames);
      var num = '';
      if (tries % 3 === 1) num = String(new Uint32Array(crypto.getRandomValues(new Uint32Array(1)))[0] % 1000);
      if (tries % 3 === 2) fn = fn + '.' + rand(firstNames);
      email = fn + num + '@' + rand(domains);
      tries++;
    } while (used[email] && tries < 50);
    used[email] = true;
    emails.push(email);
  }
  document.getElementById('result').textContent = emails.join('\n');
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value || document.getElementById('result').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
