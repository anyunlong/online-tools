---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="XML to JSON Converter"
  description="Convert XML data to JSON format"
  category="Convert"
  keywords={["xml", "json", "convert"]}
>
  <Textarea id="inp" placeholder="Paste XML here..." rows="12" class="tool-area" />
  <div class="flex gap-2 mt-4">
    <Button onclick="convert()">Convert to JSON</Button>
    <Button variant="secondary" onclick="copyOut()">Copy</Button>
  </div>
  <div class="text-xs text-surface-400 mt-3 mb-1">JSON Output:</div>
  <div id="out" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 font-mono overflow-auto min-h-[200px] max-h-[500px] whitespace-pre"></div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function xmlToJson(xml) {
  var obj = {};
  if (xml.nodeType == 1) {
    if (xml.attributes.length > 0) {
      for (var j = 0; j < xml.attributes.length; j++) {
        var attr = xml.attributes.item(j);
        obj['@' + attr.nodeName] = attr.nodeValue;
      }
    }
  }
  if (xml.nodeType == 3) { return xml.nodeValue.trim() || undefined; }
  if (xml.hasChildNodes()) {
    var hasElements = false;
    for (var i = 0; i < xml.childNodes.length; i++) {
      if (xml.childNodes[i].nodeType == 1) hasElements = true;
      var item = xmlToJson(xml.childNodes[i]);
      if (item !== undefined) {
        var tag = xml.childNodes[i].nodeName;
        if (tag === '#text') { return item; }
        if (obj[tag] === undefined) obj[tag] = item;
        else { if (!Array.isArray(obj[tag])) obj[tag] = [obj[tag]]; obj[tag].push(item); }
      }
    }
    if (!hasElements) {
      var text = '';
      for (var k = 0; k < xml.childNodes.length; k++) {
        if (xml.childNodes[k].nodeType == 3) text += xml.childNodes[k].nodeValue;
      }
      text = text.trim();
      if (text) {
        if (Object.keys(obj).length === 0) return text;
        obj['#text'] = text;
      }
    }
  }
  return Object.keys(obj).length === 0 ? '' : obj;
}
function convert() {
  try {
    var parser = new DOMParser();
    var xmlDoc = parser.parseFromString(document.getElementById('inp').value, 'text/xml');
    var error = xmlDoc.querySelector('parsererror');
    if (error) { document.getElementById('msg').textContent = 'XML Parse Error: ' + error.textContent; document.getElementById('msg').className = 'text-xs mt-2 text-red-400'; document.getElementById('out').textContent = ''; return; }
    var json = xmlToJson(xmlDoc.documentElement);
    var jsonStr = JSON.stringify(json, null, 2);
    document.getElementById('out').textContent = jsonStr;
    document.getElementById('msg').textContent = 'Conversion successful';
    document.getElementById('msg').className = 'text-xs mt-2 text-brand-400';
  } catch(e) {
    document.getElementById('msg').textContent = 'Error: ' + e.message;
    document.getElementById('msg').className = 'text-xs mt-2 text-red-400';
  }
}
function copyOut() {
  var t = document.getElementById('out').textContent;
  if (!t) return;
  navigator.clipboard.writeText(t).then(function() {
    var btn = document.querySelector('[onclick="copyOut()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is an XML to JSON Converter?</h2>
  <p class="mb-3">An XML to JSON converter transforms XML markup data into JSON format, making it usable in JavaScript applications and modern web APIs. It preserves element hierarchy, attributes (prefixed with @), and text content.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Migrating legacy XML-based APIs or configuration files to modern JSON-based systems</li>
    <li>Processing XML data feeds (RSS, SOAP) in JavaScript applications</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your XML and click Convert to JSON. Attributes are prefixed with @ for easy identification.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-formatter/" class="text-primary hover:underline">JSON Formatter</a> for beautifying JSON output after conversion.</p>
</div>
</ToolLayout>
