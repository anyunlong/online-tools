---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="CSS Minifier"
  description="Minify CSS to reduce file size"
  category="Dev Tools"
  keywords={["css", "minify", "compress", "optimize"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Paste CSS code..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Minify</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  let css = document.getElementById('inp').value;
  if (!css) return;
  const original = css.length;
  css = css.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\s+/g, ' ').replace(/\s*([{}:;,])\s*/g, '$1').replace(/;}/g, '}').trim();
  document.getElementById('out').textContent = css;
  document.getElementById('msg').textContent = `Original: ${(original/1024).toFixed(1)}KB → Minified: ${(css.length/1024).toFixed(1)}KB (${((1-css.length/original)*100).toFixed(1)}% smaller)`;
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a CSS Minifier?</h2>
  <p class="mb-3">A CSS minifier removes unnecessary characters from stylesheet code — including whitespace, line breaks, comments, and redundant semicolons — without changing how the CSS works. Minified CSS files are significantly smaller, which means faster page loads and better SEO scores.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Preparing CSS files for production deployment to reduce bandwidth and improve load times</li>
    <li>Comparing original and minified file sizes to measure optimization gains</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your CSS code and click Minify to strip out all unnecessary characters and see the size reduction.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/html-minifier/" class="text-primary hover:underline">HTML Minifier</a> for compressing your HTML alongside your CSS.</p>
</div>
</ToolLayout>
