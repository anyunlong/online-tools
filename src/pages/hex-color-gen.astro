---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Random HEX Color Generator"
  description="Generate random colors with their HEX, RGB, and HSL values"
  category="Generator"
  keywords={["hex color gen", "random hex color generator", "generator"]}
>
  <div class="space-y-4">
    <div>
      <label class="text-sm text-surface-300 block mb-1.5">Count</label>
      <select id="count" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
        <option value="1">1</option><option value="3">3</option><option value="6" selected>6</option><option value="12">12</option>
      </select>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy All</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
function randByte() {
  var buf = new Uint8Array(1);
  crypto.getRandomValues(buf);
  return buf[0];
}

function rgbToHex(r, g, b) {
  return '#' + [r, g, b].map(function(v) { return v.toString(16).padStart(2, '0'); }).join('');
}

function hexToRgb(hex) {
  return {
    r: parseInt(hex.slice(1, 3), 16),
    g: parseInt(hex.slice(3, 5), 16),
    b: parseInt(hex.slice(5, 7), 16)
  };
}

function rgbToHsl(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  var max = Math.max(r, g, b), min = Math.min(r, g, b);
  var h, s, l = (max + min) / 2;
  if (max === min) { h = s = 0; } else {
    var d = max - min;
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
      case g: h = ((b - r) / d + 2) / 6; break;
      case b: h = ((r - g) / d + 4) / 6; break;
    }
  }
  return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
}

function generate() {
  var count = parseInt(document.getElementById('count').value, 10);
  var colors = [];
  for (var i = 0; i < count; i++) {
    colors.push(rgbToHex(randByte(), randByte(), randByte()));
  }
  var html = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;">';
  colors.forEach(function(hex) {
    var rgb = hexToRgb(hex);
    var hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
    var textColor = (rgb.r * 0.299 + rgb.g * 0.587 + rgb.b * 0.114) > 150 ? '#000' : '#fff';
    html += '<div style="background:' + hex + ';color:' + textColor + ';border-radius:10px;padding:12px;text-align:center;cursor:pointer;font-size:12px;" onclick="navigator.clipboard.writeText(\'' + hex + '\');this.style.outline=\'2px solid #fff\'" title="Click to copy">';
    html += '<div style="font-size:16px;font-weight:bold;letter-spacing:0.5px;">' + hex.toUpperCase() + '</div>';
    html += '<div style="opacity:0.8;margin-top:2px;">RGB(' + rgb.r + ',' + rgb.g + ',' + rgb.b + ')</div>';
    html += '<div style="opacity:0.7;">HSL(' + hsl.h + '\u00B0,' + hsl.s + '%,' + hsl.l + '%)</div>';
    html += '</div>';
  });
  html += '</div>';
  document.getElementById('result').innerHTML = html;
}

function copyResult() {
  var swatches = document.getElementById('result').querySelectorAll('[onclick]');
  var hexes = [];
  swatches.forEach(function(el) { hexes.push(el.getAttribute('onclick').match(/'([^']+)'/)[1]); });
  navigator.clipboard.writeText(hexes.join('\n'));
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
