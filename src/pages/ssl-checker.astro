---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="SSL Certificate Checker"
  description="Check a domain's SSL certificate expiry date and issuer info"
  category="Dev Tools"
  keywords={["ssl checker", "ssl certificate checker", "dev tools"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const url=document.getElementById('inp').value.trim().replace(/^https?:\/\//,'');
  if(!url){o('Enter domain to check (e.g. google.com)');return;}
  o('Checking: '+url+'\n\n⚠ Browser can\'t perform SSL checks directly.\nUse: openssl s_client -connect '+url+':443 -servername '+url+'\n\nFor online check: ssllabs.com/ssltest/');
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').innerHTML='';}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
