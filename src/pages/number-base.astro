---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import StatCard from '../components/StatCard.astro';
---

<ToolLayout
  title="Number Base Converter"
  description="Convert between binary, octal, decimal and hex"
  category="Math"
  keywords={["base", "binary", "hex", "convert"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 items-end">
      <div class="flex-1">
        <label class="text-sm text-surface-300 block mb-1.5">Number</label>
        <input id="num" type="text" placeholder="Enter a number" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 font-mono w-full" oninput="convert()" />
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">From Base</label>
        <select id="fromBase" onchange="convert()" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="16">HEX (16)</option>
          <option value="10" selected>Decimal (10)</option>
          <option value="8">Octal (8)</option>
          <option value="2">Binary (2)</option>
        </select>
      </div>
    </div>
    <div id="result" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
  </div>
<script is:inline>
function convert() {
  var numStr = document.getElementById('num').value.trim();
  var fromBase = parseInt(document.getElementById('fromBase').value, 10);
  if (!numStr) {
    document.getElementById('result').innerHTML = '';
    return;
  }
  var val = parseInt(numStr, fromBase);
  if (isNaN(val)) {
    document.getElementById('result').innerHTML = '<div class="col-span-full text-sm text-surface-400">Invalid number for the selected base</div>';
    return;
  }

  var bases = [
    { label: 'Binary (2)', value: val.toString(2) },
    { label: 'Octal (8)', value: val.toString(8) },
    { label: 'Decimal (10)', value: val.toString(10) },
    { label: 'Hex (16)', value: val.toString(16).toUpperCase() }
  ];

  var html = '';
  bases.forEach(function(b) {
    var isActive = parseInt(b.label.match(/\d+/)[0], 10) === fromBase;
    html += '<div class="' + (isActive ? 'bg-brand-500/10 border-brand-500/30' : 'bg-surface-800/50 border-surface-700/30') + ' border rounded-lg p-3 text-center">';
    html += '<div class="text-xs text-surface-400">' + b.label + '</div>';
    html += '<div class="text-sm font-mono ' + (isActive ? 'text-brand-400' : 'text-surface-100') + ' mt-1 break-all">' + b.value + '</div>';
    html += '</div>';
  });
  document.getElementById('result').innerHTML = html;
}

convert();
</script><div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Number Base Converter?</h2>
  <p class="mb-3">A number base converter translates numbers between binary (base-2), octal (base-8), decimal (base-10), and hexadecimal (base-16) systems. These different bases are fundamental to computer science — binary is how computers think, and hex is how humans read computer memory.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Debugging code by checking memory addresses or color values written in hexadecimal</li>
    <li>Learning how different number systems work in computer architecture and embedded programming</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter a number in any base and see instant conversions to binary, octal, decimal, and hexadecimal.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/hex-to-text/" class="text-primary hover:underline">Hex to Text Converter</a> for converting hexadecimal values to readable text.</p>
</div>
</ToolLayout>
