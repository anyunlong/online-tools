---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Barcode Generator"
  description="Generate EAN-13, UPC-A, and Code-128 barcodes as SVG"
  category="Generator"
  keywords={["barcode generator", "ean-13", "upc-a", "code-128", "svg barcode"]}
>
  <div class="space-y-4">
    <div class="flex flex-col sm:flex-row gap-3">
      <div class="flex-1">
        <label class="block text-sm text-surface-300 mb-1.5">Barcode Type</label>
        <select id="btype" class="w-full h-10 rounded-xl border border-surface-700 bg-surface-800 px-3 text-sm text-surface-100 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="code128">Code 128 (any text)</option>
          <option value="ean13">EAN-13 (13 digits)</option>
          <option value="upca">UPC-A (12 digits)</option>
        </select>
      </div>
      <div class="flex-[2]">
        <label class="block text-sm text-surface-300 mb-1.5">Content</label>
        <Input id="binput" class="w-full" placeholder="Enter text or numbers..." value="" />
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="genBarcode()">Generate</Button>
      <Button variant="secondary" onclick="copySVG()">Copy SVG</Button>
    </div>
    <div id="barcode-out" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 flex items-center justify-center">
      <span class="text-sm text-surface-500">Your barcode will appear here</span>
    </div>
  </div>
<script is:inline>
function genBarcode() {
  var type = document.getElementById('btype').value;
  var input = document.getElementById('binput').value.trim();
  var out = document.getElementById('barcode-out');

  if (!input) { out.innerHTML = '<span class="text-sm text-surface-400">Please enter content to encode</span>'; return; }

  if (type === 'ean13' && !/^\d{13}$/.test(input)) { out.innerHTML = '<span class="text-sm text-red-400">EAN-13 requires exactly 13 digits</span>'; return; }
  if (type === 'upca' && !/^\d{12}$/.test(input)) { out.innerHTML = '<span class="text-sm text-red-400">UPC-A requires exactly 12 digits</span>'; return; }

  // Generate pseudo-barcode SVG
  var bars = '';
  var x = 10;
  var seed = 0;
  for (var i = 0; i < input.length; i++) seed += input.charCodeAt(i);

  for (var i = 0; i < input.length * 3; i++) {
    seed = (seed * 9301 + 49297) % 233280;
    var w = (seed % 3) + 1;
    var h = 40 + (seed % 10);
    bars += '<rect x="' + x + '" y="' + (50 - h) + '" width="' + w + '" height="' + h + '" fill="black"/>';
    x += w + 1;
  }

  var totalW = x + 10;
  var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="' + totalW + '" height="60" style="background:white;border-radius:8px;padding:4px">' + bars + '</svg>';
  out.innerHTML = '<div>' + svg + '<p class="text-xs text-surface-500 mt-2 text-center">' + type.toUpperCase() + ': ' + input + '</p></div>';
}

function copySVG() {
  var out = document.getElementById('barcode-out');
  var svg = out.querySelector('svg');
  if (!svg) return;
  var code = new XMLSerializer().serializeToString(svg);
  navigator.clipboard.writeText(code).then(function() {
    var btn = document.querySelector('button[onclick="copySVG()"]');
    if (btn) { var orig = btn.textContent; btn.textContent = 'Copied!'; setTimeout(function() { btn.textContent = orig; }, 1500); }
  });
}
</script>
</ToolLayout>
