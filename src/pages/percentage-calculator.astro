---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Percentage Calculator"
  description="Calculate percentages quickly"
  category="Math"
  keywords={["percentage", "calculator", "percent", "math"]}
>
  <div class="space-y-4">
    <div class="space-y-4"><div><label class="text-sm text-surface-300 block mb-1">What is <input id="p1" type="number" value="20" class="bg-surface-800 border border-surface-700 rounded px-2 py-0.5 w-16 text-sm text-surface-100" />% of <input id="n1" type="number" value="200" class="bg-surface-800 border border-surface-700 rounded px-2 py-0.5 w-20 text-sm text-surface-100" />?</label></div><div><label class="text-sm text-surface-300 block mb-1"><input id="n2" type="number" value="50" class="bg-surface-800 border border-surface-700 rounded px-2 py-0.5 w-20 text-sm text-surface-100" /> is what % of <input id="n3" type="number" value="200" class="bg-surface-800 border border-surface-700 rounded px-2 py-0.5 w-20 text-sm text-surface-100" />?</label></div><div><label class="text-sm text-surface-300 block mb-1">Increase/Decrease: from <input id="from" type="number" value="100" class="bg-surface-800 border border-surface-700 rounded px-2 py-0.5 w-20 text-sm text-surface-100" /> to <input id="to" type="number" value="150" class="bg-surface-800 border border-surface-700 rounded px-2 py-0.5 w-20 text-sm text-surface-100" /></label></div></div>
    <div class="flex gap-2">
      <Button onclick="generate()">Calculate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function generate() {
  var lines = [];

  var p1 = parseFloat(document.getElementById('p1').value);
  var n1 = parseFloat(document.getElementById('n1').value);
  if (!isNaN(p1) && !isNaN(n1)) {
    lines.push(p1 + '% of ' + n1 + ' = ' + (n1 * p1 / 100).toFixed(2));
  }

  var n2 = parseFloat(document.getElementById('n2').value);
  var n3 = parseFloat(document.getElementById('n3').value);
  if (!isNaN(n2) && !isNaN(n3) && n3 !== 0) {
    lines.push(n2 + ' is ' + ((n2 / n3) * 100).toFixed(2) + '% of ' + n3);
  }

  var from = parseFloat(document.getElementById('from').value);
  var to = parseFloat(document.getElementById('to').value);
  if (!isNaN(from) && !isNaN(to) && from !== 0) {
    var change = ((to - from) / from) * 100;
    var label = change >= 0 ? 'increase' : 'decrease';
    lines.push('From ' + from + ' to ' + to + ' = ' + Math.abs(change).toFixed(2) + '% ' + label);
  }

  if (lines.length === 0) {
    document.getElementById('result').textContent = 'Enter numbers above';
    return;
  }

  document.getElementById('result').innerHTML = lines.map(function(r) {
    return '<div class="mb-1">' + r + '</div>';
  }).join('');
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value || document.getElementById('result').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Percentage Calculator?</h2>
  <p class="mb-3">A percentage calculator handles three common percentage operations: finding a percentage of a number, determining what percent one number is of another, and calculating percentage increase or decrease. These everyday calculations are combined in one simple tool.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Calculating discounts during sales (e.g., what is 30% off $85?)</li>
    <li>Computing growth rates, tax amounts, grade percentages, or tip amounts quickly</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Choose a calculator type, enter your numbers, and get instant percentage results.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/bmi-calculator/" class="text-primary hover:underline">BMI Calculator</a> for another quick health-related calculation.</p>
</div>
</ToolLayout>
