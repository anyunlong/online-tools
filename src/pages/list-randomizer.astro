---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="List Randomizer"
  description="Randomize the order of any list"
  category="Text"
  keywords={["random", "shuffle", "list", "sort"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Paste list items, one per line..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Shuffle</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const text = document.getElementById('inp').value;
  if (!text) return;
  const lines = text.split('\n').filter(l => l.trim());
  for (let i = lines.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [lines[i], lines[j]] = [lines[j], lines[i]]; }
  document.getElementById('out').textContent = lines.join('\n');
  document.getElementById('msg').textContent = `${lines.length} items shuffled`;
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a List Randomizer?</h2>
  <p class="mb-3">A list randomizer shuffles the order of items in any list randomly — like shuffling a deck of cards. It's the digital equivalent of drawing names from a hat, perfect for when you need a fair, unbiased random order.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Running raffles, giveaways, or random prize drawings fairly without bias</li>
    <li>Randomizing team assignments, presentation orders, or playlist sequences</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your list (one item per line) and click Shuffle to randomize the order instantly.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/text-sort/" class="text-primary hover:underline">Text Line Sorter</a> for organizing lists alphabetically instead of randomly.</p>
</div>
</ToolLayout>
