---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Textarea from '../components/Textarea.astro';
---

<ToolLayout
  title="Regex Tester"
  description="Test regex patterns with match highlighting"
  category="Dev Tools"
  keywords={["regex", "regex", "match"]}
>
  <Input id="pattern" class="w-full tool-area" placeholder="Enter regex, e.g. \\d{3,}" oninput="test()" />
  <Textarea id="text" class="mt-3" placeholder="Test text..." rows="6" oninput="test()" />
  <div class="mt-3 text-sm flex items-center gap-4">
    <span id="match-count" class="text-surface-400">Matches: 0</span>
    <span id="error" class="text-red-400"></span>
  </div>
  <div id="highlight" class="mt-2 bg-surface-800/40 border border-surface-700/30 rounded-xl p-3 text-sm min-h-[40px]"></div>
<script is:inline>
function test() {
  var p = document.getElementById('pattern').value;
  var t = document.getElementById('text').value;
  document.getElementById('error').textContent = '';
  try {
    var re = new RegExp(p, 'g');
    var matches = t.match(re) || [];
    document.getElementById('match-count').textContent = 'Matches: ' + matches.length;
    document.getElementById('highlight').innerHTML = t.replace(re, function(m){return '<mark class="bg-yellow-400/20 text-yellow-200 rounded px-0.5">' + m + '</mark>';});
  } catch (e) {
    document.getElementById('error').textContent = 'Error: ' + e.message;
    document.getElementById('highlight').textContent = t;
    document.getElementById('match-count').textContent = 'Matches: 0';
  }
}
</script><div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Regex Tester?</h2>
  <p class="mb-3">A regex (regular expression) tester lets you write and test pattern-matching expressions against sample text in real time. Regular expressions are powerful search patterns used in virtually every programming language for validating, extracting, and manipulating text.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Building or debugging regex patterns for form validation (email, phone, URLs)</li>
    <li>Extracting specific data from logs, documents, or structured text files</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter your regex pattern and test text to see real-time match highlighting with capture group details.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/text-diff/" class="text-primary hover:underline">Text Diff Checker</a> for comparing two texts line by line.</p>
</div>
</ToolLayout>
