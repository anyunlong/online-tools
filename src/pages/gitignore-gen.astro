---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title=".gitignore Generator"
  description="Generate a .gitignore file for your project's language and framework"
  category="Dev Tools"
  keywords={["gitignore gen", ".gitignore generator", "dev tools"]}
>
  <div class="space-y-4">
    <div class='text-sm text-surface-400'>Configure options above</div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function generate() {
  const lang=(document.getElementById('lang')?.value||'node').toLowerCase();
  const ignores={
    node:'node_modules/\nnpm-debug.log*\n.env\n.env.*\ndist/\nbuild/\n.DS_Store\n*.log\ncoverage/\n.nyc_output/\ntmp/\n.vscode/',
    python:'__pycache__/\n*.py[cod]\n*.so\n.env\n.env.*\nvenv/\n.venv/\ndist/\nbuild/\n*.egg-info/\n.pytest_cache/\n.DS_Store\n*.log',
    java:'target/\n*.class\n*.jar\n*.war\n.gradle/\nbuild/\n.idea/\n*.iml\n.classpath\n.project\n.settings/\nbin/\n.DS_Store',
    go:'*.exe\n*.exe~\n*.dll\n*.so\n*.dylib\n*.test\n*.out\nvendor/\n.env\n.env.*\n.DS_Store'
  };
  document.getElementById('result').value=ignores[lang]||ignores.node;
}
function copyResult() {
  const el=document.getElementById('result');
  if(!el||!el.value) return;
  el.select();document.execCommand('copy');
  document.getElementById('msg').textContent='Copied!';
  setTimeout(()=>document.getElementById('msg').textContent='',2000);
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
