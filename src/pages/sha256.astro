---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
---

<ToolLayout
  title="SHA256 Hash"
  description="Calculate SHA256 hash values online"
  category="Hash"
  keywords={["sha256", "hash", "hash"]}
>
  <Textarea id="inp" placeholder="Enter text" rows="8" oninput="process()" class="tool-area" />
  <div class="mt-4 bg-surface-800/40 border border-surface-700/30 rounded-xl p-4">
    <div class="text-xs text-surface-400 mb-1.5">SHA256</div>
    <div id="result" class="text-sm font-mono text-brand-400 break-all select-all">—</div>
  </div>
<script is:inline>
async function process() {
  const t=document.getElementById('inp').value;
  if(!t){o('Enter text to hash');return;}
  const e=new TextEncoder().encode(t);
  const h=await crypto.subtle.digest('SHA-256',e);
  o('SHA-256: '+Array.from(new Uint8Array(h)).map(b=>b.toString(16).padStart(2,'0')).join(''));
}
function o(t){document.getElementById('result').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('result').textContent='';}
</script><div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is SHA256 Hashing?</h2>
  <p class="mb-3">SHA256 (Secure Hash Algorithm 256-bit) generates a 64-character hexadecimal hash that uniquely represents any input data. It's a one-way cryptographic function — you can't reverse a hash back to the original input — making it ideal for secure password storage and data integrity verification.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Verifying that downloaded files haven't been tampered with or corrupted</li>
    <li>Generating digital signatures and verifying blockchain transaction integrity</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter text or upload a file to generate a 64-character SHA256 hash in your browser.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/md5/" class="text-primary hover:underline">MD5 Hash Generator</a> for a faster but less secure hashing alternative.</p>
</div>
</ToolLayout>
