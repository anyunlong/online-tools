---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="MAC Address Generator"
  description="Generate random MAC addresses for network device testing"
  category="Generator"
  keywords={["mac address gen", "mac address generator", "generator"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Format</label>
        <select id="format" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value=":">Colon (AA:BB:CC:DD:EE:FF)</option>
          <option value="-">Hyphen (AA-BB-CC-DD-EE-FF)</option>
          <option value=".">Dot (AABB.CCDD.EEFF)</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Count</label>
        <select id="count" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="1">1</option><option value="3" selected>3</option><option value="5">5</option><option value="10">10</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
function randByte() {
  var buf = new Uint8Array(1);
  crypto.getRandomValues(buf);
  return buf[0];
}

function generateMac(format) {
  var bytes = [];
  for (var i = 0; i < 6; i++) {
    var b = randByte();
    if (i === 0) b = (b & 0xfe) | 0x02; // Locally administered, unicast
    bytes.push(b.toString(16).padStart(2, '0').toUpperCase());
  }
  if (format === '.') {
    return bytes[0] + bytes[1] + bytes[2] + '.' + bytes[3] + bytes[4] + '.' + bytes[5];
  }
  return bytes.join(format);
}

function generate() {
  var format = document.getElementById('format').value;
  var count = parseInt(document.getElementById('count').value, 10);
  var macs = [];
  for (var i = 0; i < count; i++) {
    macs.push(generateMac(format));
  }
  document.getElementById('result').textContent = macs.join('\n');
}

function copyResult() {
  var text = document.getElementById('result').textContent;
  navigator.clipboard.writeText(text);
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
