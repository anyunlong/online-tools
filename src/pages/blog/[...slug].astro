---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: '4uses' },
};
---

<BaseLayout
  title={`${post.data.title} | 4uses Blog`}
  description={post.data.description}
  schema={blogSchema}
>
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 w-full">
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <a href="/" class="text-xs text-surface-500 hover:text-brand-400 no-underline transition-colors">Home</a>
        <span class="text-surface-600">/</span>
        <a href="/blog" class="text-xs text-surface-500 hover:text-brand-400 no-underline transition-colors" data-i18n="ui.blog">Blog</a>
        <span class="text-surface-600">/</span>
        <span class="text-xs text-surface-400">{post.data.title}</span>
      </div>
      <h1 class="text-3xl font-bold text-white mb-3 leading-tight">{post.data.title}</h1>
      <div class="flex items-center gap-4 text-sm text-surface-400">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {
          post.data.tags.length > 0 && (
            <div class="flex gap-1.5">
              {post.data.tags.map((tag: string) => (
                <span class="text-xs bg-surface-800 text-surface-400 px-2 py-0.5 rounded-full">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>
    <article class="prose prose-invert prose-surface max-w-none
      prose-headings:text-white prose-headings:font-semibold
      prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-surface-300 prose-p:leading-relaxed prose-p:mb-4
      prose-a:text-brand-400 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-surface-200 prose-strong:font-semibold
      prose-code:text-brand-400 prose-code:bg-surface-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-sm
      prose-pre:bg-surface-800 prose-pre:border prose-pre:border-surface-700
      prose-li:text-surface-300 prose-li:leading-relaxed
      prose-th:text-surface-300 prose-td:text-surface-300
      prose-table:border-surface-700
      prose-blockquote:border-brand-500 prose-blockquote:text-surface-400
      [&_table]:border-collapse [&_table]:w-full [&_th]:border [&_th]:border-surface-700 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_td]:border [&_td]:border-surface-700 [&_td]:px-3 [&_td]:py-2
    ">
      <Content />
    </article>
    <div class="mt-12 pt-8 border-t border-surface-800/50">
      <a href="/blog" class="text-sm text-brand-400 hover:underline no-underline">&larr; Back to Blog</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
