---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Case Converter"
  description="Convert text case: UPPER, lower, Title, camelCase"
  category="Text"
  keywords={["case", "convert", "english"]}
>
  <Textarea id="inp" placeholder="Enter English text" rows="8" />
  <div class="flex flex-wrap gap-2 mt-3">
    <Button variant="secondary" size="sm" onclick="apply('upper')">UPPERCASE</Button>
    <Button variant="secondary" size="sm" onclick="apply('lower')">lowercase</Button>
    <Button variant="secondary" size="sm" onclick="apply('title')">Title Case</Button>
    <Button variant="secondary" size="sm" onclick="apply('camel')">camelCase</Button>
  </div>
  <div
    id="result"
    class="mt-3 bg-surface-800/40 border border-surface-700/30 rounded-xl p-4 text-sm tool-area min-h-[48px]"
  ></div>
<script is:inline>
function process() {
  const t=document.getElementById('inp').value;
  o('UPPER: '+t.toUpperCase()+'\nlower: '+t.toLowerCase()+'\nTitle: '+t.replace(/\b\w/g,c=>c.toUpperCase())+'\ncamelCase: '+t.toLowerCase().replace(/[^a-z0-9]+(.)/g,(_,c)=>c.toUpperCase()));
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';document.getElementById('msg').textContent='';}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Case Converter?</h2>
  <p class="mb-3">A case converter transforms text between different capitalization styles — including UPPERCASE, lowercase, Title Case, camelCase, snake_case, and more. Each style serves a different purpose in writing, programming, and design.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Naming variables and functions consistently in code (camelCase for JS, snake_case for Python)</li>
    <li>Formatting headlines, titles, and document headings to match style guides</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your text and choose a transformation style from the available options to instantly convert.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/text-sort/" class="text-primary hover:underline">Text Line Sorter</a> for alphabetizing and organizing text lines.</p>
</div>
</ToolLayout>
