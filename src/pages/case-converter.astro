---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Case Converter"
  description="Convert text case: UPPER, lower, Title, camelCase"
  category="Text"
  keywords={["case", "convert", "english"]}
>
  <textarea id="inp" placeholder="Enter text here..." rows="8" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 font-mono w-full resize-y"></textarea>
  <div class="flex flex-wrap gap-2 mt-3">
    <button onclick="apply('upper')" class="px-3 py-1.5 rounded-lg bg-surface-800 text-surface-300 text-xs border border-surface-600 hover:border-brand-500 hover:text-brand-400">UPPERCASE</button>
    <button onclick="apply('lower')" class="px-3 py-1.5 rounded-lg bg-surface-800 text-surface-300 text-xs border border-surface-600 hover:border-brand-500 hover:text-brand-400">lowercase</button>
    <button onclick="apply('title')" class="px-3 py-1.5 rounded-lg bg-surface-800 text-surface-300 text-xs border border-surface-600 hover:border-brand-500 hover:text-brand-400">Title Case</button>
    <button onclick="apply('camel')" class="px-3 py-1.5 rounded-lg bg-surface-800 text-surface-300 text-xs border border-surface-600 hover:border-brand-500 hover:text-brand-400">camelCase</button>
    <button onclick="apply('snake')" class="px-3 py-1.5 rounded-lg bg-surface-800 text-surface-300 text-xs border border-surface-600 hover:border-brand-500 hover:text-brand-400">snake_case</button>
    <button onclick="apply('kebab')" class="px-3 py-1.5 rounded-lg bg-surface-800 text-surface-300 text-xs border border-surface-600 hover:border-brand-500 hover:text-brand-400">kebab-case</button>
  </div>
  <div class="flex gap-2 mt-2">
    <Button variant="secondary" size="sm" onclick="copyResult()">Copy</Button>
  </div>
  <textarea id="result" readonly class="mt-3 bg-surface-800/40 border border-surface-600 rounded-xl p-4 text-sm text-surface-100 font-mono min-h-[120px] w-full resize-y"></textarea>
<script is:inline>
function toTitleCase(str) {
  return str.replace(/\b\w/g, function(c) { return c.toUpperCase(); });
}

function toCamelCase(str) {
  return str.toLowerCase().replace(/[^a-z0-9]+(.)/g, function(_, c) { return c.toUpperCase(); });
}

function toSnakeCase(str) {
  return str.trim().replace(/[^\w]+/g, '_').replace(/([a-z])([A-Z])/g, '$1_$2').toLowerCase();
}

function toKebabCase(str) {
  return str.trim().replace(/[^\w]+/g, '-').replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
}

function apply(type) {
  var input = document.getElementById('inp').value;
  if (!input.trim()) {
    document.getElementById('result').value = 'Enter text above and choose a case style.';
    return;
  }
  var result;
  switch (type) {
    case 'upper': result = input.toUpperCase(); break;
    case 'lower': result = input.toLowerCase(); break;
    case 'title': result = toTitleCase(input); break;
    case 'camel': result = toCamelCase(input); break;
    case 'snake': result = toSnakeCase(input); break;
    case 'kebab': result = toKebabCase(input); break;
    default: result = input;
  }
  document.getElementById('result').value = result;
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value || document.getElementById('result').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Case Converter?</h2>
  <p class="mb-3">A case converter transforms text between different capitalization styles — including UPPERCASE, lowercase, Title Case, camelCase, snake_case, and more. Each style serves a different purpose in writing, programming, and design.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Naming variables and functions consistently in code (camelCase for JS, snake_case for Python)</li>
    <li>Formatting headlines, titles, and document headings to match style guides</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste your text and choose a transformation style from the available options to instantly convert.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/text-sort/" class="text-primary hover:underline">Text Line Sorter</a> for alphabetizing and organizing text lines.</p>
</div>
</ToolLayout>
