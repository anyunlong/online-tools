---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
---

<ToolLayout
  title="Port Reference"
  description="Common TCP/UDP network port numbers reference"
  category="Network"
  keywords={["port", "tcp", "udp", "network"]}
>
  <Input id="search" placeholder="Search by port number, service, or protocol..." class="w-full mb-4" oninput="filter()" />
  <div class="overflow-x-auto max-h-[500px] overflow-y-auto">
    <table class="w-full text-xs text-surface-300">
      <thead><tr class="text-surface-400 border-b border-surface-700 sticky top-0 bg-surface-900">
        <th class="text-left py-2 px-2">Port</th><th class="text-left py-2 px-2">Protocol</th><th class="text-left py-2 px-2">Service</th><th class="text-left py-2 px-2">Description</th>
      </tr></thead>
      <tbody id="table-body"></tbody>
    </table>
  </div>
<script is:inline>
var ports = [
  [20,'TCP','FTP Data','File Transfer Protocol data transfer'],
  [21,'TCP','FTP Control','File Transfer Protocol control'],
  [22,'TCP','SSH','Secure Shell remote login'],
  [23,'TCP','Telnet','Unencrypted remote terminal'],
  [25,'TCP','SMTP','Simple Mail Transfer Protocol (email sending)'],
  [53,'TCP/UDP','DNS','Domain Name System resolution'],
  [67,'UDP','DHCP Server','Dynamic Host Configuration Protocol'],
  [68,'UDP','DHCP Client','DHCP client port'],
  [80,'TCP','HTTP','Hypertext Transfer Protocol (web)'],
  [110,'TCP','POP3','Post Office Protocol v3 (email retrieval)'],
  [123,'UDP','NTP','Network Time Protocol'],
  [143,'TCP','IMAP','Internet Message Access Protocol (email)'],
  [161,'UDP','SNMP','Simple Network Management Protocol'],
  [194,'TCP','IRC','Internet Relay Chat'],
  [389,'TCP','LDAP','Lightweight Directory Access Protocol'],
  [443,'TCP','HTTPS','HTTP over TLS/SSL (secure web)'],
  [465,'TCP','SMTPS','SMTP over SSL (email sending)'],
  [514,'UDP','Syslog','System logging protocol'],
  [587,'TCP','SMTP','SMTP submission (email)'],
  [636,'TCP','LDAPS','LDAP over SSL'],
  [873,'TCP','rsync','File synchronization protocol'],
  [993,'TCP','IMAPS','IMAP over SSL (secure email)'],
  [995,'TCP','POP3S','POP3 over SSL (secure email)'],
  [1080,'TCP','SOCKS','SOCKS proxy protocol'],
  [1433,'TCP','MSSQL','Microsoft SQL Server database'],
  [1521,'TCP','Oracle','Oracle database listener'],
  [1723,'TCP','PPTP','Point-to-Point Tunneling Protocol'],
  [2049,'TCP/UDP','NFS','Network File System'],
  [2181,'TCP','ZooKeeper','Apache ZooKeeper coordination'],
  [2375,'TCP','Docker','Docker REST API (unencrypted)'],
  [3306,'TCP','MySQL','MySQL database server'],
  [3389,'TCP','RDP','Remote Desktop Protocol'],
  [3478,'TCP/UDP','STUN','Session Traversal Utilities for NAT'],
  [4000,'TCP','Django','Django development server'],
  [4200,'TCP','Angular','Angular development server'],
  [5000,'TCP','Flask','Flask development server / UPnP'],
  [5173,'TCP','Vite','Vite development server'],
  [5432,'TCP','PostgreSQL','PostgreSQL database server'],
  [5672,'TCP','RabbitMQ','AMQP message broker'],
  [5900,'TCP','VNC','Virtual Network Computing'],
  [6379,'TCP','Redis','Redis key-value store'],
  [6443,'TCP','K8s API','Kubernetes API server'],
  [8080,'TCP','HTTP Alt','Alternative HTTP / proxy port'],
  [8443,'TCP','HTTPS Alt','Alternative HTTPS port'],
  [9090,'TCP','Prometheus','Prometheus monitoring'],
  [9092,'TCP','Kafka','Apache Kafka message broker'],
  [9200,'TCP','Elasticsearch','Elasticsearch REST API'],
  [11211,'TCP','Memcached','Memcached cache server'],
  [27017,'TCP','MongoDB','MongoDB database server'],
  [50000,'TCP','Jenkins','Jenkins CI/CD server'],
];
function render(data) {
  var html = '';
  for (var i = 0; i < data.length; i++) {
    html += '<tr class="border-b border-surface-800 hover:bg-surface-800/30"><td class="py-1.5 px-2 font-mono text-brand-400">' + data[i][0] + '</td><td class="py-1.5 px-2">' + data[i][1] + '</td><td class="py-1.5 px-2 font-mono">' + data[i][2] + '</td><td class="py-1.5 px-2">' + data[i][3] + '</td></tr>';
  }
  document.getElementById('table-body').innerHTML = html;
}
function filter() {
  var q = document.getElementById('search').value.toLowerCase();
  render(ports.filter(function(r) { return String(r[0]).includes(q) || r[2].toLowerCase().includes(q) || r[3].toLowerCase().includes(q); }));
}
render(ports);
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Port Reference?</h2>
  <p class="mb-3">A port reference lists the standard TCP and UDP port numbers used by common network services — from web servers (80, 443) to databases (5432, 3306) to development servers (3000, 5173). Ports are like apartment numbers for network services on a single IP address.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Identifying which service is running on a specific port during network troubleshooting</li>
    <li>Configuring firewalls, security groups, or port forwarding rules</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Browse the complete reference or search by port number, service name, or description.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/dns-lookup/" class="text-primary hover:underline">DNS Lookup</a> for resolving domain names to IP addresses before checking ports.</p>
</div>
</ToolLayout>
