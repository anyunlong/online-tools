---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Pomodoro Timer"
  description="Focus timer using the Pomodoro technique"
  category="Time"
  keywords={["pomodoro", "timer", "focus", "productivity"]}
>
  <div class="space-y-4">
    
    <div class="flex gap-2">
      <Button onclick="generate()"></Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
let pomRunning = false, pomSeconds = 25 * 60, pomTotal, pomInterval, pomSessions = 0, pomIsBreak = false;
function generate() {
  if (!pomRunning) { startPom(); } else { pausePom(); }
}
function startPom() {
  pomRunning = true; pomTotal = pomSeconds;
  document.querySelector('[onclick="generate()"]').textContent = 'Pause';
  pomInterval = setInterval(() => {
    pomSeconds--;
    updatePomDisplay();
    if (pomSeconds <= 0) {
      clearInterval(pomInterval); pomRunning = false;
      if (!pomIsBreak) { pomSessions++; pomIsBreak = true; pomSeconds = pomSessions % 4 === 0 ? 15 * 60 : 5 * 60; }
      else { pomIsBreak = false; pomSeconds = 25 * 60; }
      document.querySelector('[onclick="generate()"]').textContent = 'Start';
      updatePomDisplay();
      const el = document.getElementById('result');
      el.textContent = pomIsBreak ? 'Time for a break!' : 'Break over! Ready to work?';
    }
  }, 1000);
}
function pausePom() { clearInterval(pomInterval); pomRunning = false; document.querySelector('[onclick="generate()"]').textContent = 'Resume'; }
function resetPom() { clearInterval(pomInterval); pomRunning = false; pomIsBreak = false; pomSeconds = 25 * 60; pomSessions = 0; document.querySelector('[onclick="generate()"]').textContent = 'Start'; updatePomDisplay(); document.getElementById('result').textContent = ''; }
function updatePomDisplay() {
  const m = Math.floor(pomSeconds / 60); const s = pomSeconds % 60;
  const pct = pomTotal ? (pomSeconds / pomTotal * 100) : 0;
  document.getElementById('result').innerHTML = `<div class='text-5xl font-mono font-bold text-center text-brand-400'>${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}</div><div class='text-center text-xs text-surface-500 mt-2'>${pomIsBreak ? 'Break' : 'Focus'} · Session ${pomSessions + 1}</div><div class='mt-3 flex justify-center gap-2'><button onclick='resetPom()' class='px-3 py-1 text-xs rounded-lg bg-surface-700 text-surface-300 hover:bg-surface-600'>Reset</button></div>`;
}
updatePomDisplay();

function copyResult() {
  const text = document.getElementById('result').textContent;
  if (!text) return;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.querySelector('[onclick="copyResult()"]');
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy', 2000);
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Pomodoro Timer?</h2>
  <p class="mb-3">A Pomodoro timer implements the Pomodoro Technique — a time management method where you work in focused 25-minute intervals followed by short breaks. Developed by Francesco Cirillo in the late 1980s, this technique helps maintain deep focus while preventing mental fatigue.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Staying focused during study sessions or deep work that requires sustained concentration</li>
    <li>Managing ADHD or procrastination by breaking intimidating tasks into short, timed segments</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Click Start to begin a 25-minute focus session. After each session, take a 5-minute break. After 4 sessions, take a longer 15-minute break.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/stopwatch/" class="text-primary hover:underline">Online Stopwatch</a> for general-purpose time measurement without structured intervals.</p>
</div>
</ToolLayout>
