---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="package.json Generator"
  description="Generate a complete package.json file for your Node.js project"
  category="Dev Tools"
  keywords={["npm package json", "package.json generator", "dev tools"]}
>
  <div class="space-y-4">
    <div class='text-sm text-surface-400'>Configure options above</div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function generate() {
  const name=document.getElementById('name')?.value||'my-project';
  const pkg={name:name,version:'1.0.0',description:'A new project',main:'index.js',scripts:{start:'node index.js',test:'echo "Error: no test specified" && exit 1'},keywords:[],author:'',license:'MIT'};
  document.getElementById('result').value=JSON.stringify(pkg,null,2);
}
function copyResult() {
  const el=document.getElementById('result');
  if(!el||!el.value) return;
  el.select();document.execCommand('copy');
  document.getElementById('msg').textContent='Copied!';
  setTimeout(()=>document.getElementById('msg').textContent='',2000);
}
</script>
<slot name="info" slot="info">
  <p>Enter your input and click to process. Results appear instantly.</p>
</slot>
</ToolLayout>
