---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="package.json Generator"
  description="Generate a complete package.json file for your Node.js project"
  category="Dev Tools"
  keywords={["npm package json", "package.json generator", "dev tools"]}
>
  <div class="space-y-4">
    <div class="space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="text-sm text-surface-300 block mb-1">Package Name</label>
          <input id="name" type="text" placeholder="my-project" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full" />
        </div>
        <div>
          <label class="text-sm text-surface-300 block mb-1">Version</label>
          <input id="version" type="text" value="1.0.0" placeholder="1.0.0" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full" />
        </div>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1">Description</label>
        <input id="description" type="text" placeholder="A new project" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="text-sm text-surface-300 block mb-1">Entry File</label>
          <input id="main" type="text" value="index.js" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full" />
        </div>
        <div>
          <label class="text-sm text-surface-300 block mb-1">Author</label>
          <input id="author" type="text" placeholder="Your Name" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full" />
        </div>
        <div>
          <label class="text-sm text-surface-300 block mb-1">License</label>
          <select id="license" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
            <option value="MIT" selected>MIT</option>
            <option value="ISC">ISC</option>
            <option value="Apache-2.0">Apache-2.0</option>
            <option value="GPL-3.0">GPL-3.0</option>
            <option value="BSD-2-Clause">BSD-2-Clause</option>
            <option value="UNLICENSED">UNLICENSED</option>
          </select>
        </div>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1">Dependencies (one per line, format: name@version)</label>
        <textarea id="deps" rows="4" placeholder="express@^4.18.0&#10;lodash@^4.17.21" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full font-mono resize-y"></textarea>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1">Dev Dependencies</label>
        <textarea id="devDeps" rows="3" placeholder="typescript@^5.0.0&#10;jest@^29.0.0" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 w-full font-mono resize-y"></textarea>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <textarea id="result" readonly class="w-full min-h-[300px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all resize-y"></textarea>
  </div>
<script is:inline>
function parseDeps(text) {
  if (!text.trim()) return {};
  var obj = {};
  text.trim().split('\n').forEach(function(line) {
    var parts = line.trim().split(/@(?=[^@]*$)/);
    if (parts.length >= 2 && parts[0]) {
      obj[parts[0].trim()] = parts[1].trim();
    }
  });
  return obj;
}

function generate() {
  var pkg = {
    name: document.getElementById('name').value.trim() || 'my-project',
    version: document.getElementById('version').value.trim() || '1.0.0',
    description: document.getElementById('description').value.trim() || '',
    main: document.getElementById('main').value.trim() || 'index.js',
    scripts: {
      start: 'node ' + (document.getElementById('main').value.trim() || 'index.js'),
      test: 'echo "Error: no test specified" && exit 1'
    },
    keywords: [],
    author: document.getElementById('author').value.trim() || '',
    license: document.getElementById('license').value
  };
  var deps = parseDeps(document.getElementById('deps').value);
  var devDeps = parseDeps(document.getElementById('devDeps').value);
  if (Object.keys(deps).length) pkg.dependencies = deps;
  if (Object.keys(devDeps).length) pkg.devDependencies = devDeps;

  document.getElementById('result').value = JSON.stringify(pkg, null, 2);
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value || document.getElementById('result').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
