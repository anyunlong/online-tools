---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Test Credit Card Generator"
  description="Generate valid-format test credit card numbers (no real money)"
  category="Generator"
  keywords={["credit card gen", "test credit card generator", "generator"]}
>
  <div class="space-y-4">
    <div class="flex gap-4 flex-wrap">
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Card Type</label>
        <select id="type" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="visa">Visa</option>
          <option value="mastercard">Mastercard</option>
          <option value="amex">American Express</option>
          <option value="discover">Discover</option>
        </select>
      </div>
      <div>
        <label class="text-sm text-surface-300 block mb-1.5">Count</label>
        <select id="count" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100">
          <option value="1" selected>1</option><option value="3">3</option><option value="5">5</option><option value="10">10</option>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="generate()">Generate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all"></div>
  </div>
<script is:inline>
var prefixes = {
  visa: '4',
  mastercard: ['51','52','53','54','55'],
  amex: ['34','37'],
  discover: '6011'
};

function randInt(max) {
  var buf = new Uint32Array(1);
  crypto.getRandomValues(buf);
  return buf[0] % max;
}

function luhnChecksum(digits) {
  var sum = 0;
  var alt = 0;
  for (var i = digits.length - 1; i >= 0; i--) {
    var d = parseInt(digits[i], 10);
    if (alt % 2 === 0) {
      d *= 2;
      if (d > 9) d -= 9;
    }
    sum += d;
    alt++;
  }
  return (10 - (sum % 10)) % 10;
}

function generateCard(type) {
  var prefix = prefixes[type];
  if (Array.isArray(prefix)) prefix = prefix[randInt(prefix.length)];
  var len = type === 'amex' ? 15 : 16;
  var num = prefix;
  while (num.length < len - 1) {
    num += String(randInt(10));
  }
  var check = luhnChecksum(num);
  var full = num + check;
  return full.replace(/(\d{4})(\d{4})(\d{4})(\d{0,4})/, '$1 $2 $3 $4').trim();
}

function generate() {
  var type = document.getElementById('type').value;
  var count = parseInt(document.getElementById('count').value, 10);
  var cards = [];
  for (var i = 0; i < count; i++) {
    cards.push(generateCard(type));
  }
  document.getElementById('result').textContent = cards.join('\n') + '\n\nThese are TEST numbers only \u2014 not valid for real purchases.';
}

function copyResult() {
  navigator.clipboard.writeText(document.getElementById('result').value || document.getElementById('result').textContent);
  var btn = document.querySelector('[onclick="copyResult()"]');
  if (btn) {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }
}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
