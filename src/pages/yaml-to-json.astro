---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="YAML to JSON Converter"
  description="Convert YAML data to JSON format"
  category="Dev Tools"
  keywords={["yaml", "json", "convert"]}
>
  <Textarea id="inp" placeholder="Paste YAML here..." rows="12" class="tool-area" />
  <div class="flex gap-2 mt-4">
    <Button onclick="convert()">Convert to JSON</Button>
    <Button variant="secondary" onclick="copyOut()">Copy</Button>
  </div>
  <div class="text-xs text-surface-400 mt-3 mb-1">JSON Output:</div>
  <div id="out" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 font-mono overflow-auto min-h-[200px] max-h-[500px] whitespace-pre"></div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function yamlToJson(yaml) {
  var lines = yaml.split('\n');
  var result = {};
  var stack = [{ obj: result, indent: -1 }];
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    if (!line.trim() || line.trim().startsWith('#')) continue;
    var indent = line.search(/\S/);
    var content = line.trim();
    var colonIdx = content.indexOf(':');
    if (colonIdx === -1) continue;
    var key = content.substring(0, colonIdx).trim();
    var value = content.substring(colonIdx + 1).trim();
    while (stack.length > 1 && stack[stack.length-1].indent >= indent) stack.pop();
    var parent = stack[stack.length-1].obj;
    if (value === '' || value === '|') {
      var newObj = {};
      parent[key] = newObj;
      stack.push({ obj: newObj, indent: indent });
    } else if (value === '[]') {
      parent[key] = [];
    } else if (value.startsWith('[') && value.endsWith(']')) {
      parent[key] = value.slice(1,-1).split(',').map(function(s) { var v = s.trim(); return isNaN(v) ? v.replace(/^['"]|['"]$/g,'') : parseFloat(v); });
    } else if (value === 'true') parent[key] = true;
    else if (value === 'false') parent[key] = false;
    else if (value === 'null' || value === '~') parent[key] = null;
    else if (!isNaN(value) && value !== '') parent[key] = parseFloat(value);
    else parent[key] = value.replace(/^['"]|['"]$/g, '');
  }
  return result;
}
function convert() {
  try {
    var yaml = document.getElementById('inp').value;
    var json = yamlToJson(yaml);
    document.getElementById('out').textContent = JSON.stringify(json, null, 2);
    document.getElementById('msg').textContent = 'Conversion successful';
    document.getElementById('msg').className = 'text-xs mt-2 text-brand-400';
  } catch(e) {
    document.getElementById('msg').textContent = 'Error: ' + e.message;
    document.getElementById('msg').className = 'text-xs mt-2 text-red-400';
  }
}
function copyOut() {
  var t = document.getElementById('out').textContent;
  if (!t) return;
  navigator.clipboard.writeText(t).then(function() {
    var btn = document.querySelector('[onclick="copyOut()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a YAML to JSON Converter?</h2>
  <p class="mb-3">A YAML to JSON converter transforms human-readable YAML configuration files into machine-friendly JSON format. YAML is popular for Docker Compose, Kubernetes manifests, and CI/CD pipelines — this tool bridges YAML to the JSON that APIs and JavaScript applications expect.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Converting Docker Compose, Kubernetes, or Ansible YAML configs to JSON for programmatic processing</li>
    <li>Migrating YAML-based configuration to JSON-based systems</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste YAML and click Convert to JSON. Supports nested objects, arrays, booleans, and numbers.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-formatter/" class="text-primary hover:underline">JSON Formatter</a> for beautifying the converted JSON output.</p>
</div>
</ToolLayout>
