---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Text Diff Checker"
  description="Compare two texts and find differences"
  category="Text"
  keywords={["diff", "compare", "text", "difference checker"]}
>
  <div class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="text1" class="block text-sm text-surface-200 mb-1.5 font-medium">Original Text</label>
        <textarea
          id="text1"
          rows="12"
          placeholder="Paste original text here..."
          class="w-full rounded-xl border border-surface-600 bg-surface-800 p-3 text-sm text-surface-100 font-mono placeholder:text-surface-500 focus:border-brand-500 focus:ring-1 focus:ring-brand-500/30 focus:outline-none transition-all resize-y"
        ></textarea>
      </div>
      <div>
        <label for="text2" class="block text-sm text-surface-200 mb-1.5 font-medium">Modified Text</label>
        <textarea
          id="text2"
          rows="12"
          placeholder="Paste modified text here..."
          class="w-full rounded-xl border border-surface-600 bg-surface-800 p-3 text-sm text-surface-100 font-mono placeholder:text-surface-500 focus:border-brand-500 focus:ring-1 focus:ring-brand-500/30 focus:outline-none transition-all resize-y"
        ></textarea>
      </div>
    </div>
    <div class="flex gap-2">
      <Button onclick="compareTexts()">Compare</Button>
      <Button variant="secondary" onclick="clearAll()">Clear</Button>
    </div>
    <div>
      <label class="block text-sm text-surface-200 mb-1.5 font-medium">Differences</label>
      <div
        id="diff-out"
        class="w-full min-h-[200px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm font-mono whitespace-pre-wrap break-all"
      ></div>
    </div>
  </div>
<script is:inline>
function compareTexts() {
  var t1 = document.getElementById('text1').value;
  var t2 = document.getElementById('text2').value;
  var out = document.getElementById('diff-out');
  
  if (!t1.trim() && !t2.trim()) {
    out.innerHTML = '<span class="text-surface-500">Enter text in both panels to compare</span>';
    return;
  }
  
  var lines1 = t1.split('\n');
  var lines2 = t2.split('\n');
  var maxLen = Math.max(lines1.length, lines2.length);
  var html = '';
  var hasDiff = false;
  
  for (var i = 0; i < maxLen; i++) {
    var l1 = lines1[i] || '';
    var l2 = lines2[i] || '';
    
    if (l1 === l2) {
      html += '<div class="text-surface-400">  ' + escapeHtml(l1) + '</div>';
    } else {
      hasDiff = true;
      if (l1) html += '<div class="text-red-400 bg-red-900/20 px-1 -mx-1">- ' + escapeHtml(l1) + '</div>';
      if (l2) html += '<div class="text-green-400 bg-green-900/20 px-1 -mx-1">+ ' + escapeHtml(l2) + '</div>';
    }
  }
  
  if (!hasDiff) {
    out.innerHTML = '<div class="text-green-400">✅ Texts are identical</div>';
  } else {
    out.innerHTML = html;
  }
}

function escapeHtml(text) {
  var div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function clearAll() {
  document.getElementById('text1').value = '';
  document.getElementById('text2').value = '';
  document.getElementById('diff-out').innerHTML = '';
}
</script>
</ToolLayout>
