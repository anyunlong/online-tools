---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Text Diff Checker"
  description="Compare two texts and find differences"
  category="Text"
  keywords={["diff", "compare", "text"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Paste original text here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Compare</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const text1 = document.getElementById('inp').value;
  const text2 = document.getElementById('inp2') ? document.getElementById('inp2').value : '';
  if (!text1 && !text2) return;
  const lines1 = text1.split('\n');
  const lines2 = text2.split('\n');
  const maxLen = Math.max(lines1.length, lines2.length);
  let html = '';
  for (let i = 0; i < maxLen; i++) {
    const l1 = lines1[i] || '';
    const l2 = lines2[i] || '';
    if (l1 === l2) {
      html += `<div class="text-surface-300">${esc(l1)}</div>`;
    } else {
      if (l1) html += `<div class="bg-red-900/30 text-red-300">- ${esc(l1)}</div>`;
      if (l2) html += `<div class="bg-green-900/30 text-green-300">+ ${esc(l2)}</div>`;
    }
  }
  document.getElementById('out').innerHTML = html;
  document.getElementById('msg').textContent = `Found ${lines1.length} vs ${lines2.length} lines`;
}
function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Text Diff Checker?</h2>
  <p class="mb-3">A text diff checker compares two blocks of text side by side and highlights every difference — additions, deletions, and modifications. It's the same concept as the `git diff` command developers use daily, but in an easy web interface anyone can use.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Comparing different versions of a document, contract, or article to spot changes</li>
    <li>Reviewing code changes or configuration file updates before deploying</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste original and modified text into the two panels, then click Compare to highlight the differences.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/regex/" class="text-primary hover:underline">Regex Tester</a> for finding patterns within a single block of text.</p>
</div>
</ToolLayout>
