---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="URL Parser"
  description="Parse and decode URL components"
  category="Dev Tools"
  keywords={["url", "parse", "query", "parameters"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="https://example.com/path?key=value&foo=bar#section" rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Parse URL</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const url = document.getElementById('inp').value.trim();
  if (!url) return;
  try {
    const u = new URL(url);
    let out = `Protocol:   ${u.protocol}\n`;
    out += `Hostname:   ${u.hostname}\n`;
    out += `Port:       ${u.port || '(default)'}\n`;
    out += `Pathname:   ${u.pathname}\n`;
    out += `Search:     ${u.search || '(none)'}\n`;
    out += `Hash:       ${u.hash || '(none)'}\n`;
    out += `Origin:     ${u.origin}\n\n`;
    out += `=== Query Parameters ===\n`;
    const params = u.searchParams;
    if ([...params].length === 0) out += '(none)\n';
    for (const [k, v] of params) out += `  ${k} = ${v}\n`;
    document.getElementById('out').textContent = out;
    document.getElementById('msg').textContent = 'URL parsed successfully';
  } catch(e) {
    document.getElementById('msg').textContent = 'Invalid URL: ' + e.message;
  }
}

function clearAll() {
  document.getElementById('inp').value = '';
  document.getElementById('out').innerHTML = '';
  document.getElementById('msg').textContent = '';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a URL Parser?</h2>
  <p class="mb-3">A URL parser breaks down any web address into its individual components — protocol, hostname, port, path, query string, and fragment. Each query parameter is extracted and displayed in a clean table, making complex URLs easy to understand.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Debugging API endpoints by examining the full URL structure and query parameters</li>
    <li>Understanding tracking parameters, UTM codes, and redirects in marketing URLs</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste any URL to see its components broken down into protocol, hostname, path, and query parameters.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/url-encode/" class="text-primary hover:underline">URL Encoder</a> for encoding special characters within URL components.</p>
</div>
</ToolLayout>
