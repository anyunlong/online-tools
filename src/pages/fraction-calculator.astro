---
import ToolLayout from '../components/ToolLayout.astro';
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Fraction Calculator"
  description="Add, subtract, multiply, and divide fractions"
  category="Math"
  keywords={["fraction", "calculator", "math"]}
>
  <div class="space-y-3">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="text-sm text-surface-300 mb-1.5 block">Fraction 1</label>
        <div class="flex items-center gap-2">
          <Input id="n1" type="number" value="1" class="w-20 text-center" />
          <span class="text-surface-400 text-lg">/</span>
          <Input id="d1" type="number" value="2" class="w-20 text-center" />
        </div>
      </div>
      <div>
        <label class="text-sm text-surface-300 mb-1.5 block">Fraction 2</label>
        <div class="flex items-center gap-2">
          <Input id="n2" type="number" value="1" class="w-20 text-center" />
          <span class="text-surface-400 text-lg">/</span>
          <Input id="d2" type="number" value="3" class="w-20 text-center" />
        </div>
      </div>
    </div>
    <div class="flex gap-2 flex-wrap">
      <button onclick="op('+')" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 text-lg font-bold">+</button>
      <button onclick="op('-')" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 text-lg font-bold">−</button>
      <button onclick="op('*')" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 text-lg font-bold">×</button>
      <button onclick="op('/')" class="px-4 py-2 rounded-xl bg-surface-800 text-surface-200 border border-surface-700 hover:bg-brand-500/20 hover:border-brand-500/50 hover:text-brand-400 text-lg font-bold">÷</button>
    </div>
    <div id="result" class="bg-surface-800/40 border border-surface-700/30 rounded-xl p-4 text-center min-h-[60px]"></div>
  </div>
<script is:inline>
function gcd(a, b) { a = Math.abs(a); b = Math.abs(b); while(b){var t=b;b=a%b;a=t;} return a||1; }
function simplify(num, den) { var g = gcd(num, den); return [num/g, den/g]; }
function op(operator) {
  var n1 = parseInt(document.getElementById('n1').value) || 0;
  var d1 = parseInt(document.getElementById('d1').value) || 1;
  var n2 = parseInt(document.getElementById('n2').value) || 0;
  var d2 = parseInt(document.getElementById('d2').value) || 1;
  if (d1 === 0 || d2 === 0) { document.getElementById('result').innerHTML = '<p class="text-red-400">Denominator cannot be 0</p>'; return; }
  var num, den;
  if (operator === '+') { num = n1*d2 + n2*d1; den = d1*d2; }
  else if (operator === '-') { num = n1*d2 - n2*d1; den = d1*d2; }
  else if (operator === '*') { num = n1*n2; den = d1*d2; }
  else { num = n1*d2; den = d1*n2; }
  var s = simplify(num, den);
  var whole = Math.floor(s[0] / s[1]);
  var rem = s[0] % s[1];
  var fracDisplay = n1 + '/' + d1 + ' ' + operator + ' ' + n2 + '/' + d2 + ' = ';
  var resultDisplay;
  if (rem === 0) resultDisplay = whole;
  else if (whole === 0) resultDisplay = rem + '/' + s[1];
  else resultDisplay = whole + ' ' + Math.abs(rem) + '/' + s[1];
  var decimal = (s[0]/s[1]).toFixed(4);
  document.getElementById('result').innerHTML =
    '<div class="text-sm text-surface-400 mb-1">' + fracDisplay + '</div>' +
    '<div class="text-2xl font-bold text-brand-400">' + resultDisplay + '</div>' +
    '<div class="text-xs text-surface-500 mt-1">≈ ' + decimal + '</div>';
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Fraction Calculator?</h2>
  <p class="mb-3">A fraction calculator performs addition, subtraction, multiplication, and division on fractions — automatically simplifying results and converting to mixed numbers. It shows both the fractional result and decimal equivalent.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Checking homework or teaching fraction arithmetic to students</li>
    <li>Working with recipes, measurements, or construction plans that use fractions</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Enter two fractions and click an operator (+, −, ×, ÷). The result is simplified automatically.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/percentage-calculator/" class="text-primary hover:underline">Percentage Calculator</a> for converting fractions to percentages.</p>
</div>
</ToolLayout>
