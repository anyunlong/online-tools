---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import StatCard from '../components/StatCard.astro';
---

<ToolLayout
  title="Word Counter"
  description="Count characters, words, lines and CJK characters"
  category="Text"
  keywords={["word", "count", "character"]}
>
  <Textarea id="inp" placeholder="Enter text..." rows="10" oninput="count()" />
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
    <StatCard id="chars" label="Characters" value="0" />
    <StatCard id="words" label="Words" value="0" />
    <StatCard id="lines" label="Lines" value="0" />
    <StatCard id="cn" label="CN Chars" value="0" />
  </div>
<script is:inline>
function count() {
  var t = document.getElementById('inp').value;
  document.getElementById('chars').textContent = t.length;
  document.getElementById('words').textContent = (t.match(/\S+/g) || []).length;
  document.getElementById('lines').textContent = t.split('\n').length;
  document.getElementById('cn').textContent = (t.match(/[\u4e00-\u9fff]/g) || []).length;
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a Word Counter?</h2>
  <p class="mb-3">A word counter analyzes your text and instantly shows statistics including character count, word count, line count, and paragraph count. It's an essential tool for writers, students, and anyone who needs to hit a specific text length.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Checking if an essay, article, or social media post meets length requirements</li>
    <li>Tracking character limits for meta descriptions, tweets, or SMS messages</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste or type your text to see real-time counts of characters, words, lines, and paragraphs.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/text-sort/" class="text-primary hover:underline">Text Line Sorter</a> for organizing and alphabetizing lists.</p>
</div>
</ToolLayout>
