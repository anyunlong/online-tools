---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy | 4uses',
  description: '4uses Privacy Policy — how we handle your data, cookies, and advertising.'
};
---

<BaseLayout
  title="Privacy Policy | 4uses"
  description="4uses Privacy Policy — how we handle your data, cookies, and advertising."
  schema={pageSchema}
>
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 w-full">
    <h1 class="text-2xl font-bold text-white mb-6" data-i18n="privacy.title">Privacy Policy</h1>
    <p class="text-sm text-surface-400 mb-6" data-i18n="privacy.lastUpdated">Last updated: May 30, 2026</p>

    <section class="mb-6">
      <h2 class="text-lg font-semibold text-surface-200 mb-3" data-i18n="privacy.overview.title">1. Overview</h2>
      <p class="text-sm text-surface-400 leading-relaxed" data-i18n="privacy.overview.text">
        4uses.com ("we", "our", or "us") is committed to protecting your privacy. All tools on this website run locally in your browser — we do not upload, store, or process your data on any server.
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-lg font-semibold text-surface-200 mb-3" data-i18n="privacy.data.title">2. Data We Collect</h2>
      <p class="text-sm text-surface-400 leading-relaxed" data-i18n="privacy.data.text">
        We do not require registration and do not collect personal information. Your usage data (files, text, images) stays in your browser and is never transmitted to our servers.
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-lg font-semibold text-surface-200 mb-3" data-i18n="privacy.cookies.title">3. Cookies & Analytics</h2>
      <p class="text-sm text-surface-400 leading-relaxed" data-i18n="privacy.cookies.text">
        This site does not display advertisements. We use Vercel Analytics to collect anonymous traffic data (page views, referrer, browser type). No personal information is collected or stored. This site does not use advertising cookies.
      </p>
      <p class="text-sm text-surface-400 leading-relaxed mt-2" data-i18n="privacy.cookies.optout">
        For GDPR compliance, we provide a consent mechanism for analytics cookies via our CMP. You may opt out of analytics at any time.
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-lg font-semibold text-surface-200 mb-3" data-i18n="privacy.thirdParty.title">4. Third-Party Services</h2>
      <p class="text-sm text-surface-400 leading-relaxed" data-i18n="privacy.thirdParty.text">
        We use the following third-party services that may collect information:
      </p>
      <ul class="list-disc list-inside text-sm text-surface-400 mt-2 space-y-1">
        <li data-i18n="privacy.thirdParty.analytics">Vercel Analytics — anonymous traffic analysis</li>
      </ul>
    </section>

    <section class="mb-6">
      <h2 class="text-lg font-semibold text-surface-200 mb-3" data-i18n="privacy.rights.title">5. Your Rights (GDPR)</h2>
      <p class="text-sm text-surface-400 leading-relaxed" data-i18n="privacy.rights.text">
        If you are in the European Economic Area (EEA), the UK, or Switzerland, you have the right to access, correct, or delete your personal data. Since we do not collect personal data, these rights are inherently upheld. For questions, please contact us.
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-lg font-semibold text-surface-200 mb-3" data-i18n="privacy.contact.title">6. Contact</h2>
      <p class="text-sm text-surface-400 leading-relaxed" data-i18n="privacy.contact.text">
        If you have questions about this Privacy Policy, please visit our <a href="/contact" class="text-brand-400 hover:underline">Contact page</a>.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
