---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="JSON to XML Converter"
  description="Convert JSON data to XML format"
  category="Convert"
  keywords={["json", "xml", "convert"]}
>
  <Textarea id="inp" placeholder="Paste JSON here..." rows="12" class="tool-area" />
  <div class="flex gap-2 mt-4">
    <Button onclick="convert()">Convert to XML</Button>
    <Button variant="secondary" onclick="copyOut()">Copy</Button>
  </div>
  <div class="text-xs text-surface-400 mt-3 mb-1">XML Output:</div>
  <div id="out" class="w-full rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 font-mono overflow-auto min-h-[200px] max-h-[500px] whitespace-pre"></div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function jsonToXml(obj, rootName) {
  rootName = rootName || 'root';
  var xml = '';
  function build(obj, name) {
    if (Array.isArray(obj)) {
      for (var i = 0; i < obj.length; i++) build(obj[i], name);
    } else if (typeof obj === 'object' && obj !== null) {
      xml += '<' + name;
      var hasAttrs = false, attrs = '', children = '';
      for (var key in obj) {
        if (obj.hasOwnProperty(key)) {
          var val = obj[key];
          if (key.startsWith('@')) { attrs += ' ' + key.substring(1) + '="' + val + '"'; hasAttrs = true; }
          else if (key === '#text') { children += val; }
          else {
            var oldXml = xml; xml = '';
            build(val, key);
            children += xml;
            xml = oldXml;
          }
        }
      }
      xml += attrs + '>';
      xml += children;
      xml += '</' + name + '>';
    } else {
      xml += '<' + name + '>' + (obj === null ? '' : String(obj).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')) + '</' + name + '>';
    }
  }
  build(obj, rootName);
  return xml;
}
function convert() {
  try {
    var json = JSON.parse(document.getElementById('inp').value);
    var xml = '<?xml version="1.0" encoding="UTF-8"?>\n' + jsonToXml(json, 'root');
    document.getElementById('out').textContent = xml;
    document.getElementById('msg').textContent = 'Conversion successful';
    document.getElementById('msg').className = 'text-xs mt-2 text-brand-400';
  } catch(e) {
    document.getElementById('msg').textContent = 'Error: ' + e.message;
    document.getElementById('msg').className = 'text-xs mt-2 text-red-400';
  }
}
function copyOut() {
  var t = document.getElementById('out').textContent;
  if (!t) return;
  navigator.clipboard.writeText(t).then(function() {
    var btn = document.querySelector('[onclick="copyOut()"]');
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
  });
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a JSON to XML Converter?</h2>
  <p class="mb-3">A JSON to XML converter transforms JSON (JavaScript Object Notation) data into XML markup format. This is useful when you need to interface with older systems, SOAP APIs, or applications that only accept XML input.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Preparing data for systems or APIs that require XML format exclusively</li>
    <li>Generating XML configuration files or data exports from JSON data sources</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste valid JSON and click Convert to XML to get properly formatted XML output.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-validator/" class="text-primary hover:underline">JSON Validator</a> to verify your JSON is syntactically correct before conversion.</p>
</div>
</ToolLayout>
