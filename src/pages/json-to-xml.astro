---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="JSON to XML Converter"
  description="Convert JSON data to XML format"
  category="Convert"
  keywords={["json", "xml", "convert"]}
>
  <textarea id="input" placeholder='{"root":{"item":[{"name":"Alice","age":"30"},{"name":"Bob","age":"25"}]}}' rows="10" class="bg-surface-800 border border-surface-600 rounded-lg px-3 py-2 text-sm text-surface-100 font-mono w-full resize-y"></textarea>
  <div class="flex gap-2 mt-3">
    <Button onclick="convert()">Convert to XML</Button>
    <Button variant="secondary" onclick="copyOut()">Copy</Button>
  </div>
  <textarea id="result" readonly class="mt-3 w-full min-h-[200px] rounded-xl border border-surface-600 bg-surface-800 p-4 text-sm text-surface-100 font-mono whitespace-pre-wrap break-all resize-y"></textarea>
<script is:inline>
function escapeXml(str) {
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function jsonToXml(obj, rootName) {
  if (typeof obj === 'string' || typeof obj === 'number' || typeof obj === 'boolean') {
    return escapeXml(String(obj));
  }
  if (obj === null) return '';
  var xml = '';

  for (var key in obj) {
    if (!obj.hasOwnProperty(key)) continue;
    var val = obj[key];
    var tag = isNaN(key) ? key : 'item';

    if (Array.isArray(val)) {
      val.forEach(function(item) {
        xml += '<' + tag + '>' + jsonToXml(item, tag) + '</' + tag + '>';
      });
    } else if (typeof val === 'object' && val !== null) {
      xml += '<' + tag + '>' + jsonToXml(val, tag) + '</' + tag + '>';
    } else {
      xml += '<' + tag + '>' + escapeXml(String(val)) + '</' + tag + '>';
    }
  }
  return xml;
}

function convert() {
  var input = document.getElementById('input').value.trim();
  if (!input) {
    document.getElementById('result').value = 'Paste JSON above.';
    return;
  }
  try {
    var obj = JSON.parse(input);
    var xml = '<?xml version="1.0" encoding="UTF-8"?>\n';
    if (typeof obj === 'object' && !Array.isArray(obj)) {
      var keys = Object.keys(obj);
      if (keys.length === 1) {
        xml += '<' + keys[0] + '>\n' + jsonToXml(obj[keys[0]], keys[0]) + '\n</' + keys[0] + '>';
      } else {
        xml += '<root>\n' + jsonToXml(obj, 'root') + '\n</root>';
      }
    } else {
      xml += '<root>\n' + jsonToXml(obj, 'root') + '\n</root>';
    }
    document.getElementById('result').value = xml;
  } catch (e) {
    document.getElementById('result').value = 'Invalid JSON: ' + e.message;
  }
}

function copyOut() {
  navigator.clipboard.writeText(document.getElementById('result').value);
}
</script>
<div slot="info">
  <h2 class="text-base font-semibold text-surface-100 mb-2">What is a JSON to XML Converter?</h2>
  <p class="mb-3">A JSON to XML converter transforms JSON (JavaScript Object Notation) data into XML markup format. This is useful when you need to interface with older systems, SOAP APIs, or applications that only accept XML input.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
  <ul class="list-disc pl-5 mb-3 space-y-1">
    <li>Preparing data for systems or APIs that require XML format exclusively</li>
    <li>Generating XML configuration files or data exports from JSON data sources</li>
  </ul>
  <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
  <p class="mb-3">Paste valid JSON and click Convert to XML to get properly formatted XML output.</p>
  <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
  <p>Try our <a href="/json-validator/" class="text-primary hover:underline">JSON Validator</a> to verify your JSON is syntactically correct before conversion.</p>
</div>
</ToolLayout>
