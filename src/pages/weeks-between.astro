---
import ToolLayout from '../components/ToolLayout.astro';
import Textarea from '../components/Textarea.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Weeks Between Dates"
  description="Calculate the number of weeks and days between any two dates"
  category="Time"
  keywords={["weeks between", "weeks between dates", "time"]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <Textarea id="inp" label="Input" placeholder="Enter your input here..." rows="12" class="tool-area" />
    <div>
      <label for="out" class="text-sm text-surface-300 mb-1.5 block font-medium">Output</label>
      <div id="out" class="w-full h-72 rounded-xl border border-surface-700 bg-surface-800/50 p-3 text-xs text-surface-100 overflow-auto font-mono"></div>
    </div>
  </div>
  <div class="flex gap-2 mt-4">
    <Button onclick="process()">Process</Button>
    <Button variant="secondary" onclick="clearAll()">Clear</Button>
  </div>
  <div id="msg" class="text-xs mt-2 text-surface-400"></div>
<script is:inline>
function process() {
  const v=document.getElementById('inp').value.trim().split(/[\s,]+/);
  if(v.length<2){o('Format: start_date end_date\nExample: 2025-01-01 2025-06-01');return;}
  const a=new Date(v[0]),b=new Date(v[1]);
  if(isNaN(a)||isNaN(b)){o('Invalid date(s). Use YYYY-MM-DD format.');return;}
  const days=Math.abs(b-a)/(1000*60*60*24);
  o(Math.abs(days).toFixed(0)+' days / '+(days/7).toFixed(1)+' weeks\nFrom '+a.toLocaleDateString()+' to '+b.toLocaleDateString());
}
function o(t){document.getElementById('out').textContent=t;}
function clearAll(){document.getElementById('inp').value='';document.getElementById('out').textContent='';if(timer)clearInterval(timer);}
</script>
<slot name="info" slot="info">
  <p>Enter your data above — the result is computed instantly in your browser. No server upload needed.</p>
</slot>
</ToolLayout>
