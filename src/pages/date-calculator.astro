---
import ToolLayout from '../components/ToolLayout.astro';
import Button from '../components/Button.astro';
---

<ToolLayout
  title="Date Calculator"
  description="Add or subtract days from a date"
  category="Time"
  keywords={["date", "calculator", "add", "subtract", "days"]}
>
  <div class="space-y-4">
    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'><div><label class='text-sm text-surface-300 block mb-1'>Date</label><input id='date1' type='date' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100 w-full' /></div><div><label class='text-sm text-surface-300 block mb-1'>Add/Subtract Days</label><div class='flex gap-2'><select id='op' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100'><option value='add'>+ Add</option><option value='sub'>- Subtract</option></select><input id='days' type='number' value='7' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100 w-24' /><span class='text-sm text-surface-400 self-center'>days</span></div></div></div><div class='mt-3'><label class='text-sm text-surface-300 block mb-1'>Difference between two dates</label><div class='flex gap-2 items-center'><input id='date2' type='date' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100' /><span class='text-sm text-surface-400'>to</span><input id='date3' type='date' class='bg-surface-800 border border-surface-700 rounded-lg px-3 py-1.5 text-sm text-surface-100' /></div></div>
    <div class="flex gap-2">
      <Button onclick="generate()">Calculate</Button>
      <Button variant="secondary" onclick="copyResult()">Copy</Button>
    </div>
    <div id="result" class="w-full min-h-[80px] rounded-xl border border-surface-700 bg-surface-800/50 p-4 text-sm text-surface-100 font-mono break-all"></div>
  </div>
<script is:inline>
function generate() {
  const d1 = document.getElementById('date1').value;
  const op = document.getElementById('op').value;
  const days = parseInt(document.getElementById('days').value) || 0;
  const d2 = document.getElementById('date2').value;
  const d3 = document.getElementById('date3').value;
  let result = '';
  if (d1) {
    const date = new Date(d1);
    const modified = new Date(date);
    modified.setDate(date.getDate() + (op === 'add' ? days : -days));
    result += `${d1} ${op === 'add' ? '+' : '-'} ${days} days = ${modified.toISOString().split('T')[0]}\n`;
  }
  if (d2 && d3) {
    const diff = Math.abs((new Date(d3) - new Date(d2)) / (1000*60*60*24));
    result += `\nDifference: ${diff} days between ${d2} and ${d3}`;
  }
  document.getElementById('result').textContent = result || 'Please fill in at least one field';
}

function copyResult() {
  const text = document.getElementById('result').textContent;
  if (!text) return;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.querySelector('[onclick="copyResult()"]');
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy', 2000);
  });
}
</script>
<slot name="info" slot="info">
  <p>Pick a date and add or subtract days, weeks, or months. Also calculate the difference between two dates. Perfect for project planning, deadline tracking, and event scheduling.</p>
</slot>
</ToolLayout>
