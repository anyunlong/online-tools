---
const stats = [
  { value: '100K+', label: 'Monthly Users', i18n: 'home.monthlyUsers' },
  { value: '200+', label: 'Tools Available', i18n: 'home.toolsAvailable' },
  { value: '4.9★', label: 'Average Rating', i18n: 'home.averageRating' },
];
---

<section id="about" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="rounded-2xl border border-border bg-card/40 p-8 text-center sm:p-12">
    <p class="text-sm font-medium uppercase tracking-wider text-muted-foreground">
      <span data-i18n="home.trustedWorldwide">Trusted by developers worldwide</span>
    </p>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        stats.map((s) => (
          <div>
            <div class="gradient-text text-4xl font-bold tracking-tight sm:text-5xl">
              {s.value}
            </div>
            <div class="mt-2 text-sm text-muted-foreground" data-i18n={s.i18n}>{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
