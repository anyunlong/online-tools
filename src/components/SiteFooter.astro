---
import tools from '../data/tools.json';

const catOrder = [
  'Encode/Decode', 'Hash', 'Text', 'Time', 'Dev Tools',
  'Convert', 'Formatter', 'Generator', 'Security', 'Design',
  'Image', 'Math', 'Network',
];

const categories = catOrder.filter(cat => tools.some(t => t.cat === cat));

const toolLinks = tools.slice(0, 5).map(t => ({ id: t.id, name: t.name }));
const companyLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'Privacy', href: '/privacy' },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-card/30">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 text-lg font-bold no-underline">
          <span class="flex size-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-accent text-sm font-black text-primary-foreground">
            4
          </span>
          <span class="text-foreground">4uses</span>
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground" data-i18n="footer.description">
          200+ free online utilities for everyday tasks. No sign-up, no
          limits, fully private in your browser.
        </p>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="text-sm font-semibold text-foreground" data-i18n="footer.tools">Tools</h3>
        <ul class="mt-3 space-y-2">
          {toolLinks.map(t => (
            <li>
              <a href={`/${t.id}`} class="text-sm text-muted-foreground transition-colors hover:text-foreground no-underline">
                {t.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-sm font-semibold text-foreground" data-i18n="footer.categories">Categories</h3>
        <ul class="mt-3 space-y-2">
          {categories.slice(0, 6).map(cat => (
            <li>
              <a href="/#categories" class="text-sm text-muted-foreground transition-colors hover:text-foreground no-underline">
                {cat}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold text-foreground" data-i18n="footer.company">Company</h3>
        <ul class="mt-3 space-y-2">
          {companyLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground transition-colors hover:text-foreground no-underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-border pt-6 text-center text-sm text-muted-foreground">
      <span data-i18n="footer.copyright">&copy; {currentYear} 4uses. All rights reserved.</span>
    </div>
  </div>
</footer>
