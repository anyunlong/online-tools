---
// LangSwitcher.astro — simple 中/EN toggle
---

<button
  id="lang-switcher"
  class="text-xs px-2 py-1 rounded-md border border-surface-700 text-surface-400 
         hover:text-surface-200 hover:border-brand-500/40 transition-colors cursor-pointer bg-transparent"
  aria-label="Switch language"
>
  <span id="lang-label">中</span>
</button>

<script>
  function getLang() {
    return localStorage.getItem('lang') || 'en';
  }

  function updateLabel() {
    const label = document.getElementById('lang-label');
    if (label) {
      label.textContent = getLang() === 'en' ? '中' : 'EN';
    }
  }

  function switchLang() {
    const current = getLang();
    const next = current === 'en' ? 'zh' : 'en';
    localStorage.setItem('lang', next);
    document.documentElement.lang = next;
    updateLabel();
    applyTranslations();
  }

  function applyTranslations() {
    const lang = getLang();
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      const text = window.__I18N__?.[lang]?.[key];
      if (text) {
        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
          el.placeholder = text;
        } else {
          el.textContent = text;
        }
      }
    });
    // Toggle data-lang visibility
    document.querySelectorAll('[data-lang]').forEach(el => {
      const elLang = el.getAttribute('data-lang');
      if (elLang === lang) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }

  // Init
  document.addEventListener('DOMContentLoaded', () => {
    document.documentElement.lang = getLang();
    updateLabel();
    applyTranslations();
    
    document.getElementById('lang-switcher')?.addEventListener('click', switchLang);
  });
</script>
