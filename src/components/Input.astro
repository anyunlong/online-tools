---
export interface Props {
  id: string;
  type?: string;
  label?: string;
  placeholder?: string;
  value?: string;
  class?: string;
  oninput?: string;
  onchange?: string;
}
const { id, type = 'text', label, placeholder = '', value, class: cls = '', oninput, onchange } = Astro.props;
---

{label && <label for={id} class="text-sm text-surface-300 mb-1.5 block font-medium">{label}</label>}
<input
  id={id}
  type={type}
  placeholder={placeholder}
  value={value}
  class={`rounded-xl border border-surface-700 bg-surface-800/50 px-3 py-2 text-sm text-surface-100 placeholder:text-surface-500 focus:border-brand-500 focus:ring-1 focus:ring-brand-500/30 focus:bg-surface-800 transition-all duration-200 ${cls}`}
  oninput={oninput}
  onchange={onchange}
/>
