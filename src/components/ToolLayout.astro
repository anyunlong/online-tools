---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import faqData from '../data/faq.json';

export interface Props {
  title: string;
  description: string;
  category: string;
  keywords: string[];
}
const { title, description, category, keywords } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

// Extract tool ID from URL path for i18n (e.g. /password-generator/ → password-generator)
const toolId = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index';

// Look up FAQ entries for this tool
const faqEntries: Array<{ q: string; a: string }> = faqData[toolId] || [];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: pageUrl,
  description: description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site || Astro.url.origin).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category,
      item: pageUrl
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: pageUrl
    }
  ]
};

const faqSchema = faqEntries.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(entry => ({
    '@type': 'Question',
    name: entry.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.a
    }
  }))
} : null;

const combinedSchema = faqSchema
  ? [webAppSchema, breadcrumbSchema, faqSchema]
  : [webAppSchema, breadcrumbSchema];
---

<BaseLayout
  title={`${title} - Free Online Tool | 4uses`}
  description={description}
  schema={combinedSchema}
>
  <Header />
  <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <a
          href="/"
          class="text-xs text-surface-500 hover:text-brand-400 no-underline transition-colors"
          data-i18n="ui.home"
        >Home</a>
        <span class="text-surface-600">/</span>
        <span class="text-xs text-surface-400" data-i18n={`categories.${category}`}>{category}</span>
      </div>
      <h1 class="text-2xl font-bold text-white" data-i18n={`tools.${toolId}.name`}>{title}</h1>
      <p class="text-sm text-surface-400 mt-1.5" data-i18n={`tools.${toolId}.desc`}>{description}</p>
    </div>
    <div
      class="bg-surface-900 border border-surface-700/30 rounded-2xl shadow-xl shadow-black/20 p-5 sm:p-6"
    >
      <slot />
    </div>
    <div class="mt-8 max-w-3xl" data-i18n={`tools.${toolId}.howto`}>
      <div class="text-sm text-surface-400 leading-relaxed space-y-3">
        <slot name="info" />
      </div>
      {faqEntries.length > 0 && (
        <div class="mt-8 border-t border-surface-700/30 pt-6">
          <h2 class="text-lg font-semibold text-white mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqEntries.map(entry => (
              <details class="group border border-surface-700/20 rounded-lg bg-surface-800/50">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-surface-200 hover:text-white transition-colors select-none">{entry.q}</summary>
                <div class="px-4 pb-3 text-sm text-surface-400 leading-relaxed">{entry.a}</div>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
