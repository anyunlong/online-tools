---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import faqData from '../data/faq.json';
import toolContent from '../data/tool-content.json';
import toolInfoEn from '../data/tool-info-en.json';

export interface Props {
  title: string;
  description: string;
  category: string;
  keywords: string[];
}
const { title, description, category, keywords } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

// Extract tool ID from URL path for i18n (e.g. /password-generator/ → password-generator)
const toolId = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index';

// Look up FAQ entries for this tool
const faqEntries: Array<{ q: string; a: string }> = faqData[toolId] || [];

// Look up content expansion for this tool
const tc = toolContent[toolId];
const deepDive: string | null = tc?.deepDive || null;
const tips: string[] = tc?.tips || [];
const commonMistakes: string[] = tc?.commonMistakes || [];

// Look up tool info (What/When/How/Related)
const infoEn = toolInfoEn[toolId];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: pageUrl,
  description: description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site || Astro.url.origin).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category,
      item: pageUrl
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: pageUrl
    }
  ]
};

const faqSchema = faqEntries.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(entry => ({
    '@type': 'Question',
    name: entry.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.a
    }
  }))
} : null;

const combinedSchema = faqSchema
  ? [webAppSchema, breadcrumbSchema, faqSchema]
  : [webAppSchema, breadcrumbSchema];
---

<BaseLayout
  title={`${title} - Free Online Tool | 4uses`}
  description={description}
  schema={combinedSchema}
>
  <Header />
  <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-2">
        <a
          href="/"
          class="text-xs text-surface-500 hover:text-brand-400 no-underline transition-colors"
          data-i18n="ui.home"
        >Home</a>
        <span class="text-surface-600">/</span>
        <span class="text-xs text-surface-400" data-i18n={`categories.${category}`}>{category}</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white" data-i18n={`tools.${toolId}.name`}>{title}</h1>
      <p class="text-sm text-surface-400 mt-1.5" data-i18n={`tools.${toolId}.desc`}>{description}</p>
    </div>
    <div
      class="max-w-3xl mx-auto bg-surface-900 border border-surface-700/30 rounded-2xl shadow-xl shadow-black/20 p-5 sm:p-6"
    >
      <slot />
    </div>
    <div class="mt-12 max-w-3xl">
      {infoEn && (
        <div class="text-[15px] text-surface-300 leading-relaxed space-y-3">
          <h2 class="text-xl font-bold text-surface-100 mb-3 mt-0">What is {title}?</h2>
          <p class="mb-3">{infoEn.what}</p>
          <h2 class="text-xl font-bold text-surface-100 mb-3 mt-8">When to Use</h2>
          <ul class="list-disc pl-5 mb-3 space-y-1.5">
            {infoEn.when.map(item => <li>{item}</li>)}
          </ul>
          <h2 class="text-xl font-bold text-surface-100 mb-3 mt-8">How to Use</h2>
          <p class="mb-3">{infoEn.how}</p>
          <h2 class="text-xl font-bold text-surface-100 mb-3 mt-8">Related Tools</h2>
          <p class="[&_a]:underline [&_a]:decoration-brand-400/50 hover:[&_a]:decoration-brand-400"><Fragment set:html={infoEn.related} /></p>
        </div>
      )}
      {(deepDive || tips.length > 0 || commonMistakes.length > 0) && (
        <div class="mt-8 space-y-6">
          {deepDive && (
            <div>
              <h2 class="text-xl font-bold text-white mb-3 mt-8">Deep Dive: How {title} Works</h2>
              <div class="space-y-3 text-[15px] text-surface-300 leading-relaxed">
                  {deepDive.split('\n\n').map(p => p.trim()).filter(p => p.length > 0).map(p => <p>{p}</p>)}
                </div>
            </div>
          )}
          {tips.length > 0 && (
            <div>
              <h2 class="text-xl font-bold text-surface-200 mb-3 mt-8">Pro Tips</h2>
              <ul class="list-disc pl-5 space-y-2 text-[15px] text-surface-300">
                {tips.map(tip => <li class="leading-relaxed">{tip}</li>)}
              </ul>
            </div>
          )}
          {commonMistakes.length > 0 && (
            <div>
              <h2 class="text-xl font-bold text-surface-200 mb-3 mt-8">Common Mistakes to Avoid</h2>
              <ul class="list-disc pl-5 space-y-2 text-[15px] text-surface-300">
                {commonMistakes.map(m => <li class="leading-relaxed">{m}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}
      {faqEntries.length > 0 && (
        <div class="mt-8 border-t border-surface-700/30 pt-6">
          <h2 class="text-xl font-bold text-white mb-3 mt-8">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqEntries.map(entry => (
              <details class="group border border-surface-700/40 rounded-lg bg-surface-800/50">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-surface-200 hover:text-white transition-colors select-none">{entry.q}</summary>
                <div class="px-4 pb-3 text-[15px] text-surface-300 leading-relaxed">{entry.a}</div>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
