---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import faqData from '../data/faq.json';
import faqDataZh from '../data/faq-zh.json';
import toolContent from '../data/tool-content.json';
import toolContentZh from '../data/tool-content-zh.json';
import toolInfoEn from '../data/tool-info-en.json';
import toolInfoZh from '../data/tool-info-zh.json';

export interface Props {
  title: string;
  description: string;
  category: string;
  keywords: string[];
}
const { title, description, category, keywords } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

// Extract tool ID from URL path for i18n (e.g. /password-generator/ → password-generator)
const toolId = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index';

// Look up FAQ entries for this tool
const faqEntries: Array<{ q: string; a: string }> = faqData[toolId] || [];
const faqEntriesZh: Array<{ q: string; a: string }> = faqDataZh[toolId] || [];

// Look up content expansion for this tool
const tc = toolContent[toolId];
const tcZh = toolContentZh[toolId];
const deepDive: string | null = tc?.deepDive || null;
const deepDiveZh: string | null = tcZh?.deepDive || null;
const tips: string[] = tc?.tips || [];
const tipsZh: string[] = tcZh?.tips || [];
const commonMistakes: string[] = tc?.commonMistakes || [];
const commonMistakesZh: string[] = tcZh?.commonMistakes || [];

// Look up tool info (What/When/How/Related)
const infoEn = toolInfoEn[toolId];
const infoZh = toolInfoZh[toolId];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: pageUrl,
  description: description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site || Astro.url.origin).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category,
      item: pageUrl
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: pageUrl
    }
  ]
};

const faqSchema = faqEntries.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map(entry => ({
    '@type': 'Question',
    name: entry.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.a
    }
  }))
} : null;

const combinedSchema = faqSchema
  ? [webAppSchema, breadcrumbSchema, faqSchema]
  : [webAppSchema, breadcrumbSchema];
---

<BaseLayout
  title={`${title} - Free Online Tool | 4uses`}
  description={description}
  schema={combinedSchema}
>
  <Header />
  <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <a
          href="/"
          class="text-xs text-surface-500 hover:text-brand-400 no-underline transition-colors"
          data-i18n="ui.home"
        >Home</a>
        <span class="text-surface-600">/</span>
        <span class="text-xs text-surface-400" data-i18n={`categories.${category}`}>{category}</span>
      </div>
      <h1 class="text-2xl font-bold text-white" data-i18n={`tools.${toolId}.name`}>{title}</h1>
      <p class="text-sm text-surface-400 mt-1.5" data-i18n={`tools.${toolId}.desc`}>{description}</p>
    </div>
    <div
      class="bg-surface-900 border border-surface-700/30 rounded-2xl shadow-xl shadow-black/20 p-5 sm:p-6"
    >
      <slot />
    </div>
    <div class="mt-8 max-w-3xl">
      {infoEn && (
        <>
          <div class="text-sm text-surface-400 leading-relaxed space-y-3" data-lang="en">
            <h2 class="text-base font-semibold text-surface-100 mb-2">What is {title}?</h2>
            <p class="mb-3">{infoEn.what}</p>
            <h2 class="text-base font-semibold text-surface-100 mb-2">When to Use</h2>
            <ul class="list-disc pl-5 mb-3 space-y-1">
              {infoEn.when.map(item => <li>{item}</li>)}
            </ul>
            <h2 class="text-base font-semibold text-surface-100 mb-2">How to Use</h2>
            <p class="mb-3">{infoEn.how}</p>
            <h2 class="text-base font-semibold text-surface-100 mb-2">Related Tools</h2>
            <p><Fragment set:html={infoEn.related} /></p>
          </div>
          {infoZh && (
            <div class="text-sm text-surface-400 leading-relaxed space-y-3 hidden" data-lang="zh">
              <h2 class="text-base font-semibold text-surface-100 mb-2">工具介绍</h2>
              <p class="mb-3">{infoZh.what}</p>
              <h2 class="text-base font-semibold text-surface-100 mb-2">适用场景</h2>
              <ul class="list-disc pl-5 mb-3 space-y-1">
                {infoZh.when.map(item => <li>{item}</li>)}
              </ul>
              <h2 class="text-base font-semibold text-surface-100 mb-2">如何使用</h2>
              <p class="mb-3">{infoZh.how}</p>
              <h2 class="text-base font-semibold text-surface-100 mb-2">相关工具</h2>
              <p><Fragment set:html={infoZh.related} /></p>
            </div>
          )}
        </>
      )}
      <slot name="info" />
      </div>
      {(deepDive || tips.length > 0 || commonMistakes.length > 0) && (
        <div class="mt-8 space-y-6">
          {deepDive && (
            <div>
              <h2 class="text-lg font-semibold text-white mb-3" data-lang="en">Deep Dive: How {title} Works</h2>
              <h2 class="text-lg font-semibold text-white mb-3 hidden" data-lang="zh">深度解析：{title}的工作原理</h2>
              <div class="text-sm text-surface-400 leading-relaxed" data-lang="en">{deepDive}</div>
              <div class="text-sm text-surface-400 leading-relaxed hidden" data-lang="zh">{deepDiveZh || deepDive}</div>
            </div>
          )}
          {tips.length > 0 && (
            <div>
              <h2 class="text-base font-semibold text-surface-200 mb-2" data-lang="en">Pro Tips</h2>
              <h2 class="text-base font-semibold text-surface-200 mb-2 hidden" data-lang="zh">实用技巧</h2>
              <ul class="list-disc pl-5 space-y-1 text-sm text-surface-400" data-lang="en">
                {tips.map(tip => <li>{tip}</li>)}
              </ul>
              <ul class="list-disc pl-5 space-y-1 text-sm text-surface-400 hidden" data-lang="zh">
                {(tipsZh.length > 0 ? tipsZh : tips).map(tip => <li>{tip}</li>)}
              </ul>
            </div>
          )}
          {commonMistakes.length > 0 && (
            <div>
              <h2 class="text-base font-semibold text-surface-200 mb-2" data-lang="en">Common Mistakes to Avoid</h2>
              <h2 class="text-base font-semibold text-surface-200 mb-2 hidden" data-lang="zh">常见错误</h2>
              <ul class="list-disc pl-5 space-y-1 text-sm text-surface-400" data-lang="en">
                {commonMistakes.map(m => <li>{m}</li>)}
              </ul>
              <ul class="list-disc pl-5 space-y-1 text-sm text-surface-400 hidden" data-lang="zh">
                {(commonMistakesZh.length > 0 ? commonMistakesZh : commonMistakes).map(m => <li>{m}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}
      {faqEntries.length > 0 && (
        <div class="mt-8 border-t border-surface-700/30 pt-6">
          <h2 class="text-lg font-semibold text-white mb-4" data-lang="en">Frequently Asked Questions</h2>
          <h2 class="text-lg font-semibold text-white mb-4 hidden" data-lang="zh">常见问题</h2>
          <div class="space-y-4" data-lang="en">
            {faqEntries.map(entry => (
              <details class="group border border-surface-700/20 rounded-lg bg-surface-800/50">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-surface-200 hover:text-white transition-colors select-none">{entry.q}</summary>
                <div class="px-4 pb-3 text-sm text-surface-400 leading-relaxed">{entry.a}</div>
              </details>
            ))}
          </div>
          <div class="space-y-4 hidden" data-lang="zh">
            {(faqEntriesZh.length > 0 ? faqEntriesZh : faqEntries).map(entry => (
              <details class="group border border-surface-700/20 rounded-lg bg-surface-800/50">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-surface-200 hover:text-white transition-colors select-none">{entry.q}</summary>
                <div class="px-4 pb-3 text-sm text-surface-400 leading-relaxed">{entry.a}</div>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
