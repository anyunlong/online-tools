---
import tools from '../data/tools.json';
import LangSwitcher from './LangSwitcher.astro';
---

<header
  class="sticky top-0 z-50 bg-surface-950/80 backdrop-blur-md border-b border-surface-800/50"
>
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 text-lg font-bold no-underline group">
      <span
        class="w-8 h-8 bg-gradient-to-br from-brand-500 to-brand-700 rounded-lg flex items-center justify-center text-sm text-white shadow-lg shadow-brand-500/20 group-hover:shadow-brand-500/30 transition-shadow"
      >T</span>
      <span
        class="bg-gradient-to-r from-brand-400 to-brand-300 bg-clip-text text-transparent"
        data-i18n="site.name"
      >Online Tools</span>
    </a>
    <nav class="flex items-center gap-3">
      <a
        href="/"
        class="px-3 py-1.5 text-sm text-surface-300 hover:text-white hover:bg-surface-800 rounded-lg transition-colors no-underline"
        data-i18n="ui.home"
      >Home</a>
      <a
        href="/blog"
        class="px-3 py-1.5 text-sm text-surface-300 hover:text-white hover:bg-surface-800 rounded-lg transition-colors no-underline"
      >Blog</a>
      <LangSwitcher />
    </nav>
  </div>
</header>
